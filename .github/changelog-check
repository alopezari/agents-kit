#!/bin/bash
# Pass when this checkout adds a file under changelog.d/ (not its README) that <base ref> doesn't have, with a "- " line.
#   .github/changelog-check origin/main
set -euo pipefail
base=$1
# Only files directly under changelog.d/: bin/changelog release reads no subdirectory.
added=$(git -c core.quotePath=false diff --name-only --diff-filter=A "$base" -- 'changelog.d/*.md' | grep -E '^changelog\.d/[^/]+\.md$' | grep -v '^changelog.d/README.md$' || true)
if [ -z "$added" ]; then
  echo "No new file under changelog.d/. Add changelog.d/<branch>.md with a \"- \" line saying what this pull request"
  echo "changes for someone using the kit (no PR number: the release adds it), or label the pull request"
  echo "\"no changelog\" if nothing changes for them."
  exit 1
fi
while IFS= read -r file; do
  if ! grep -qE '^- +[^[:space:]]' "$file"; then
    echo "$file has no \"- \" line with text: write what this pull request changes for someone using the kit."
    exit 1
  fi
done <<< "$added"
echo "New changelog entries:"
while IFS= read -r file; do cat "$file"; done <<< "$added"
