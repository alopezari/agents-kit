#!/usr/bin/env python3
"""Record what a review lens or test type produced, what got past them, and each pull request's quality signals, so
the monthly job can keep only perspectives that pay off and learn which signals predict trouble.

  quality-log lens <name> --findings N --confirmed M [--secs S] [--model claude|codex] [--shared N] [--criteria N] [--map-items N] [--outcomes fixed=N,wrong=N,...]
  quality-log test <type> --issues N [--flake] [--secs S] [--notes "..."]
  quality-log escape <ci|review|bot> --verdict confirmed|rejected|uncertain --category <taxonomy code> --lens <lens> --pr N
  quality-log pr <number>

A lens is named by its key or heading in bin/triage, `correctness-recheck` or `spec`; --shared counts the confirmed findings the other model
family's run of the same lens also reported, and leaving it out means the overlap is unknown.

A test type is one of TEST_TYPES below (the error lists them). --issues counts the real issues a test run found, never a flake;
--flake marks a run that hit one: a test that failed, then passed on a rerun without a code change (any type, mostly unit).

A pr line records the open pull request's quality signals, run from its checkout after each push, so the last line
before the merge describes what merged; review-mining/outcomes.py joins it to the merged PR by host, owner/repo
(from the PR's URL as gh gives it, else from the origin URL) and number, and the decision page shows the branch's
last one. A PR whose head is another branch is refused. Every value is computed, never passed: the size against `review_stamp.py base`
(added, deleted, files, test_files added or modified, tests_deleted), the verify report's verdict (pass, fail, empty,
none) and whether its stamp covers the change now, its red check (failed, passed, skipped, not_run) and summed diff
coverage, the assertions the branch weakens, and its structure (`structure-facts --json`: the cognitive complexity it
adds and removes and the new clones it brings, a part it didn't measure null, within STRUCTURE_TIMEOUT). A value it
can't compute is null; the line is still written. Sizes count what was committed; with uncommitted or untracked
changes, the values read from the tree (verify_current, tampered, structure, the tiers) are null, as they would
describe a change that wasn't pushed.

Refuses malformed input (exit 2) without writing: a flag left without its value once took the next flag as one.
Appends to logs/quality.jsonl in the kit's main checkout with the repo, branch and the triage tier. hooks/review_stamp.py appends
"rename" lines there too, so review-mining/outcomes.py can join lens runs to a branch renamed after them.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import signal
import subprocess
import sys
import time

KIT = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..")
TAXONOMY = os.path.join(KIT, "review-mining", "taxonomy.md")
# What became of each finding a lens raised: the kit-review skill, step 4, defines each one.
OUTCOMES = ("fixed", "wrong", "intentional", "minor", "pre-existing", "open", "uncertain")
CONFIRMED_OUTCOMES = ("fixed", "minor", "pre-existing", "open")
# The origin URL's host and owner/repo: git@host:o/r.git, ssh://git@host:22/o/r.git, https://host/o/r.
ORIGIN = re.compile(r"^(?:[a-z+]+://)?(?:[^@/]+@)?(?P<host>[^/:]+)(?::\d+)?[:/](?P<remote>[^/]+/[^/]+?)(?:\.git)?/?$")
PR_URL = re.compile(r"^https?://(?P<host>[^/]+)/(?P<remote>[^/]+/[^/]+)/pull/\d+$")
VERIFY_VERDICTS = (("PASS, but nothing was checked", "empty"), ("PASS", "pass"), ("FAIL", "fail"))
TS_FORMAT = "%Y-%m-%dT%H:%M:%S%z"
TAMPER_KINDS = ("removed", "loosened", "changed", "skipped_or_focused")
# Matched at a line's start: the report keeps verify's last 6,000 characters, so its first line can be a fragment.
RED_CHECK_FAILED = re.compile(r"^error: \[red check\] The changed tests .* all pass without your change", re.M)
RED_CHECK_PASSED = re.compile(r"^ran: red check: ", re.M)
RED_CHECK_SKIPPED = re.compile(r"^skipped: red check \(", re.M)
RED_CHECK_NOT_RUN = re.compile(r"^error: red check did not run\b", re.M)
RED_CHECKS = ((RED_CHECK_FAILED, "failed"), (RED_CHECK_PASSED, "passed"), (RED_CHECK_SKIPPED, "skipped"),
              (RED_CHECK_NOT_RUN, "not_run"))  # first match wins
DIFF_COVERAGE = re.compile(r"^ran: diff coverage \(.*?\): (\d+) of (\d+) changed lines covered", re.M)
# One name per test family: review-mining/test_types.py folds the older spellings (regex, property, ...) into these.
# Above structure-facts' own budgets: lizard 30 s and jscpd 60 s, at each end.
STRUCTURE_TIMEOUT = 240
if os.environ.get("AGENTS_KIT_UNDER_TEST") and os.environ.get("QUALITY_LOG_STRUCTURE_TIMEOUT"):  # only the suite lowers it
    STRUCTURE_TIMEOUT = int(os.environ["QUALITY_LOG_STRUCTURE_TIMEOUT"])
STRUCTURE_PARTS = {"complexity": ("added", "removed", "max_function", "functions"), "new_clones": ("count",)}
TEST_TYPES = ("unit", "e2e", "integration", "browser", "query-budget", "accessibility", "property-based", "mutation",
              "migration-round-trip", "visual", "design", "regex-worst-case")
sys.path.insert(0, os.path.join(KIT, "hooks"))
from hooklog import session_harness  # noqa: E402
import review_stamp  # noqa: E402
from review_stamp import quality_log  # noqa: E402


def lens_keys():
    """{key or lowercase heading: key} for every review lens, plus the review's re-check and the spec's second reading."""
    sys.dont_write_bytecode = True  # loading triage would leave bin/__pycache__ behind, which bin/docs reads as a tool
    loader = importlib.machinery.SourceFileLoader("triage", os.path.join(KIT, "bin", "triage"))
    triage = importlib.util.module_from_spec(importlib.util.spec_from_loader("triage", loader))
    loader.exec_module(triage)
    return {"spec": "spec", "correctness-recheck": "correctness-recheck", **{name: key for key, title in triage.LENS_TITLES.items() for name in (key, title.lower())}}


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout.strip()


def parse(argv):
    parser = argparse.ArgumentParser(prog="quality-log", allow_abbrev=False, description=__doc__.split("\n\n")[0])
    kinds = parser.add_subparsers(dest="kind", required=True)
    lenses = lens_keys()

    def lens_name(value):  # the skills name lenses by their headings too: "Tests", "Performance and scale"
        if value.lower() not in lenses:
            raise argparse.ArgumentTypeError(f"{value!r} isn't a lens: {', '.join(sorted(set(lenses.values())))}")
        return lenses[value.lower()]

    def category(value):
        with open(TAXONOMY) as fh:
            codes = re.findall(r"^- ([A-Z]\d?\.[0-9a-z-]+) ", fh.read(), re.M)
        if value not in codes:
            raise argparse.ArgumentTypeError(f"{value!r} isn't a code in review-mining/taxonomy.md")
        return value

    def count(value):
        if not re.fullmatch(r"\d+", value):
            raise argparse.ArgumentTypeError(f"{value!r} isn't a whole number")
        return int(value)

    def pr_number(value):
        if not re.fullmatch(r"[1-9]\d*", value):
            raise argparse.ArgumentTypeError(f"{value!r} isn't a pull request number")
        return int(value)

    def outcomes(value):
        counts, seen = dict.fromkeys(OUTCOMES, 0), set()
        for key, sep, number in (pair.partition("=") for pair in value.split(",")):
            if key not in OUTCOMES:
                raise argparse.ArgumentTypeError(f"{key!r} isn't one of {', '.join(OUTCOMES)}")
            if not sep:
                raise argparse.ArgumentTypeError(f"{key!r} has no count: give it as {key}=N")
            if key in seen:
                raise argparse.ArgumentTypeError(f"{key!r} is given twice")
            seen.add(key)
            counts[key] = count(number)
        return counts

    lens = kinds.add_parser("lens", allow_abbrev=False)
    lens.add_argument("name", type=lens_name)
    lens.add_argument("--findings", type=count, required=True)
    lens.add_argument("--confirmed", type=count, required=True)
    lens.add_argument("--secs", type=count)
    lens.add_argument("--model", choices=("claude", "codex"))
    lens.add_argument("--shared", type=count)
    lens.add_argument("--criteria", type=count)
    lens.add_argument("--map-items", type=count)
    lens.add_argument("--outcomes", type=outcomes)
    test = kinds.add_parser("test", allow_abbrev=False)
    test.add_argument("name", choices=TEST_TYPES)
    test.add_argument("--issues", type=count, required=True, help="real issues the run found, never a flake")
    test.add_argument("--flake", action="store_true", default=None,  # None when absent: rows without a flake keep no field
                      help="the run hit a test that failed, then passed on a rerun without a code change")
    test.add_argument("--secs", type=count)
    test.add_argument("--notes")
    escape = kinds.add_parser("escape", allow_abbrev=False)
    escape.add_argument("name", choices=("ci", "review", "bot"))
    escape.add_argument("--verdict", choices=("confirmed", "rejected", "uncertain"), required=True)
    escape.add_argument("--category", type=category, required=True)
    escape.add_argument("--lens", type=lens_name, required=True)
    escape.add_argument("--pr", type=count, required=True)
    pr = kinds.add_parser("pr", allow_abbrev=False)
    pr.add_argument("name", type=pr_number)
    parsed = parser.parse_args(argv)  # exits 2 on anything malformed, before the log is opened
    if getattr(parsed, "shared", None) is not None:
        if parsed.model is None:
            parser.error("--shared needs --model: it counts what the other model family also found")
        if parsed.shared > parsed.confirmed:
            parser.error(f"--shared {parsed.shared} is more than --confirmed {parsed.confirmed}")
    args = vars(parsed)
    if args.get("outcomes"):
        # argparse keeps a repeated flag's last value, which would drop the first one's counts.
        if sum(arg.split("=")[0] == "--outcomes" for arg in argv) > 1:
            parser.error("--outcomes is given twice")
        counts = args["outcomes"]
        if sum(counts.values()) != args["findings"]:
            parser.error(f"--outcomes add up to {sum(counts.values())}, not --findings {args['findings']}")
        confirmed = sum(counts[key] for key in CONFIRMED_OUTCOMES)
        if confirmed != args["confirmed"]:
            parser.error(f"--outcomes count {confirmed} confirmed, not --confirmed {args['confirmed']}")
    return args.pop("kind"), args.pop("name"), {k: v for k, v in args.items() if v is not None}


def size_signals():
    """The branch's diff against where it left its base, as the stamps measure it; every field None when git can't."""
    try:
        base = review_stamp.merge_base()
        numstat = review_stamp.git_checked("diff", "--no-renames", "--numstat", base, "HEAD").decode().splitlines()
        # Renames followed here, unlike in the sizes: a test renamed is touched, one moved out of the test paths deleted.
        fields = iter(review_stamp.git_paths("diff", "--find-renames", "--name-status", base, "HEAD"))
        test_files = tests_deleted = 0
        for status in fields:
            old = next(fields)
            new = next(fields) if status.startswith("R") else old
            if status == "D" or (status.startswith("R") and review_stamp.TEST_FILE.search(old)
                                 and not review_stamp.TEST_FILE.search(new)):
                tests_deleted += bool(review_stamp.TEST_FILE.search(old))
            elif status[0] in "AMR":
                test_files += bool(review_stamp.TEST_FILE.search(new))
    except (RuntimeError, ValueError):  # ValueError: output that isn't UTF-8
        return dict.fromkeys(("added", "deleted", "files", "test_files", "tests_deleted"))
    counts = [line.split("\t")[:2] for line in numstat]
    return {"added": sum(int(added) for added, _ in counts if added != "-"),  # "-" is a binary file
            "deleted": sum(int(deleted) for _, deleted in counts if deleted != "-"),
            "files": len(counts), "test_files": test_files, "tests_deleted": tests_deleted}


def verify_signals():
    """The last verify report's verdict, red check and diff coverage, and whether its stamp covers the change now."""
    signals = {"verify": None, "verify_current": None, "red_check": None, "coverage": None}
    try:
        signals["verify_current"] = any(review_stamp.stamp_matches(kind, review_stamp.fingerprint_for(kind))
                                        for kind in review_stamp.VERIFY_KINDS)
    except (RuntimeError, ValueError, OSError):
        pass
    path = review_stamp.report_paths("verify")[0]
    if not path:
        return signals
    try:
        with open(path) as fh:
            report = fh.read()
    except FileNotFoundError:
        return {**signals, "verify": "none"}
    except (OSError, ValueError):
        return signals
    header = report.partition("\n")[0].removeprefix("# Verify: ")
    signals["verify"] = next((verdict for prefix, verdict in VERIFY_VERDICTS if header.startswith(prefix)), None)
    for pattern, verdict in RED_CHECKS:
        if pattern.search(report):
            signals["red_check"] = verdict
            break
    measured = [(int(covered), int(lines)) for covered, lines in DIFF_COVERAGE.findall(report)]
    if measured:
        signals["coverage"] = {"covered": sum(c for c, _ in measured), "measured": sum(m for _, m in measured)}
    return signals


def tamper_signals(root):
    """How many assertions the branch removes, loosens or changes, and how many skipped or focused tests it adds, as
    the stop hook finds them; None when git can't say."""
    import stop_checks  # here, not at the top: it loads most of the hooks, which the other kinds don't need
    try:
        hunks = stop_checks.branch_hunks(root)
        weakened = [kind for _, (_, kind, _) in stop_checks.weakened_assertions(root, hunks)]
    except (RuntimeError, ValueError, OSError):  # ValueError: a diff that isn't UTF-8
        return None
    return {**{kind: weakened.count(kind) for kind in TAMPER_KINDS[:3]},
            "skipped_or_focused": sum(1 for path, _, added in hunks for line in added
                                      if stop_checks.TEST_FILE.search(path) and stop_checks.WEAKENED_TEST.search(line))}


def structure_signals():
    """`structure-facts --json` against the stamps' base, each part kept only with exactly the shape it prints; None
    when it fails, times out or prints anything else."""
    try:
        base = review_stamp.branch_base()[0]
        process = subprocess.Popen([os.path.expanduser("~/.agents/bin/structure-facts"), "--json", base],
                                   stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, start_new_session=True)
    except (RuntimeError, OSError):
        return None
    try:
        out, _ = process.communicate(timeout=STRUCTURE_TIMEOUT)
    except subprocess.TimeoutExpired:
        try:  # the whole group: lizard or jscpd would otherwise hold the pipe open for as long as they run
            os.killpg(process.pid, signal.SIGKILL)
        except OSError:  # gone already, or macOS's EPERM for a group holding only its unreaped leader
            pass
        process.communicate()
        return None
    try:
        facts = json.loads(out) if process.returncode == 0 else None
    except ValueError:
        return None
    if not isinstance(facts, dict) or set(facts) != set(STRUCTURE_PARTS):
        return None
    return {name: structure_part(facts, name) for name in STRUCTURE_PARTS}


def structure_part(structure, name):
    """One part of structure-facts' JSON, kept only with exactly the shape it prints, else None."""
    value, counts = structure.get(name), STRUCTURE_PARTS[name]
    valid = (isinstance(value, dict) and set(value) == {*counts, "complete"} and type(value["complete"]) is bool
             and all(type(value[key]) is int and value[key] >= 0 for key in counts))
    return value if valid else None


def pr_identity(number):
    """The PR's host and owner/repo, from its URL as gh gives it, else from the origin URL: an SSH host alias or a
    fork's origin names another host or repository. Exits 2 when gh says the PR's head is another branch."""
    try:
        view = subprocess.run(["gh", "pr", "view", str(number), "--json", "url,headRefName"], capture_output=True,
                              text=True, timeout=20, env={**os.environ, "GH_PROMPT_DISABLED": "1"})
        pr = json.loads(view.stdout) if view.returncode == 0 else {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pr = {}
    url = PR_URL.match(pr.get("url") or "")
    if url:
        branch = git("branch", "--show-current")
        if pr.get("headRefName") != branch:
            print(f"quality-log: PR {number} is on {pr.get('headRefName')}, not on the checked-out {branch or 'HEAD'}",
                  file=sys.stderr)
            sys.exit(2)
        return {"host": url["host"].lower(), "remote": url["remote"]}
    origin = ORIGIN.match(git("remote", "get-url", "origin"))
    return {"host": origin and origin["host"].lower(), "remote": origin and origin["remote"]}


def pr_signals(number, dirty):
    fields = pr_identity(number)
    root = git("rev-parse", "--show-toplevel")
    if not root:  # not in a repository: nothing to measure
        return {**fields, **dict.fromkeys(("added", "deleted", "files", "test_files", "tests_deleted", "verify",
                                           "verify_current", "red_check", "coverage", "tampered", "structure"))}
    os.chdir(root)  # review_stamp reads paths relative to the checkout's top
    return {**fields, **size_signals(), **verify_signals(), "tampered": tamper_signals(root),
            "structure": None if dirty else structure_signals()}


def main():
    kind, name, fields = parse(sys.argv[1:])
    if kind == "pr":
        # Read from the tree, these would describe what wasn't pushed; a status that fails can't say the tree is clean.
        status = subprocess.run(["git", "status", "--porcelain", "--untracked-files=all"], capture_output=True)
        dirty = bool(status.returncode or status.stdout)
        fields = pr_signals(name, dirty)
    try:
        triage = json.loads(subprocess.run([os.path.expanduser("~/.agents/bin/triage"), "--json"],
                                           capture_output=True, text=True, timeout=60).stdout)
        tiers = {key: triage[key] for key in ("tier", "spec_tier", "diff_tier")}
    except (OSError, ValueError, KeyError, TypeError, subprocess.TimeoutExpired):
        tiers = {"tier": None, "spec_tier": None, "diff_tier": None}
    if kind == "pr" and dirty:
        tiers = dict.fromkeys(tiers)
        fields.update(verify_current=None, tampered=None)
    log = quality_log()
    os.makedirs(os.path.dirname(log), exist_ok=True)
    with open(log, "a") as fh:
        fh.write(json.dumps({
            "ts": time.strftime(TS_FORMAT), "kind": kind, "name": name, **tiers,
            "repo": subprocess.run([os.path.expanduser("~/.agents/bin/repo-name")], capture_output=True,
                                   text=True).stdout.strip() or os.path.basename(os.getcwd()),
            "branch": git("branch", "--show-current"), "harness": session_harness() or "unknown",
            **fields,
        }) + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
