#!/usr/bin/env python3
"""Remove the worktrees and local branches of this repository whose work is already in origin's default branch.

  prune-merged [--dry-run]

Fetches origin's default branch first (origin/HEAD names it), also with --dry-run, and stops, removing nothing, when
that fails: a stale ref would call unmerged work merged. A linked worktree goes when its HEAD is in origin/<default>
and removing it loses nothing: no changes, no ignored files other than regenerated ones (free-branch's rule), no
submodules, not locked, not where this runs, and no running process has its working directory inside it (another
session may still work there). A worktree it can't inspect is kept. Then each local branch merged into
origin/<default> and checked out nowhere is deleted, if it hasn't moved since, with the phases the user switched for it
(`phase off … branch`) and the kit's files for it: its stamps, spec, reports and evidence, in .git/agents and
$TMPDIR/agents-specs, also under the earlier names it was renamed from. A new branch of that name starts with every phase
on and no reports. A branch whose checks guide has a step after the merge that hasn't passed, or can't be read, is kept
with its files. Prints one line per linked worktree and merged branch: what it removed, or why it kept it, exiting 1
when something it should have removed stays. --dry-run prints what it would do and changes nothing else.
"""
import importlib.machinery
import importlib.util
import os
import shutil
import subprocess
import sys
import time

sys.dont_write_bytecode = True  # loading free-branch would leave bin/__pycache__ behind
_loader = importlib.machinery.SourceFileLoader(
    "free_branch", os.path.join(os.path.dirname(os.path.realpath(__file__)), "free-branch"))
_spec = importlib.util.spec_from_loader("free_branch", _loader)
free_branch = importlib.util.module_from_spec(_spec)
_loader.exec_module(free_branch)
REGENERATED, git, GitFailed = free_branch.REGENERATED, free_branch.git, free_branch.GitFailed
sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks"))
import phase_switches  # noqa: E402
import review_stamp  # noqa: E402


def worktrees(root):
    """(path, branch or None, locked) for each worktree, the main checkout first."""
    entries = []
    for block in git(root, "worktree", "list", "--porcelain", "-z").strip("\0").split("\0\0"):
        fields = dict((line.split(" ", 1) + [""])[:2] for line in block.split("\0"))
        branch = fields.get("branch", "").removeprefix("refs/heads/") or None
        entries.append((os.path.realpath(fields["worktree"]), branch, "locked" in fields))
    return entries


def process_cwds():
    """Every running process's working directory, or None when lsof can't tell."""
    try:
        result = subprocess.run(["lsof", "-a", "-d", "cwd", "-Fn"], capture_output=True, text=True)
    except OSError:
        return None
    if result.returncode != 0 or not result.stdout:  # a partial list could leave out the one process that matters
        return None
    return {os.path.realpath(line[1:]) for line in result.stdout.splitlines() if line.startswith("n")}


def keep_reason(path, locked, default, here, cwds):
    if locked:
        return "locked"
    if here == path or here.startswith(path + os.sep):
        return "this command runs there"
    if cwds is None:
        return "can't tell whether a running process uses it (lsof failed)"
    if any(cwd == path or cwd.startswith(path + os.sep) for cwd in cwds):
        return "in use: a running process works inside it"
    if not os.path.isdir(path):
        return "couldn't inspect it: its directory is gone (`git worktree prune` forgets it)"
    if os.path.exists(os.path.join(path, ".gitmodules")):
        return "has submodules, whose ignored files this doesn't inspect"
    ancestor = subprocess.run(["git", "-C", path, "merge-base", "--is-ancestor", "HEAD", default], capture_output=True, text=True)
    if ancestor.returncode == 1:
        return f"has commits not in {default}"
    if ancestor.returncode != 0:
        raise GitFailed(f"git merge-base: {ancestor.stderr.strip()}")
    changes = git(path, "status", "--porcelain", "--untracked-files=all", "--ignore-submodules=none").strip()
    if changes:
        return "has changes: " + ", ".join(line[3:] for line in changes.splitlines()[:5])
    hidden = [line[2:] for line in git(path, "ls-files", "-v").splitlines() if line[:1].islower() or line[:1] == "S"]
    if hidden:  # assume-unchanged or skip-worktree: status can't see edits there
        return "has files git status doesn't check (assume-unchanged or skip-worktree): " + ", ".join(hidden[:5])
    ignored = [p for p in git(path, "ls-files", "--others", "--ignored", "--exclude-standard", "--directory", "-z")
               .split("\0") if p and not REGENERATED.search(p)]
    if ignored:
        return "has ignored files only it holds: " + ", ".join(ignored[:5])
    return None


def branch_keys(root, branch, deadline):
    """The keys the kit's files for this branch sit under: its own, and those of its earlier names (to a `git branch -c`
    copy) and its dashed key from before `~`, each only while no branch holds that name. Raises OSError or
    subprocess.SubprocessError when its rename history can't be read."""
    earlier = [name for name in phase_switches.earlier_names(root, branch, deadline)
               if name != branch and not phase_switches.branch_exists(root, name, deadline)]
    keys = [review_stamp.branch_key(name) for name in [branch] + earlier]
    keys += [name.replace("/", "-") for name in [branch] + earlier
             if "/" in name and not phase_switches.branch_exists(root, name.replace("/", "-"), deadline)]
    return list(dict.fromkeys(keys))


def kit_files(root, repo, keys):
    """The spec, reports, evidence and stamps kept under these keys, in the shared git dir and in $TMPDIR."""
    found = [os.path.join(root, "agents", "stamps", key) for key in keys]
    for where in (os.path.join(root, "agents"), review_stamp.TMP_SPECS):
        found += [os.path.join(where, name) for key in keys for name in review_stamp.branch_file_names(repo, key)]
    return [path for path in found if os.path.lexists(path)]


def unfinished_guide(root, repo, keys):
    """Why the branch's checks guide asks to keep it: a step after the merge whose latest result isn't PASS, or the guide
    can't be read. None when no guide does."""
    for where in (os.path.join(root, "agents"), review_stamp.TMP_SPECS):
        for key in keys:
            # Guides written before checks-guide were named staging-guide: reports reads that one only without the other.
            guides = [os.path.join(where, f"{kind}-{repo}-{key}.md") for kind in ("checks-guide", "staging-guide")]
            guide = next((path for path in guides if os.path.lexists(path)), None)
            if not guide:
                continue
            try:
                with open(guide) as fh:
                    steps = review_stamp.guide_steps(fh.read())
            except (OSError, UnicodeDecodeError) as error:  # unknown is never safe
                return f"couldn't read its checks guide {guide}: {error}"
            pending = [step for step, info in steps.items() if step.startswith("P") and info["result"] != "PASS"]
            if pending:
                return f"its checks guide {guide} has steps after the merge that haven't passed: {', '.join(pending)}"
    return None


def delete(paths):
    """Remove each path; the "couldn't delete" line of each that stays."""
    problems = []
    for path in paths:
        try:
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path)
            else:
                os.remove(path)
        except OSError as error:
            problems.append(f"couldn't delete {path}: {error}")
    return problems


def branch_line(done, branch, switches, files, problems):
    return (f"{done} branch {branch}{' and its phase switches' if switches else ''}"
            f"{', and its files ' + ', '.join(files) if files else ''}{', but ' + '; '.join(problems) if problems else ''}")


def main():
    args = sys.argv[1:]
    if args not in ([], ["--dry-run"]):
        print(__doc__)
        return 2
    dry = bool(args)
    try:
        root = git(os.getcwd(), "rev-parse", "--path-format=absolute", "--git-common-dir").strip()
        default = git(root, "rev-parse", "--abbrev-ref", "origin/HEAD").strip()
        try:
            # The default branch alone, into its tracking ref whatever the fetch config says, and no tags.
            name = default.removeprefix("origin/")
            git(root, "fetch", "--quiet", "--no-tags", "origin", f"+refs/heads/{name}:refs/remotes/origin/{name}")
        except GitFailed as error:
            print(f"prune-merged: couldn't fetch {default}, so nothing was removed: {error}", file=sys.stderr)
            return 1
        repo = review_stamp.repo_name_of(root)
        try:
            common, unnamed = phase_switches.checkout(os.getcwd())[2], None
        except (OSError, subprocess.SubprocessError, ValueError) as error:
            common, unnamed = None, f"couldn't name the repo to find its phase switches: {error}"
        here = os.path.realpath(os.getcwd())
        cwds = process_cwds()
        failed = False
        gone = set()  # worktrees removed, or that --dry-run would remove
        for path, branch, locked in worktrees(root)[1:]:
            try:
                reason = keep_reason(path, locked, default, here, cwds)
            except GitFailed as error:  # unknown is never safe
                reason = f"couldn't inspect it: {error}"
            if reason:
                print(f"kept {path}: {reason}")
            elif dry:
                print(f"would remove {path}")
                gone.add(path)
            else:
                try:
                    git(root, "worktree", "remove", path)  # no --force: git checks again that nothing changed since
                    print(f"removed {path}")
                    gone.add(path)
                except GitFailed as error:
                    print(f"kept {path}: removal failed: {error}")
                    failed = True
        local_default = default.removeprefix("origin/")
        merged = git(root, "for-each-ref", "--merged", default, "--format=%(objectname) %(symref) %(refname)", "refs/heads")
        for line in merged.splitlines():
            oid, symref, ref = line.split(" ")
            branch = ref.removeprefix("refs/heads/")
            # Read again for each branch: another session may have checked one out since.
            checked_out = {b for p, b, _ in worktrees(root) if b and p not in gone}
            if symref or branch == local_default or branch in checked_out:
                continue
            deadline = time.monotonic() + 5
            try:  # while the reflog that names its earlier names still exists: deleting the branch removes it
                keys, unread = branch_keys(root, branch, deadline), None
            except (OSError, subprocess.SubprocessError) as error:
                keys, unread = [review_stamp.branch_key(branch)], f"kept any files of its earlier names: {error}"
            unfinished = unfinished_guide(root, repo, keys)
            if unfinished:
                print(f"kept branch {branch}: {unfinished}")
                continue
            files = kit_files(root, repo, keys)
            if dry:
                problems = [unread] if unread else []
                try:
                    if unnamed:
                        problems.insert(0, unnamed)
                    switched = not unnamed and bool(phase_switches.branch_switches(common, branch) or
                                                    phase_switches.earlier_switches(common, branch, deadline))
                except (OSError, subprocess.SubprocessError) as error:
                    switched = False
                    problems.insert(0, f"couldn't check its phase switches: {error}")
                print(branch_line("would delete", branch, switched, files, problems))
                failed = failed or bool(unread)
                continue
            unfollowed = None
            if not unnamed:
                try:
                    phase_switches.follow_rename(common, branch, deadline)
                except (OSError, subprocess.SubprocessError) as error:
                    unfollowed = f"couldn't follow its rename: {error}"
            try:
                # Only if it still points where --merged saw it: a branch moved since keeps its new commits.
                git(root, "update-ref", "--no-deref", "-d", ref, oid)
            except GitFailed as error:
                print(f"kept branch {branch}: {error}")
                failed = True
                continue
            problems = delete(files) + ([unread] if unread else [])
            forgot = False
            if unnamed:
                problems.insert(0, f"kept its phase switches: {unnamed}")
            else:
                try:
                    forgot = phase_switches.forget_branch(common, branch) and not unfollowed
                    if unfollowed:  # its own file and label are gone; only its earlier name's file stays
                        problems.insert(0, f"kept the phase switches of its earlier name: {unfollowed}")
                except OSError as error:
                    problems.insert(0, f"kept its phase switches: {error}")
            print(branch_line("deleted", branch, forgot, [path for path in files if not os.path.lexists(path)], problems))
            failed = failed or bool(problems)
    except GitFailed as error:
        print(f"prune-merged: {error}", file=sys.stderr)
        return 1
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
