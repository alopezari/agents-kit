#!/usr/bin/env python3
"""Wait for the CI checks of one commit and say how they ended.

  ci-wait [--sha SHA] [--timeout SECS] [--once] [--no-log]

Reads the commit's check runs and commit statuses, so CI outside GitHub Actions counts too, keyed on the SHA:
a check from an earlier push never passes for this one. Waits until every check is done and the set holds for
one more look, as another workflow's checks can register late (30 minutes by default; --once looks once).
Prints one line per check and, for a failed GitHub Actions job, the failing lines of its log and its tail
(not with --no-log), then `ci-wait: failed on <sha>: <checks>` when any failed.
Exit: 0 passed, 1 failed, 2 still running, 3 no checks for the commit, 4 GitHub couldn't be read,
64 wrong arguments.
"""
import argparse
import json
import math
import os
import re
import subprocess
import sys
import time

PASSED_RUN = {"success", "neutral", "skipped"}
GH_TIMEOUT = 30
# Checks show up some time after the push; before that, "no checks" means "not yet". Keep it equal to the stop
# hook's NO_CHECKS_GRACE_SECS: the hook asks the agent to wait here while it still treats "no checks" as "not yet".
GRACE_SECS = 300
RUNNING = {"queued", "in_progress", "waiting", "requested", "pending"}
# A step's log is long and its summary comes last: the failing lines first, then a short tail.
FAILURE_LINE = re.compile(r"\bFAIL(ED|URE)?\b|\bError\b|error:|Traceback|Assertion", re.I)
FAILURE_LINES = 40
LOG_TAIL = 20


class Unreadable(Exception):
    pass


def gh(*args):
    try:
        result = subprocess.run(["gh", *args], capture_output=True, text=True, timeout=GH_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Unreadable(str(error))
    if result.returncode != 0:
        raise Unreadable(result.stderr.strip()[-300:])
    return result.stdout


def listed(endpoint, key):
    """Every item of a paginated list: a failing check on page two must not pass as green."""
    return [json.loads(line) for line in gh("api", "--paginate", "--jq", f".{key}[]", endpoint).splitlines() if line]


def checks(sha):
    """[(name, state, details url)], state being "running", "passed" or the failing conclusion."""
    try:
        runs = listed(f"repos/{{owner}}/{{repo}}/commits/{sha}/check-runs?per_page=100", "check_runs")
        statuses = listed(f"repos/{{owner}}/{{repo}}/commits/{sha}/status?per_page=100", "statuses")
        found = [(run["name"], run["status"] if run["status"] != "completed" else run["conclusion"],
                  run.get("details_url") or "") for run in runs]
        found += [(s["context"], s["state"], s.get("target_url") or "") for s in statuses]
    except (ValueError, KeyError, TypeError, AttributeError) as error:
        raise Unreadable(f"unexpected answer: {error!r}")
    if not all(isinstance(field, str) for check in found for field in check):
        raise Unreadable(f"unexpected answer: {found!r:.300}")
    return found


def failed(state):
    return state not in PASSED_RUN | RUNNING


def running(state):
    return state in RUNNING


def failed_log(url):
    job = re.search(r"/actions/runs/\d+/job/(\d+)", url)
    if not job:
        return ""
    try:
        lines = gh("run", "view", "--job", job.group(1), "--log-failed").splitlines()
    except Unreadable as error:
        return f"    (couldn't read its log: {error})"
    head = [line for line in lines[:-LOG_TAIL] if FAILURE_LINE.search(line)][:FAILURE_LINES]
    return "\n".join("    " + line for line in head + (["    ..."] if head else []) + lines[-LOG_TAIL:])


def seconds(text):
    value = float(text)
    if not math.isfinite(value) or value < 0:
        raise argparse.ArgumentTypeError(f"not a number of seconds: {text}")
    return value


def main():
    parser = argparse.ArgumentParser(prog="ci-wait", description="Wait for the CI checks of one commit.")
    parser.add_argument("--sha")
    parser.add_argument("--timeout", type=seconds, default=1800)
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--no-log", action="store_true")
    try:
        args = parser.parse_args()
    except SystemExit as exit:  # argparse's own 2 would read as "still running"
        return 64 if exit.code else 0
    sha, timeout, once = args.sha, args.timeout, args.once
    if not sha:
        sha = subprocess.run(["git", "rev-parse", "HEAD"], capture_output=True, text=True).stdout.strip()
    poll = float(os.environ.get("CI_WAIT_POLL_SECS", "20"))  # tests shorten these two
    grace = float(os.environ.get("CI_WAIT_GRACE_SECS", GRACE_SECS))
    start, previous = time.time(), None
    while True:
        try:
            found = checks(sha)
        except Unreadable as error:
            print(f"ci-wait: couldn't read the checks of {sha[:12]} from GitHub: {error}")
            return 4
        waited = time.time() - start
        complete = found and not any(running(state) for _, state, _ in found)
        done = complete and (any(failed(state) for _, state, _ in found) or found == previous)
        if done or once or waited >= timeout or (not found and waited >= grace):
            break
        previous = found if complete else None
        time.sleep(min(poll, max(timeout - waited, 0.1)))
    if not found and not once and waited < grace:
        print(f"ci-wait: no checks yet for {sha[:12]} after {int(waited)}s; still running")
        return 2
    if not found:
        print(f"ci-wait: no checks for {sha[:12]}{'' if once else f' after {int(waited)}s'}")
        return 3
    for name, state, url in found:
        print(f"{name}: {state}")
        if failed(state) and not args.no_log:
            log = failed_log(url)
            if log:
                print(log)
    failures = [name for name, state, _ in found if failed(state)]
    if failures:
        print(f"ci-wait: failed on {sha[:12]}: {', '.join(failures)}")
        return 1
    if any(running(state) for _, state, _ in found) or not (done or once):  # green once isn't settled yet
        print(f"ci-wait: still running on {sha[:12]}" + ("" if once else f" after {int(waited)}s"))
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
