#!/usr/bin/env python3
"""Print a pull request's "## Validation" section from the branch's reports, so it states what they record.

  pr-validation    verify's verdict and what it ran, the review's findings, each validation check with its
                   result and what wasn't run, each step of the checks guide with its owner or its latest result,
                   and each phase the user switched off

Links become their text and paths under your home start with ~: the reports are local, the pull request isn't.
Exits 1, printing nothing, when the verify or review report is missing and the user hasn't switched its phase off.
"""
import os
import re
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks"))
import phase_switches  # noqa: E402
import review_stamp  # noqa: E402

RESULTS = ("PASS", "FAIL", "NOT RUN")


def public(text):
    # Inline links, whose target may hold balanced parentheses, and reference links.
    text = re.sub(r"\[([^\]]*)\](?:\((?:[^()]|\([^()]*\))*\)|\[[^\]]*\])", r"\1", text).replace("\\|", "|").replace("\t", " ")
    return re.sub(re.escape(os.path.expanduser("~")) + r"(?=/)", "~", text)


def read(path):
    try:
        with open(path) as fh:
            return fh.read()
    except FileNotFoundError:
        return None


def verify_line(text):
    verdict = re.search(r"^# Verify: (.+)$", text, re.M)
    checks, pythons = [], []
    for ran in re.findall(r"^ran: (?!nothing to check)(.+)$", text, re.M):
        check, _, python = ran.partition(" with Python ")
        if python and python not in pythons:
            pythons.append(python)
        if check not in checks:
            checks.append(check)
    line = f"- Verify: {verdict.group(1).rstrip('.') if verdict else 'no verdict'}"
    line += f", {len(checks)} check{'s' * (len(checks) != 1)}: {', '.join(checks)}" if checks else ""
    line += f" (also under Python {', '.join(pythons)})" if pythons else ""
    return [public(line) + "."]


def labelled(text, labels):
    """(label, entry) for `Label: entry` lines, and for each `- entry` under a `Label:` line of its own.

    The entries are the bullets at the first one's indentation: blank lines between them, wrapped
    lines and nested bullets (deeper) stay inside the list; any other line ends it."""
    entries, label, indent = [], None, None
    for line in text.splitlines():
        head = re.match(rf"({labels}):[ \t]*(.*)$", line)
        item = re.match(r"([ \t]*)[-*][ \t]+(\S.*)$", line)
        depth = len(line) - len(line.lstrip())
        if head:
            label, rest = head.groups()
            if rest.strip():
                entries.append((label, rest))
                label = None
            indent = None
        elif label and item and indent in (None, item.group(1)):
            indent = item.group(1)
            entries.append((label, item.group(2)))
        elif label and (not line.strip() or (indent is not None and depth > len(indent))):
            continue
        else:
            label = None
    return [(label, value) for label, value in entries if value.strip().rstrip(".").lower() != "none"]


def review_lines(text):
    # "Self-review" heads the reports written before the review was renamed.
    header = next((line.strip() for line in text.splitlines() if re.match(r"(Self-review|Review)( \(|$)", line)), "Review")
    findings = [(kind, summary.split(" — ")[0].strip().rstrip(".") + ".")
                for kind, summary in labelled(text, "Fixed|Rejected|Open|Pre-existing")]
    counts = ", ".join(f"{n} {kind.lower()}" for kind in ("Fixed", "Rejected", "Open", "Pre-existing")
                       for n in [sum(k == kind for k, _ in findings)] if n or kind != "Pre-existing")
    not_run = [rest.split(" — ")[0].strip() for _, rest in labelled(text, "Not run")]
    return [public(f"- {header}: {counts}.")] + [public(f"  - {kind}: {summary}") for kind, summary in findings] + \
        [public(f"  - Not run: {rest}") for rest in not_run]


def validation_lines(text):
    rows, columns = [], None
    for line in text.splitlines():
        cells = [c.strip() for c in re.split(r"(?<!\\)\|", re.sub(r"^\s*\||(?<!\\)\|\s*$", "", line))] \
            if re.search(r"(?<!\\)\|", line) else None
        if not cells:
            columns = None
        elif {"Check", "Result"} <= {c.strip("*_") for c in cells}:
            names = [c.strip("*_") for c in cells]
            columns = (names.index("Check"), names.index("Result"))
        elif columns and len(cells) > max(columns):
            result = re.match(r"[*_]*(PASS|FAIL|NOT RUN)\b", cells[columns[1]])
            if result:
                rows.append((cells[0], result.group(1), cells[columns[0]]))
    counts = ", ".join(f"{n} {result}" for result in RESULTS for n in [sum(r == result for _, r, _ in rows)] if n)
    lines = [f"- Validation, {len(rows)} check{'s' * (len(rows) != 1)}: {counts or 'none'}."]
    lines += [f"  - {first} {result}: {check}" for first, result, check in rows]
    lines += [f"  - Not run: {rest}" for _, rest in labelled(text, "Not run")]
    return [public(line) for line in lines]


def checks_lines(text):
    """One line per step of the checks guide: its latest PASS or FAIL with that table's date, else who runs it."""
    steps = review_stamp.guide_steps(text)
    if not steps:
        return ["- Checks guide: no steps."]
    lines = []
    for step, info in sorted(steps.items(), key=lambda item: item[0].startswith("P")):
        after = step.startswith("P")
        named = f"{step} {info['name']}".strip()
        if info["result"]:
            lines.append(f"- {'After the merge' if after else 'Before the merge (optional)'}: {named}: "
                         f"{info['result']}{info['date']}.")
        else:
            lines.append(f"- {'After the merge' if after else 'Not run before the merge (optional)'}: {named} ({info['owner']}).")
    return [public(line) for line in lines]


def main():
    verify, review, validation, guide = review_stamp.report_paths("verify", "review", "validation", "checks-guide")
    texts = {path: read(path) for path in (verify, review, validation)}
    off, unreadable = phase_switches.phases_off_or_error(os.getcwd())
    missing = [path for path, phase in ((verify, "verify"), (review, "review")) if texts[path] is None and phase not in off]
    if missing:
        sys.exit("pr-validation: no report at " + " or ".join(missing)
                 + ". Run verify and the kit-review skill first; the section is built from their reports."
                 + (f" ({unreadable}.)" if unreadable else ""))
    # A phase switched off stands in for its report: one left from before the switch may be stale.
    shown = {path: text for path, phase, text in ((verify, "verify", texts[verify]), (review, "review", texts[review]),
             (validation, "validate", texts[validation])) if phase not in off}
    lines = verify_line(shown[verify]) if shown.get(verify) is not None else []
    lines += review_lines(shown[review]) if shown.get(review) is not None else []
    if shown.get(validation) is not None:
        lines += validation_lines(shown[validation])
    try:  # validate writes the guide, so one from before validate was switched off may be stale too
        checks = read(guide) if "validate" not in off else None
    except (OSError, UnicodeDecodeError) as error:  # shown, not fatal: the guide only informs the user's decision
        lines.append(public(f"- Checks guide unreadable: {error}."))
    else:
        lines += checks_lines(checks) if checks is not None else []
    # A reviewer's own switch skips nothing when the other reviewer runs: the review's Not run line says when it did.
    lines += [f"- {phase.capitalize()}: skipped by the user ({off[phase]})."
              for phase in phase_switches.PHASES if phase in off and phase not in ("claude-review", "codex-review")]
    print("## Validation\n\n" + "\n".join(lines))


if __name__ == "__main__":
    main()
