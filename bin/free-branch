#!/usr/bin/env python3
"""Free a pushed branch from its worktree, so the user can switch to it in the main checkout.

  free-branch <worktree>

Run from the session's own directory, not after a cd into the worktree: a worktree the session runs in is detached
(`git switch --detach`), because removing it would break every hook the session runs from there; any other is
removed. Refuses, changing nothing, when the worktree has uncommitted or untracked files, or commits not pushed to
the branch's upstream, and never touches the main checkout. Prints the command that switches to the branch.
"""
import os
import subprocess
import sys


def git(cwd, *args):
    return subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True)


def fail(message):
    print(f"free-branch: {message}", file=sys.stderr)
    return 1


def main():
    if len(sys.argv) != 2 or sys.argv[1].startswith("-"):
        print(__doc__)
        return 2
    worktree = os.path.realpath(sys.argv[1])
    top = git(worktree, "rev-parse", "--show-toplevel")
    if top.returncode != 0 or os.path.realpath(top.stdout.strip()) != worktree:
        return fail(f"{worktree} is not the top of a git worktree")
    listing = git(worktree, "worktree", "list", "--porcelain").stdout
    main_checkout = os.path.realpath(listing.split("\n", 1)[0].removeprefix("worktree "))
    if worktree == main_checkout:
        return fail(f"{worktree} is the main checkout: there is nothing to free")
    branch = git(worktree, "branch", "--show-current").stdout.strip()
    if not branch:
        return fail(f"{worktree} is on no branch: there is nothing to free")
    dirty = git(worktree, "status", "--porcelain", "--untracked-files=all").stdout
    if dirty.strip():
        return fail(f"{worktree} has files that would stay behind, off the branch; commit or remove them:\n{dirty}")
    head, upstream = git(worktree, "rev-parse", "HEAD").stdout.strip(), git(worktree, "rev-parse", "@{upstream}")
    if upstream.returncode != 0 or upstream.stdout.strip() != head:
        return fail(f"{branch} has commits its upstream doesn't: push it first")

    here = os.path.realpath(os.getcwd())
    if here == worktree or here.startswith(worktree + os.sep):
        result, done = git(worktree, "switch", "--quiet", "--detach"), f"detached {worktree} (the session runs there)"
    else:
        result, done = git(main_checkout, "worktree", "remove", worktree), f"removed {worktree}"
    if result.returncode != 0:
        return fail(result.stderr.strip())
    print(f"{done}; {branch} is free.\nSwitch to it: cd {main_checkout} && git switch {branch}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
