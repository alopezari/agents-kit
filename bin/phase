#!/usr/bin/env python3
"""Where the current branch is in the kit's flow, for the status line:
spec → build → self-review → validate → staging → create-pr → PR open → ship.

  phase             print the cached phase at once; refresh it in the background when older than 15 s
  phase --refresh   work it out now from the spec, stamps, reports and PR state, cache it and print it
  phase switches    the phases the user switched off for this checkout, one per line with why (exit 1 unreadable)
  phase review-rounds  how many re-checks the self-review runs here, and where that's set: `2 (repo)`, `1 (default)`

A phase the user switched off (`phase off <phase>` in a message, or `/flow off <phase>` in Claude Code) leaves the flow, and the label ends `· off: <phases>`.

The label prints nothing outside a git repo, on the default branch or when detached; `switches` prints there too.
"""
import json
import os
import subprocess
import sys
import time

sys.path.insert(0, os.path.expanduser("~/.agents/hooks"))
import phase_switches  # noqa: E402
import review_stamp  # noqa: E402

LOCAL_TTL = 15
PR_TTL = 300
REFRESH_LOCK_TTL = 60
# The status line refreshes often, and the user's own git commands must never hit an index.lock held by it.
os.environ["GIT_OPTIONAL_LOCKS"] = "0"


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout.strip()


def cache_files():
    """(cache, lock) for this branch, or None where no phase applies. One git call: this runs on every refresh."""
    # The full ref: --abbrev-ref says heads/<branch> when a tag has the branch's name, and the switches' writer
    # drops this cache by the branch's own name.
    out = git("rev-parse", "--path-format=absolute", "--git-common-dir", "--symbolic-full-name", "HEAD").splitlines()
    if len(out) != 2 or not out[1].startswith("refs/heads/"):
        return None
    cache = review_stamp.phase_cache(out[0], out[1][len("refs/heads/"):])
    return cache, cache[:-len(".json")] + ".lock"


def read_cache(path):
    try:
        return json.load(open(path))
    except (OSError, ValueError):
        return {}


def on_default_branch():
    return review_stamp.base_ref().split("/")[-1] == git("branch", "--show-current")


def pr_state(previous):
    """OPEN, MERGED or CLOSED from gh, at most every PR_TTL seconds; the last known state when gh fails."""
    if time.time() - previous.get("pr_checked_at", 0) < PR_TTL and previous.get("pr_state"):
        return previous["pr_state"], previous["pr_checked_at"]
    try:
        out = subprocess.run(["gh", "pr", "view", "--json", "state", "-q", ".state"], capture_output=True, text=True,
                             timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        out = ""
    return (out or previous.get("pr_state") or "UNKNOWN"), time.time()


def compute(previous):
    """The phase label, plus the PR fields to keep in the cache."""
    toplevel = git("rev-parse", "--show-toplevel")
    if not toplevel:
        return "", {}
    os.chdir(toplevel)
    if on_default_branch():
        return "", {}
    spec = subprocess.run([os.path.expanduser("~/.agents/skills/spec/path.sh")], capture_output=True,
                          text=True).stdout.strip()
    reports = os.path.dirname(spec)
    suffix = os.path.basename(spec)[len("spec-"):-len(".md")]

    # A PR may have been opened without follow-pr (by hand, or before the flow existed), so ask gh too, once the
    # branch is pushed. @{push}, not @{upstream}: a branch started from origin/main tracks it before it's pushed.
    followed = os.path.exists(os.path.join(reports, f"follow-pr-{suffix}.md"))
    pr, extra = None, {}
    if followed or git("rev-parse", "--verify", "--quiet", "@{push}"):
        state, checked_at = pr_state(previous)
        extra = {"pr_state": state, "pr_checked_at": checked_at}
        pr = {"MERGED": "ship", "CLOSED": "PR closed"}.get(state, "PR open" if followed or state == "OPEN" else None)
    off, unreadable = phase_switches.phases_off_or_error(toplevel)
    switched = (f" · off: {', '.join(p for p in phase_switches.PHASES if p in off)}" if off else "") + \
        (" · switches unreadable" if unreadable else "")
    if pr in ("ship", "PR closed"):
        return pr + switched, extra

    changed = review_stamp.changed_paths()[1]
    has_spec = os.path.exists(spec)
    if not has_spec and not changed:
        return (pr or ("build" if "spec" in off else "spec")) + switched, extra
    # The spec is a step, not a gate: a branch without one still has its real phase, flagged.
    flag = "" if has_spec or "spec" in off else " (no spec)"
    current = {kind: review_stamp.fingerprint_for(kind) for kind in ("verify", "review")}
    current.update({"verify-empty": current["verify"], "validate": current["review"], "staging": current["review"]})
    needs_validate = any(not review_stamp.NOT_BEHAVIOR.search(p) for p in changed)
    steps = [("build", "verify"), ("self-review", "review")] + ([("validate", "validate")] if needs_validate else [])
    steps = [(step, kind) for step, kind in steps if (kind if step == "build" else step) not in off]
    checked_nothing = (not review_stamp.stamp_matches("verify", current["verify"])
                       and review_stamp.stamp_matches("verify-empty", current["verify-empty"]))
    done = [review_stamp.stamp_matches(kind, current[kind]) or (kind == "verify" and checked_nothing) for _, kind in steps]
    # The phase is the step after the furthest one done for this exact change; an earlier check that
    # went stale (a red verify, an edit after the self-review) is listed, not shown as the phase.
    reached = max((i + 1 for i, ok in enumerate(done) if ok), default=0)
    # On an open PR every check should cover what is pushed, so each one that doesn't is listed.
    checked = steps if pr else steps[:reached]
    redo = [("verify" if kind == "verify" else step) for (step, kind), ok in zip(checked, done) if not ok]
    note = " · verify checked nothing" if checked_nothing and "verify" not in off else ""
    try:
        staging = review_stamp.staging_phase(os.path.join(reports, f"staging-guide-{suffix}.md"),
                                             os.path.join(reports, f"evidence-{suffix}"),
                                             review_stamp.stamp_matches("staging", current["staging"]))
    except OSError:
        staging = "staging (you)"
    staging = None if "staging" in off else staging
    # A re-run after staging once passed (its stamp exists) is outstanding whatever it shows: a FAIL, a step left.
    if pr and (staging == "staging: re-run" or (staging and os.path.exists(review_stamp.stamp_path("staging")))):
        redo.append("staging")
    if pr:
        return pr + (f" · redo {', '.join(redo)}" if redo else "") + note + switched, extra
    if reached < len(steps):
        label = steps[reached][0]
    else:
        label = staging or "create-pr"
    return label + (f" · redo {', '.join(redo)}" if redo else "") + note + flag + switched, extra


def refresh(files):
    cache, lock = files
    try:
        label, extra = compute(read_cache(cache))
    except RuntimeError as error:  # a git query the stamps need failed: say so instead of an old label
        label, extra = f"stamps: {error}"[:80], {}
    os.makedirs(os.path.dirname(cache), exist_ok=True)
    tmp = cache + ".tmp"
    with open(tmp, "w") as fh:
        json.dump({"label": label, "computed_at": time.time(), **extra}, fh)
    os.replace(tmp, cache)
    return label


def refresh_in_background(lock):
    try:
        if time.time() - os.path.getmtime(lock) < REFRESH_LOCK_TTL:
            return
        os.remove(lock)
    except OSError:
        pass
    try:
        os.makedirs(os.path.dirname(lock), exist_ok=True)
        os.close(os.open(lock, os.O_CREAT | os.O_EXCL))
    except OSError:
        return
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--refresh"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def main():
    if sys.argv[1:2] in (["switches"], ["review-rounds"]):
        try:
            if sys.argv[1] == "review-rounds":
                print("%d (%s)" % phase_switches.review_rounds(os.getcwd()))
                return 0
            off = phase_switches.phases_off(os.getcwd())
        except (phase_switches.StoreError, OSError, subprocess.SubprocessError, ValueError) as error:
            print(error if isinstance(error, phase_switches.StoreError) else f"Couldn't read the phase switches: {error}",
                  file=sys.stderr)
            return 1
        for phase in phase_switches.PHASES:
            if phase in off:
                print(f"{phase}: off ({off[phase]})")
        return 0
    files = cache_files()
    if not files:
        return 0
    if "--refresh" in sys.argv:
        try:
            print(refresh(files))
        finally:
            try:
                os.remove(files[1])
            except OSError:
                pass
        return 0
    cached = read_cache(files[0])
    if time.time() - cached.get("computed_at", 0) >= LOCAL_TTL:
        refresh_in_background(files[1])
    print(cached.get("label", ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
