# Only a page with a scene carries this. A scene's keyframes come through --k because an inline `animation` shorthand would beat the pause rule,
# and `*` doesn't match a pseudo-element, so every rule that stops the motion names the bar's too.
PLAYER_STYLE = """
.player{position:relative;display:grid;grid-template-columns:minmax(0,1fr);gap:.7rem}
.copy{display:grid;grid-template-columns:minmax(0,1fr);gap:.8rem;min-width:0}.copy-b{display:none}
.s-rb:checked~.copy-b,.s-pb:checked~.copy-b{display:grid}.s-rb:checked~.copy-a,.s-pb:checked~.copy-a{display:none}
