def esc(text):
    return html.escape(CONTROL.sub("�", text), quote=True)


def has_unstoppable_motion(data):
    """An animation declared !important. Found declaration by declaration: one regex over the whole file takes minutes on a repeated word."""
    for declaration in SVG_DECLARATION_END.split(data.lower()):
        at = declaration.find(b"animation")
        if at >= 0 and declaration.find(b"!important", at) >= 0:
            return True
    return False


def without_svg_comments(data):
    """The file with its comments cut, since a root written in a comment would take the stop rule. By hand for the same reason as above."""
    kept, at = [], 0
    while True:
        start = data.find(b"<!--", at)
        end = data.find(b"-->", start + 4) if start >= 0 else -1
        if end < 0:
            return b"".join(kept) + data[at:]
        kept.append(data[at:start])
        at = end + 3


def still_svg(data):
    """An SVG with its own motion, stopped, or None when the file's own !important would win: nothing on the page could pause it once it is an image.
    Stopped rather than refused, since a Mermaid diagram carries animation rules it never plays."""
    if not SVG_MOTION.search(data):
        return data
    data = without_svg_comments(data)
    if has_unstoppable_motion(data):
        return None
    return SVG_ROOT.sub(lambda found: found.group(0) + b"<style>*{animation:none!important}</style>", SVG_MOTION_TAG.sub(b"", data), count=1)


class SceneRefused(ValueError):
    """Why a scene file can't be drawn, in words for the page."""


def scene_quoted(value):
    return json.dumps(value)[:40]


def scene_number(value, bounds, where):
    if isinstance(value, bool) or not isinstance(value, (int, float)) or not bounds[0] <= value <= bounds[1]:
        raise SceneRefused(f"{where} must be a number from {bounds[0]} to {bounds[1]}, not {scene_quoted(value)}")
    return value


def writable(text):
    """json.loads turns "\\ud800" into a lone surrogate, which would fail the page's UTF-8 write and cost every figure."""
    try:
        text.encode()
    except UnicodeEncodeError:
        return False
    return True


def scene_text(value, key, where):
    if not isinstance(value, str) or not value.strip() or not writable(value):
        raise SceneRefused(f"{where} must be text")
    if len(value) > SCENE_TEXT_LIMITS[key]:
        raise SceneRefused(f"{where} is over {SCENE_TEXT_LIMITS[key]} characters")


def scene_keys(part, required, optional, where):
    if not isinstance(part, dict):
        raise SceneRefused(f"{where} must be an object")
    for key in part:
        if key not in required and key not in optional:
            raise SceneRefused(f"{where}: {scene_quoted(key)} is not allowed")
    for key in required:
        if key not in part:
            raise SceneRefused(f'{where}: missing "{key}"')


def check_scene_tracks(tracks, seconds, where, counted):
    scene_keys(tracks, (), SCENE_TRACKS, where + " tracks")
    for name, points in tracks.items():
        said = f"{where} {name}"
        if not isinstance(points, list) or len(points) < 2:
            raise SceneRefused(f"{said} needs at least two points")
        counted["points"] += len(points)
        if counted["points"] > SCENE_MAX_POINTS:
            raise SceneRefused(f"more than {SCENE_MAX_POINTS} timing points")
        last = None
        for point in points:
            if not isinstance(point, list) or len(point) != 2:
                raise SceneRefused(f"{said}: a point must be [second, value]")
            scene_number(point[0], (0, seconds), f"{said} time")
            scene_number(point[1], SCENE_TRACKS[name][1], f"{said} value")
            if last is not None and point[0] <= last:
                raise SceneRefused(f"{said}: the times must increase")
            last = point[0]


def check_scene_shape(shape, seconds, where, counted, in_group=False):
    if not isinstance(shape, dict):
        raise SceneRefused(f"{where} must be an object")
    kind = shape.get("shape")
    counted["shapes"] += 1
    if counted["shapes"] > SCENE_MAX_SHAPES:
        raise SceneRefused(f"more than {SCENE_MAX_SHAPES} shapes")
    if kind == "group":
        if in_group:
            raise SceneRefused(f"{where}: a group can't hold a group")
        scene_keys(shape, ("shape", "shapes"), ("opacity", "tracks"), where)
        if not isinstance(shape["shapes"], list):
            raise SceneRefused(f"{where}: shapes must be a list")
        for n, inner in enumerate(shape["shapes"], 1):
            check_scene_shape(inner, seconds, f"{where} inner shape {n}", counted, in_group=True)
    elif not isinstance(kind, str) or kind not in SCENE_GEOMETRY:
        raise SceneRefused(f"{where}: unknown shape {scene_quoted(kind)}")
    else:
        required = ("shape", *SCENE_GEOMETRY[kind], *{"text": ("text",), "line": ("stroke",)}.get(kind, ()))
        optional = (*SCENE_DEFAULTS[kind], "opacity", "tracks", "pulse", *(() if kind == "text" else ("stroke-dasharray",)))
        scene_keys(shape, required, optional, where)
        for key, bounds in SCENE_GEOMETRY[kind].items():
            scene_number(shape[key], bounds, f"{where} {key}")
        for key in ("fill", "stroke"):
            if key in shape and (not isinstance(shape[key], str) or shape[key] not in SCENE_COLOURS):
                raise SceneRefused(f"{where}: {scene_quoted(shape[key])} is not a colour token ({', '.join(SCENE_COLOURS)})")
        if kind == "text":
            scene_text(shape["text"], "text", f"{where} text")
        dash = shape.get("stroke-dasharray", [])
        if not isinstance(dash, list) or len(dash) > 4:
            raise SceneRefused(f"{where} stroke-dasharray must be a list of up to four numbers")
        for value in dash:
            scene_number(value, LENGTH, f"{where} stroke-dasharray")
        for key, choices in SCENE_CHOICES.items():
            if key in shape and (isinstance(shape[key], (bool, list, dict)) or shape[key] not in choices):
                raise SceneRefused(f"{where} {key} must be one of {', '.join(map(str, choices))}")
        if not isinstance(shape.get("pulse", False), bool):
            raise SceneRefused(f"{where} pulse must be true or false")
        if shape.get("pulse") and "tracks" in shape:
            raise SceneRefused(f"{where}: one animation per shape, so a pulse with a track goes in a group")
    for key, bounds in SCENE_NUMBERS.items():
        if key in shape:
            scene_number(shape[key], bounds, f"{where} {key}")
    if "tracks" in shape:
        check_scene_tracks(shape["tracks"], seconds, where, counted)
        if "translateY" in shape["tracks"]:
            if "scaleX" in shape["tracks"]:
                raise SceneRefused(f"{where}: translateY and scaleX share one transform, so one of them goes in a group")
            if shape["tracks"]["translateY"][-1][1] != 0:
                raise SceneRefused(f"{where}: translateY must end at 0, as the shape's own position is the still picture")
        if "opacity" in shape and "opacity" in shape["tracks"]:
            raise SceneRefused(f"{where}: opacity and its track are both set, and the track's last value is the picture")


def check_scene(scene):
    """Refuse anything off the allowlist. Past this, every value is a bounded number, a token from a fixed list, or plain text."""
    scene_keys(scene, ("title", "alt", "seconds", "height", "shapes", "steps"), (), "the scene")
    scene_text(scene["title"], "title", "title")
    scene_text(scene["alt"], "alt", "alt")
    seconds = scene_number(scene["seconds"], (1, 120), "seconds")
    scene_number(scene["height"], (1, 2000), "height")
    if not isinstance(scene["shapes"], list) or not scene["shapes"]:
        raise SceneRefused("shapes must hold at least one shape")
    counted = {"shapes": 0, "points": 0}
    for n, shape in enumerate(scene["shapes"], 1):
        check_scene_shape(shape, seconds, f"shape {n}", counted)
    steps = scene["steps"]
    if not isinstance(steps, list) or not steps:
        raise SceneRefused("steps must hold at least one step")
    if len(steps) > SCENE_MAX_STEPS:
        raise SceneRefused(f"more than {SCENE_MAX_STEPS} steps")
    previous = 0
    for n, step in enumerate(steps, 1):
        where = f"step {n}"
        scene_keys(step, ("from", "to", "caption"), (), where)
        scene_text(step["caption"], "caption", f"{where} caption")
        start = scene_number(step["from"], (0, seconds), f"{where} from")
        end = scene_number(step["to"], (0, seconds), f"{where} to")
        if end <= start:
            raise SceneRefused(f"{where} must end after it starts")
        if end - start < 2 * STEP_FADE or 0 < start < STEP_FADE:
            raise SceneRefused(f"{where} is too short to light and dim its caption")
        if start < previous:
            raise SceneRefused(f"{where} would overlap the step before it")
        previous = end


def parse_scene(data):
    if len(data) > SCENE_FILE_LIMIT:
        raise SceneRefused(f"over {SCENE_FILE_LIMIT // 1024} KB")

    def no_constant(name):
        raise ValueError(f"{name} is not a number")
    try:
        return json.loads(data.decode(), parse_constant=no_constant)
    except ValueError as error:
        raise SceneRefused(f"not valid JSON: {error}") from None
    except RecursionError:
        raise SceneRefused("not valid JSON: nested too deeply") from None


def readable_captions(scene):
    """What a refused scene can still say: its captions that are text, capped as a valid scene's are."""
    steps = scene.get("steps") if isinstance(scene, dict) else None
    if not isinstance(steps, list):
        return []
    found = [step["caption"] for step in steps[:SCENE_MAX_STEPS] if isinstance(step, dict) and isinstance(step.get("caption"), str)]
    return [caption[:SCENE_TEXT_LIMITS["caption"]] for caption in found if caption.strip() and writable(caption)]


def scene_num(value):
    """A checked number as CSS and SVG take it: never an exponent, which `str` gives a small float."""
    said = f"{value:.3f}".rstrip("0").rstrip(".")
    return "0" if said == "-0" else said


class Timeline:
    """One scene's clock: each track is a @keyframes over the same seconds, holding its first value from 0 and its last to the loop's end."""

    def __init__(self, prefix, seconds):
        self.prefix, self.seconds, self.count, self.css = prefix, seconds, 0, []

    def track(self, properties, ease="ease-in-out"):
        """`properties` holds one list of (second, declaration) per property, all in one @keyframes. Returns its name."""
        stops = {}
        for points in properties:
            first = [(0, points[0][1])] if points[0][0] > 0 else []
            last = [(self.seconds, points[-1][1])] if points[-1][0] < self.seconds else []
            for second, declaration in first + points + last:
                stops.setdefault(second, []).append(declaration)
        self.count += 1
        name = f"{self.prefix}t{self.count}"
        body = "".join(f"{second / self.seconds * 100:.2f}%{{{';'.join(declared)};animation-timing-function:{ease}}}" for second, declared in sorted(stops.items()))
        self.css.append(f"@keyframes {name}{{{body}}}")
        return name

    def caption(self, start, end):
        """The track that lights one step's caption while it plays."""
        lit, dim = "color:var(--fg);border-left-color:var(--ok)", "color:var(--muted);border-left-color:transparent"
        points = ([(start - STEP_FADE, dim)] if start > 0 else []) + [(start, lit), (end - STEP_FADE, lit)] + ([(end, dim)] if end < self.seconds else [])
        return self.track([points])


def draw_scene_shape(shape, timeline):
    """One checked shape as SVG. Its base attributes are the final picture, so a still figure is whole; the tracks only say how it got there."""
    kind = shape["shape"]
    tracks = shape.get("tracks", {})
    attrs = {**SCENE_DEFAULTS.get(kind, {}), **{key: value for key, value in shape.items() if key not in ("shape", "text", "shapes", "tracks", "pulse")}}
    for name in ("opacity", "stroke-dashoffset"):
        if name in tracks:
            attrs[name] = tracks[name][-1][1]
    classes, style = [], []
    if tracks:
        properties = [[(second, SCENE_TRACKS[name][0].format(scene_num(value))) for second, value in points] for name, points in tracks.items()]
        classes.append("m")
        style.append("--k:" + timeline.track(properties, "linear" if "scaleX" in tracks else "ease-in-out"))
    if "scaleX" in tracks:
        classes.append("grow")
        if tracks["scaleX"][-1][1] != 1:
            style.append(f"transform:scaleX({scene_num(tracks['scaleX'][-1][1])})")
    if shape.get("pulse"):
        across, down = list(SCENE_GEOMETRY[kind])[:2]
        classes.append("busy")
        style.append(f"animation-delay:-{scene_num((shape[across] + shape[down]) * PULSE_WAVE % PULSE_PERIOD)}s")

    def attribute(key, value):
        if key in ("fill", "stroke"):
            return SCENE_COLOURS[value]
        if isinstance(value, list):
            return " ".join(map(scene_num, value))
        return value if isinstance(value, str) else scene_num(value)
    said = "".join(f' {key}="{esc(attribute(key, value))}"' for key, value in attrs.items())
    said += f' class="{" ".join(classes)}"' if classes else ""
    said += f' style="{";".join(style)}"' if style else ""
    if kind == "group":
        return f"<g{said}>{''.join(draw_scene_shape(inner, timeline) for inner in shape['shapes'])}</g>"
    if kind == "text":
        return f"<text{said}>{esc(shape['text'])}</text>"
    return f"<{kind}{said}/>"


REL = ' rel="noreferrer noopener"'


def file_href(path):
    return "file://" + urllib.parse.quote(path)


def state(word, tone):
    """A state word, set in mono and colored by tone: ok (proven), need (needs the owner), dim (not run, not recorded),
    neutral (a finding: what was found, neither good nor bad)."""
    return f'<span class="st {tone}">{esc(word)}</span>'


def result_tone(result):
    return {"PASS": "ok", "FAIL": "need"}.get(result, "dim")


def heading(line, deepest=6):
    """(level, text) of an ATX heading line, or None. Trailing `#`s are stripped in Python: the regex that does it
    backtracks cubically on a long run of spaces."""
    found = re.match(rf"(#{{1,{deepest}}})[ \t]+(.*)$", line)
    if not found:
        return None
    text = found.group(2).rstrip()
    closed = text.rstrip("#")
    if closed != text and (not closed or closed[-1] in " \t"):
        text = closed.rstrip()
    return len(found.group(1)), text


def read_report(path):
    """(text, None), or (None, why) when the report is missing, can't be read or is over REPORT_LIMIT."""
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read(REPORT_LIMIT + 1)
        if len(text) > REPORT_LIMIT:
            return None, f"{path} is over the {REPORT_LIMIT // 1024 // 1024} MB a report may have"
        return text.replace("\r\n", "\n"), None
    except FileNotFoundError:
        return None, f"no report at {path}"
    except OSError as error:
        return None, f"can't read {path}: {error.strerror}"
    except UnicodeDecodeError as error:
        return None, f"can't read {path}: not UTF-8 ({error.reason} at byte {error.start})"


class Page:
    """What the page renders with: the evidence directory it may read, the bytes embedded so far, the ids taken."""

    def __init__(self, evidence):
        self.evidence = evidence
        self.root = os.path.realpath(evidence)
        self.embedded = 0
        self.scenes = 0
        self.id_counts = {}
        self.scene_css = []
        self.shown = {}  # realpath of a file already embedded: the id of the block that shows it
        self.lines = {}  # realpath of a text file embedded: its lines past bin/evidence's header, the cut middle left out
        self.cut = set()
        self.past = set()  # text files linked, not read, past the total: their steps and results are not on the page
        self.ids = set()
        self.repo_url = self.blob_sha = None  # set once the PR is read: where `path:line` and commits link on GitHub
        self.repo_root = os.path.realpath(os.getcwd())
        self.local_roots = [self.root]  # where a bare absolute path may link from: the evidence and the reports
        self.exists = {}
        self.tracked = None  # the files at blob_sha, read once on the first `path:line`
        scripts = os.path.join(evidence, "checks")
        inside = os.path.isdir(scripts) and os.path.realpath(scripts) == os.path.join(self.root, "checks")
        self.scripts = sorted(os.listdir(scripts)) if inside else []  # the kept check scripts, listed once

    def charge(self, *texts):
        """Count the text's UTF-8 bytes toward TOTAL_LIMIT, or count nothing and say False when they don't fit."""
        size = sum(len(text.encode()) for text in texts)
        if self.embedded + size > TOTAL_LIMIT:
            return False
        self.embedded += size
        return True

    def new_id(self, wanted):
        base = re.sub(r"[^A-Za-z0-9_.-]+", "-", wanted).strip("-") or "x"
        found, n = base, self.id_counts.get(base, 1)
        while found in self.ids:
            n += 1
            found = f"{base}-{n}"
        self.id_counts[base] = n
        self.ids.add(found)
        return found

    # Files

    def resolve(self, target):
        """(the path as named, its real path when that lies inside the evidence directory, else None)."""
        if target.startswith("file://"):
            target = urllib.parse.unquote(target[len("file://"):])
        named = os.path.expanduser(target)
        named = named if os.path.isabs(named) else os.path.join(self.evidence, named)
        real = os.path.realpath(named)
        return named, real if os.path.commonpath([self.root, real]) == self.root else None

    def file_block(self, named, real, again=False):
        """One file a check names: shown, linked, missing, or not read when it lies outside the evidence directory.
        Once shown it becomes a pointer to the first showing, unless `again` asks for the evidence itself."""
        label = f"<code>{esc(named)}</code>"
        if real is None:
            return f'<div class="file">{label} {state("not read", "dim")} outside the evidence directory</div>'
        if not os.path.exists(real):
            return f'<div class="file">{label} {state("missing", "need")}</div>'
        link = f'<a href="{esc(file_href(real))}">{esc(os.path.basename(real))}</a>'
        is_svg = real.lower().endswith(".svg")
        if real.lower().endswith(ACTIVE) and not is_svg:
            return f'<div class="file">{label} {state("not linked", "dim")} it would run its own scripts; open it yourself</div>'
        if is_svg:
            link = label  # as an <img> its scripts can't run; opened from a link they would
        if not os.path.isfile(real):
            return f'<div class="file">{link} {state("not read", "dim")} not a regular file</div>'
        if real in self.shown and not again:
            return f'<div class="file">{link} <a href="#{self.shown[real]}">shown above</a></div>'
        size = os.path.getsize(real)
        ext = os.path.splitext(real)[1].lower()
        block_id = self.new_id("file-" + os.path.basename(real))
        if ext in PLAYABLE:
            self.shown[real] = block_id
            replay = (f'<p class="meta">A replay of {esc(os.path.splitext(os.path.basename(real))[0])}.txt, recorded after the '
                      'check ran in full: not a live recording.</p>' if os.path.isfile(os.path.splitext(real)[0] + ".replay") else "")
            return (f'<div class="file video" id="{block_id}">{replay}<video controls preload="metadata" aria-label="{esc(os.path.basename(real))}">'
                    f'<source src="{esc(file_href(real))}" type="{PLAYABLE[ext]}">{link}</video>'
                    f'<p class="name">{link} <span class="size">{size} bytes</span></p></div>')
        if ext in VIDEOS:
            return f'<div class="file" id="{block_id}">{link} {state("linked", "dim")} video, {size} bytes</div>'
        if ext in IMAGES or is_svg:
            uri, tone, why = self.image_uri(real, size)
            if uri is None:
                return f'<div class="file" id="{block_id}">{link} {state(tone, "dim" if tone == "linked" else "need")} {why}</div>'
            self.shown[real] = block_id
            return (f'<figure class="file" id="{block_id}"><img src="{uri}" alt="{esc(os.path.basename(real))}">'
                    f"<figcaption>{link}</figcaption></figure>")
        return self.text_block(real, size, link, block_id)

    def image_uri(self, real, size):
        """(the image as a data: URI, charged to the total, None, None), or (None, a state word, why): one bad image costs only itself."""
        if size > IMAGE_LIMIT or self.embedded + size > TOTAL_LIMIT:
            return None, "linked", ("over 2 MB" if size > IMAGE_LIMIT else "past the 20 MB embedded in total") + f", {size} bytes"
        try:
            with open(real, "rb") as fh:
                data = fh.read(IMAGE_LIMIT + 1)
        except OSError as error:
            return None, "unreadable", esc(error.strerror or str(error))
        if len(data) > IMAGE_LIMIT:
            return None, "linked", "over 2 MB"
        ext = os.path.splitext(real)[1].lower()
        if ext == ".svg":
            data = still_svg(data)
            if data is None:
                return None, "not shown", "its own animation can't be stopped"
        self.embedded += len(data)
        return f"data:{IMAGES.get(ext, SVG_TYPE)};base64,{base64.b64encode(data).decode()}", None, None

    def scene_figure(self, label, target):
        """A scene file the notes name: compiled into a player, or, when refused, its captions and why. One bad scene costs only itself."""
        _, real = self.resolve(target)
        if real is None:
            return self.scene_refused(label, target, state("not read", "dim") + " outside the evidence directory")
        if not os.path.isfile(real):
            return self.scene_refused(label, target, state("missing", "need"))
        scene = None
        try:
            with open(real, "rb") as fh:
                data = fh.read(SCENE_FILE_LIMIT + 1)
            scene = parse_scene(data)
            check_scene(scene)
            if self.scenes >= SCENE_PAGE_LIMIT:
                raise SceneRefused(f"past the {SCENE_PAGE_LIMIT} scenes a page shows")
            player, keyframes = self.scene_player(scene)
            if not self.charge(player, keyframes):
                raise SceneRefused("past the 20 MB embedded in total")
        except OSError as error:
            return self.scene_refused(label, target, f'{state("unreadable", "need")} {esc(error.strerror or str(error))}')
        except SceneRefused as refusal:
            return self.scene_refused(label, target, f'{state("refused", "need")} {esc(str(refusal))}', readable_captions(scene))
        self.scene_css.append(keyframes)
        return f'<figure class="strip scene"><figcaption class="strip-title">{esc(scene["title"])}</figcaption>{player}</figure>'

    def scene_refused(self, label, target, why, captions=()):
        listed = "".join(item for item in (f"<li>{esc(caption)}</li>" for caption in captions) if self.charge(item))
        return (f'<figure class="strip scene-refused"><figcaption class="strip-title">{esc(label)}</figcaption>'
                f'<div class="file">This animation could not be shown: <code>{esc(target)}</code> {why}</div>' + (f'<ol class="stepl">{listed}</ol>' if listed else "") + "</figure>")

    def scene_player(self, scene):
        """(the player, its keyframes): four radios and two identical copies, because showing the other copy is what starts it over with no script.
        A scene past the autoplay limit has a fifth radio to start from: stopped on its whole picture, where a paused one would hold its first frame, maybe blank.
        A copy holds no id, which it would repeat."""
        self.scenes += 1
        timeline = Timeline(f"s{self.scenes}", scene["seconds"])
        shapes = "".join(draw_scene_shape(shape, timeline) for shape in scene["shapes"])
        steps = "".join(f'<li class="m" style="--k:{timeline.caption(step["from"], step["to"])}">{esc(step["caption"])}</li>' for step in scene["steps"])
        drawn = (f'<svg class="scene-art" role="img" aria-label="{esc(scene["alt"])}" viewBox="0 0 {SCENE_WIDTH} {scene_num(scene["height"])}">{shapes}</svg>'
                 f'<ol class="stepl">{steps}</ol><i class="prog" aria-hidden="true"></i>')
        title = esc(scene["title"])
        group = self.new_id(f"player-{self.scenes}")
        ids = {side: self.new_id(f"{group}-{side}") for side in ("ra", "pa", "rb", "pb")}
        plays_at_once = self.scenes <= AUTOPLAY_SCENES

        def radio(side, label):
            on = " checked" if side == "ra" and plays_at_once else ""
            return f'<input type="radio" class="sw s-{side} vh" name="{group}" id="{ids[side]}" aria-label="{label}: {title}"{on}>'

        def button(shows, side, icon, label):
            return f'<label class="btn {shows}" for="{ids[side]}"><i class="icon-{icon}"></i>{label}</label>'
        player = (f'<div class="player" role="group" aria-label="{title}" style="--L:{scene_num(scene["seconds"])}s">'
                  + ("" if plays_at_once else f'<input type="radio" class="sw s-still vh" name="{group}" aria-label="Stopped: {title}" checked>')
                  + radio("ra", "Play or restart") + radio("pa", "Pause") + radio("rb", "Play or restart") + radio("pb", "Pause")
                  + f'<div class="copy copy-a">{drawn}</div><div class="copy copy-b">{drawn}</div><div class="ctl">'
                  + button("to-pa", "pa", "pause", "Pause") + button("to-ra", "ra", "play", "Play")
                  + button("to-pb", "pb", "pause", "Pause") + button("to-rb", "rb", "play", "Play")
                  + button("re-b", "rb", "restart", "Restart") + button("re-a", "ra", "restart", "Restart") + "</div></div>")
        return player, "".join(timeline.css)

    def scene_style(self):
        """The player's rules and every scene's keyframes, only on a page that has a scene: nothing else on the page moves."""
        return PLAYER_STYLE + "".join(self.scene_css) if self.scene_css else ""

    def figure_image(self, target, caption):
        """An image the notes name: its <img>, or a line saying what kept it off the page. Never a link to an SVG."""
        _, real = self.resolve(target)
        if real is None:
            return f'<div class="file"><code>{esc(target)}</code> {state("not read", "dim")} outside the evidence directory</div>'
        if not os.path.isfile(real):
            return f'<div class="file"><code>{esc(target)}</code> {state("missing", "need")}</div>'
        if not real.lower().endswith(tuple(IMAGES) + (".svg",)):
            return f'<div class="file"><code>{esc(target)}</code> {state("not shown", "need")} not an image</div>'
        uri, tone, why = self.image_uri(real, os.path.getsize(real))
        if uri is None:
            link = (f"<code>{esc(target)}</code>" if real.lower().endswith(".svg")
                    else f'<a href="{esc(file_href(real))}">{esc(os.path.basename(real))}</a>')
            return f'<div class="file">{link} {state(tone, "dim" if tone == "linked" else "need")} {why}</div>'
        return f'<img src="{uri}" alt="{esc(caption)}">'

    def figure(self, caption, target, kind="fig"):
        """One image or scene the notes name, in place. An image's caption is both alt text and visible text; a scene carries its own."""
        if target.lower().endswith(SCENE_SUFFIX):
            return self.scene_figure(caption, target)
        return f'<figure class="{kind}">{self.figure_image(target, caption)}<figcaption>{self.inline(caption)}</figcaption></figure>'

    def figure_series(self, title, frames):
        """An ordered series of images and captions, shown as a still strip: nothing could pause an image, so motion is a scene's."""
        shown = "".join(
            f'<figure class="frame">{self.figure_image(target, caption)}<figcaption>'
            f'<span class="stepno">{n} of {len(frames)}</span>{self.inline(caption)}</figcaption></figure>'
            for n, (caption, target) in enumerate(frames, 1))
        named = f'<figcaption class="strip-title">{self.inline(title)}</figcaption>' if title else ""
        return f'<figure class="strip">{named}{shown}</figure>'

    def text_block(self, real, size, link, block_id):
        try:
            with open(real, "rb") as fh:
                head, tail = fh.read(TEXT_LIMIT + 1), b""
                if len(head) > TEXT_LIMIT:  # the head and the tail, each cut at a line end inside them
                    head = head[:TEXT_LIMIT // 2]
                    head = head[:head.rfind(b"\n") + 1] or head
                    fh.seek(max(size, TEXT_LIMIT + 1) - TEXT_LIMIT // 2)
                    tail = fh.read(TEXT_LIMIT // 2)
                    start = tail.find(b"\n")
                    tail = tail[start + 1:] if 0 <= start < len(tail) - 1 else tail
        except OSError as error:
            return f'<div class="file" id="{block_id}">{link} {state("unreadable", "need")} {esc(error.strerror or str(error))}</div>'
        if b"\0" in head[:8192]:
            return f'<div class="file" id="{block_id}">{link} {state("linked", "dim")} binary, {size} bytes</div>'
        if self.embedded + len(head) + len(tail) > TOTAL_LIMIT:
            self.past.add(real)
            return f'<div class="file" id="{block_id}">{link} {state("linked", "dim")} past the 20 MB embedded in total</div>'
        self.embedded += len(head) + len(tail)
        self.shown[real] = block_id
        body = head.decode(errors="replace").replace("\r\n", "\n")
        fields = ""
        lines = body.split("\n")
        if lines[0].startswith("$ ") and len(lines) > 1 and review_stamp.EVIDENCE_IN_LINE.fullmatch(lines[1]):
            lines[0], lines[1] = lines[1], lines[0]  # before the commit and tree, bin/evidence wrote `$ ` first
        ran = review_stamp.EVIDENCE_IN_LINE.fullmatch(lines[0])
        if ran:  # bin/evidence's header: `# in`, maybe `# fingerprint`, `$ command`, a blank line
            rest = lines[1:]
            if rest and rest[0].startswith("# fingerprint "):
                rest = rest[1:]
            command = rest[0][2:] if rest and rest[0].startswith("$ ") else None
            rest = rest[1:] if command is not None else rest
            rest = rest[1:] if rest and not rest[0].strip() else rest
            pairs = [("Command", command), ("Directory", ran.group("dir")), ("Time", ran.group("time")),
                     ("Exit", ran.group("exit")),
                     ("Commit", (ran.group("commit") or "") + (" with uncommitted changes" if ran.group("uncommitted") else "")),
                     ("Tree", ran.group("tree"))]
            fields = '<dl class="fields">' + "".join(
                f"<dt>{name}</dt><dd>{'<code>' + esc(value) + '</code>' if value else state('not recorded', 'dim')}</dd>"
                for name, value in pairs) + "</dl>"
            body = "\n".join(rest)
        lines = body.rstrip("\n").split("\n") if body.strip("\n") else []
        tail_lines = tail.decode(errors="replace").replace("\r\n", "\n").rstrip("\n").split("\n") if tail else []
        self.lines[real] = lines + tail_lines
        if tail:
            self.cut.add(real)
        last = tail_lines if tail else lines  # the visible tail never spans the cut
        earlier = last[:-TAIL_LINES]
        fold = ""
        if tail or earlier:
            cut = (f'<pre class="out">{esc(chr(10).join(lines))}</pre><p class="cut">{state("cut", "dim")} '
                   f"{size - len(head) - len(tail)} of {size} bytes cut from the middle; the full file: {link}</p>" if tail else "")
            count = len(lines) + len(earlier) if tail else len(earlier)
            fold = (f'<details class="earlier"><summary>{count} earlier line{"s" * (count != 1)}'
                    f'{", the middle cut" if tail else ""}</summary>{cut}'
                    + (f'<pre class="out">{esc(chr(10).join(earlier))}</pre>' if earlier else "") + "</details>")
        return (f'<div class="file text" id="{block_id}"><p class="name">{link} <span class="size">{size} bytes</span></p>'
                f'{fields}<pre class="out tail">{esc(chr(10).join(last[-TAIL_LINES:]))}</pre>{fold}</div>')

    # Markdown, a safe subset: headings, fenced blocks, tables, lists, paragraphs, code spans, bold and links

    def inline(self, text, links=True):
        """Code spans, bold and links; with links off (inside a <summary>, which can't hold one) a link is its label."""
        out, at = [], 0
        text = text.replace("\\|", "|").replace("\\`", ESCAPED_BACKTICK)
        for found in INLINE.finditer(text):
            out.append(self.plain(text[at:found.start()], links))
            at = found.end()
            code, bold, label, target = found.groups()
            if code is not None:
                whole = AUTOLINK.fullmatch(code.strip()) if links else None
                href = self.autolink_href(whole) if whole else None
                out.append(f'<a href="{esc(href)}"{REL}><code>{esc(code)}</code></a>' if href else f"<code>{esc(code)}</code>")
            elif bold is not None:
                out.append(f"<strong>{self.inline(bold, links)}</strong>")
            elif links:
                out.append(self.link(found.group(0), label, target.strip()))
            else:
                out.append(esc(label or target))
        out.append(self.plain(text[at:], links))
        return "".join(out).replace(ESCAPED_BACKTICK, "`")

    def plain(self, text, links=True):
        """Escaped text, with its URLs, `path:line` refs and local paths linked where they check out."""
        if not links:
            return esc(text)
        out, at = [], 0
        for found in AUTOLINK.finditer(text):
            href = self.autolink_href(found)
            if href:
                out.append(esc(text[at:found.start()]) + f'<a href="{esc(href)}"{REL}>{esc(found.group(0))}</a>')
                at = found.end()
        return "".join(out) + esc(text[at:])

    def autolink_href(self, found):
        url, path, line, local = found.groups()
        if url:
            return url
        if path:
            return self.blob_href(path, line)
        local, line = re.fullmatch(r"(.*?)(?::(\d+))?", local).groups()
        real = os.path.realpath(os.path.expanduser(local))
        # the main checkout holds the reports too, under .git: a path GitHub doesn't have still links locally
        in_repo = real.startswith(self.repo_root + os.sep)
        return (in_repo and self.blob_href(os.path.relpath(real, self.repo_root), line)) or self.local_href(local)

    def blob_href(self, path, line=None):
        """A repository file on GitHub at the PR's head, or None without a PR or for a path the PR's head doesn't hold."""
        if not self.repo_url:
            return None
        real = os.path.realpath(os.path.join(self.repo_root, path))
        relative = os.path.relpath(real, self.repo_root)
        if not real.startswith(self.repo_root + os.sep) or relative not in self.files_at_head():
            return None
        return f"{self.repo_url}/blob/{self.blob_sha}/{urllib.parse.quote(relative)}" + \
            (f"#L{line}" if line else "")

    def files_at_head(self):
        if self.tracked is None:
            try:
                out = subprocess.run(["git", "ls-tree", "-r", "-z", "--name-only", self.blob_sha], cwd=self.repo_root,
                                     capture_output=True, timeout=10)
                self.tracked = {os.fsdecode(name) for name in out.stdout.split(b"\0")} if out.returncode == 0 else set()
            except (OSError, subprocess.TimeoutExpired):
                self.tracked = set()
        return self.tracked

    def local_href(self, path):
        """A file under the evidence or reports directories, never an active one, by its file: URL; else None."""
        real = os.path.realpath(os.path.expanduser(path))
        if not real.lower().endswith(LINKABLE) or not any(real.startswith(root + os.sep) for root in self.local_roots):
            return None
        return file_href(real) if self.is_file(real) else None

    def is_file(self, real):
        if real not in self.exists:
            self.exists[real] = os.path.isfile(real)
        return self.exists[real]

    def commit(self, sha, pushed=True):
        """A commit id, linked to GitHub when the PR names its repository and the commit is pushed."""
        code = f"<code>{esc(sha)}</code>"
        return f'<a href="{esc(self.repo_url)}/commit/{esc(sha)}"{REL}>{code}</a>' if self.repo_url and pushed else code

    def path(self, path, label=None):
        """A local report or file named by its path: linked when it exists, the path as text otherwise."""
        href = self.local_href(path)
        code = f"<code>{esc(label or path)}</code>"
        return f'<a href="{esc(href)}">{code}</a>' if href else code

    def link(self, source, label, target):
        """A link to a file of the evidence directory or an https URL; anything else (another scheme, a path outside) stays its text."""
        url = AUTOLINK.fullmatch(target)
        if url and url.group(1):
            return f'{esc(label)} <a href="{esc(target)}"{REL}>{esc(target)}</a>' if label else self.plain(target)
        if re.match(r"[A-Za-z][A-Za-z0-9+.-]*:", target) and not target.startswith("file://"):
            return esc(source)
        _, real = self.resolve(target)
        if real is None or not os.path.exists(real) or real.lower().endswith(ACTIVE):
            return f"{esc(label)} <code>{esc(target)}</code>" if label else esc(source)
        return f'<a href="{esc(file_href(real))}">{esc(label or os.path.basename(real))}</a>'

    def figure_lines(self, lines, i):
        """The figure starting at lines[i], or None: an optional `Figure: title` line, then image lines with nothing between them."""
        titled = re.fullmatch(r"Figure:\s*(.+)", lines[i].strip())
        start = i + 1 if titled else i
        frames = []
        while start + len(frames) < len(lines):
            image = FIGURE_LINE.fullmatch(lines[start + len(frames)].strip())
            if not image or not image.group(2).lower().endswith(FIGURE_TYPES):
                break
            frames.append((image.group(1), image.group(2)))
        return (titled.group(1) if titled else "", frames, start + len(frames)) if frames else None

    def markdown(self, text, prefix, top=3, figures=False):
        """Blocks of Markdown: the shallowest heading becomes h(top), a deeper one one level further each, capped at h6.
        With `figures` (only the notes), a line that is only an image embeds it; several in a row are one series."""
        out, para, items, lines, i = [], [], [], text.split("\n"), 0
        list_indent = 0  # the first item's indentation: a deeper item is nested under the item before it

        def flush():
            if para:
                out.append(f"<p>{self.inline(chr(10).join(para))}</p>")
                para.clear()
            if items:
                html, nested = [], []
                for ordered, deep, body in items + [(False, False, None)]:
                    if not deep and nested:
                        tag = "ol" if nested[0][0] else "ul"
                        html[-1] = html[-1][:-len("</li>")] + f"<{tag}>" + "".join(
                            f"<li>{self.inline(b)}</li>" for _, _, b in nested) + f"</{tag}></li>"
                        nested.clear()
                    if deep:
                        nested.append((ordered, deep, body))
                    elif body is not None:
                        html.append(f"<li>{self.inline(body)}</li>")
                tag = "ol" if items[0][0] else "ul"
                out.append(f"<{tag}>" + "".join(html) + f"</{tag}>")
                items.clear()

        shallowest = min((heading(line)[0] for line, fenced in outside_fences("\n".join(lines)) if not fenced and heading(line)), default=1)  # a shell comment in a fence is no heading
        while i < len(lines):
            line = lines[i]
            fence = re.match(r"\s*(```+|~~~+)", line)
            title = heading(line)
            item = re.match(r"(\s*)([-*+]|\d+[.)])\s+(.*)$", line)
            cells = review_stamp.table_cells(line)
            found = self.figure_lines(lines, i) if figures else None
            if found:
                flush()
                title_of, frames, i = found
                out.append(self.figure_series(title_of, frames) if len(frames) > 1 else self.figure(*frames[0]))
                continue
            scene = FIGURE_LINE.fullmatch(line.strip()) if figures else None
            if scene and scene.group(2).lower().endswith(SCENE_SUFFIX):
                flush()
                out.append(self.figure(scene.group(1), scene.group(2)))
                i += 1
                continue
            if fence:
                flush()
                end = next((j for j in range(i + 1, len(lines)) if lines[j].strip().startswith(fence.group(1))), len(lines))
                body = lines[i + 1:end]
                out.append(f'<pre class="cmd"><code>{esc(chr(10).join(body))}</code></pre>')
                i = end + 1
                continue
            if title:
                flush()
                level = min(6, top + title[0] - shallowest)
                step = re.match(review_stamp.GUIDE_STEP, title[1])
                anchor = self.new_id(f"{prefix}-{step.group(1) if step else title[1].lower()}")
                out.append(f'<h{level} id="{anchor}">{self.inline(title[1])}</h{level}>')
            elif cells and i + 1 < len(lines) and TABLE_RULE.match(lines[i + 1]):
                flush()
                rows = []
                j = i + 2
                while j < len(lines) and review_stamp.table_cells(lines[j]):
                    rows.append(review_stamp.table_cells(lines[j]))
                    j += 1
                out.append(self.table(cells, rows))
                i = j
                continue
            elif item:
                if para:
                    flush()
                if not items:
                    list_indent = len(item.group(1))
                items.append([item.group(2)[0].isdigit(), bool(items) and len(item.group(1)) > list_indent, item.group(3)])
            elif not line.strip():
                flush()
            elif items and line.startswith((" ", "\t")):
                items[-1][2] += "\n" + line.strip()
            else:
                if items:
                    flush()
                para.append(line)
            i += 1
        flush()
        return "".join(out)

    def table(self, header, rows):
        head = "".join(f'<th scope="col">{self.inline(c)}</th>' for c in header)
        body = "".join("<tr>" + "".join(f"<td>{self.inline(c)}</td>" for c in row) + "</tr>" for row in rows)
        name = esc("Table: " + ", ".join(header))
        return f'<div class="table" tabindex="0" role="region" aria-label="{name}"><table><thead><tr>{head}</tr></thead><tbody>{body}</tbody></table></div>'


# Sources

outside_fences = review_stamp.outside_fences


def notes_by_section(text):
    """{section key: the notes' Markdown under its heading}."""
    found, current = {}, None
    for line, fenced in outside_fences(text):
        title = not fenced and heading(line, 3)
        if title and title[1].lower() in NOTE_SECTIONS:
            current = NOTE_SECTIONS[title[1].lower()]
            found.setdefault(current, [])
        elif current:
            found[current].append(line)
    return {n: "\n".join(lines).strip() for n, lines in found.items()}


def split_outside_parentheses(text, separator=","):
    """The comma-separated parts of text, a comma inside parentheses not splitting: "a (added: b, c), d" is two parts."""
    parts, depth, start = [], 0, 0
    for i, char in enumerate(text):
        if char == "(":
            depth += 1
        elif char == ")":
            depth = max(depth - 1, 0)
        elif char == separator and not depth:
            parts.append(text[start:i])
            start = i + 1
    return parts + [text[start:]]


def nit_list(entry):
    """(the lead, its items) for a review entry holding several Nits, "(re-check Nits kept) a; b; c"; else None."""
    found = re.match(r"\s*\(([^()]*)\)\s*(.+)", entry, re.S)
    found = found if found and re.search(r"\bnits?\b", found.group(1), re.I) else None
    items = [item.strip() for item in split_outside_parentheses(found.group(2), ";") if item.strip()] if found else []
    return (found.group(1), items) if len(items) > 1 else None


def first_sentence(text):
    """(the first sentence, the rest): the sentence ends at a stop followed by a space and a capital, outside code spans."""
    for found in re.finditer(r"`[^`\n]*`|[.!?](?=\s+[A-Z(`*])|(?<=\s)— verify:", text):
        if not found.group(0).startswith("`"):
            end = found.start() + (found.group(0) in ".!?")
            return text[:end].rstrip(), text[end:].strip()
    return text, ""


def first_paragraph(text):
    """The first paragraph of prose, past any leading headings and HTML comments a PR template puts first."""
    text = re.sub(r"<!--.*?(-->|$)", "", text, flags=re.S)
    lines = []
    for line in text.strip().split("\n"):
        if not line.strip() or heading(line) and not lines:
            if lines:
                break
            continue
        lines.append(line)
    return "\n".join(lines)


def parse_review(text):
    """(header line or None, {header field: value}, [(outcome, label, entry)]), or None when the text
    holds neither a review header nor any entry."""
    lines = text.split("\n")
    header = next((re.sub(r"^#+[ \t]+", "", line.strip()) for line in lines
                   if re.match(r"(?:#+[ \t]+)?(Self-review|Review)( \(|$)", line)), None)
    labels = "|".join(re.escape(o) for o in REVIEW_OUTCOMES)
    entries = []
    for label, entry in pr_validation.labelled(WRAPPED_LINE.sub(" ", text), rf"(?:{labels})(?: \([^)\n]*\))?"):
        entries.append((next(o for o in REVIEW_OUTCOMES if label.startswith(o)), label, entry))
    if header is None and not entries:
        return None
    fields = {}
    inside = re.match(r"(Self-review|Review) \((.*)\)\s*$", header or "")
    for part in inside.group(2).split(";") if inside else ():
        key, _, value = part.partition(":")
        fields[key.strip().lower()] = value.strip()
    return header, fields, entries


def check_rows(text, results=review_stamp.RESULTS):
    """[{id, result, check, ac, acs, ac_column, case, expected (None without the column), observed, line, group, level
    (None without the column)}] in report order."""
    lines = text.split("\n")
    rows = []
    groups, group = [], ""  # each line's `## ` section
    for line in lines:
        group = line[3:].strip() if line.startswith("## ") else group
        groups.append(group)
    for index, names, cells, result in review_stamp.result_table(lines, results):
        group = groups[index]

        def cell(name, prefix=False):
            at = next((i for i, n in enumerate(names) if (n.startswith(name) if prefix else n == name)), None)
            return None if at is None else (cells[at] if at < len(cells) else "")
        ac = cell("AC")
        said = RESULT_DETAIL.match(cell("Result") or "")
        rows.append({"id": cells[0].strip("*_ "), "result": result, "detail": said.group(1).strip() if said else "",
                     "check": cell("Check") or "", "ac": ac or "",
                     "acs": [int(n) for n in re.findall(r"\bAC(\d{1,6})\b", ac or "")], "ac_column": ac is not None, "case": cell("Case", True) or "",
                     "expected": cell("Expected", True), "observed": cell("Evidence") or "", "line": index + 1,
                     "group": group, "level": (cell("Level") or "").strip("*_` ").lower() or None})
    return rows


def named_files(page, row):
    """(path as named, real path inside the evidence directory or None) for each file the row's Evidence cell names,
    then the check's kept script from checks/."""
    scripts = [page.resolve(os.path.join(page.evidence, "checks", name)) for name in page.scripts if name.startswith(row["id"] + ".")]
    return unique_files(files_named_in(page, row["observed"]) + scripts)


def files_named_in(page, cell):
    """(path as named, real path inside the evidence directory or None) for each file a piece of Markdown names, once."""
    found = []
    for link in INLINE.finditer(cell):
        target = (link.group(4) or "").strip()
        if link.group(4) is not None and not (re.match(r"[A-Za-z][A-Za-z0-9+.-]*:", target) and not target.startswith("file://")):
            found.append(page.resolve(target))
    # A code span or bold text names its files on purpose; a word in the prose ("took ~3s", "GET /api/x 200",
    # "README.md updated") counts only when that file exists.
    spans = " ".join(m.group(1) or m.group(2) for m in INLINE.finditer(cell) if m.group(4) is None)
    prose = INLINE.sub(" ", cell)
    exists = lambda token: os.path.lexists(os.path.join(page.evidence, os.path.expanduser(token)))
    for text, named_on_purpose in ((spans, True), (prose, False)):
        found += [page.resolve(token) for token in PATH_TOKEN.findall(text) + FILE_TOKEN.findall(text)
                  if named_on_purpose or exists(token)]
    return unique_files(found)


def files_the_notes_name(page, text):
    """(path as named, real path inside the evidence directory or None) for each file the notes name: a link or an
    image always, and a code span, bold text or word only when the evidence directory holds it, since notes cite
    source files (`client.py:42`) the evidence directory never will."""
    found = [page.resolve(link.group(4).strip()) for link in INLINE.finditer(text) if link.group(4) is not None
             and not (re.match(r"[A-Za-z][A-Za-z0-9+.-]*:", link.group(4).strip()) and not link.group(4).strip().startswith("file://"))]
    spans = [m.group(1) or m.group(2) for m in INLINE.finditer(text) if m.group(4) is None]
    words = [re.sub(r":\d+(?::\d+)?$", "", span.strip()) for span in spans] + FILE_TOKEN.findall(" ".join(spans) + " " + INLINE.sub(" ", text))
    held = lambda word: (not os.path.isabs(os.path.expanduser(word)) and os.path.lexists(os.path.join(page.evidence, word))
                         and not os.path.isdir(os.path.join(page.evidence, word)))
    return unique_files(found + [page.resolve(word) for word in words if held(word)])


def unique_files(found):
    unique, seen = [], set()
    for named, real in found:
        key = real or named
        if key not in seen:
            seen.add(key)
            unique.append((named, real))
    return unique


def follow_pr_pending(text):
    """The CI checks the follow-pr report's latest run leaves pending, the comments every run left pending (a reply
    drafted or a question to the user, until a later line for the same id says otherwise), and the latest Status when
    it isn't ready to merge."""
    runs = re.split(r"^## Run\b", text, flags=re.M)
    last = runs[-1] if len(runs) > 1 else text
    comments = {}  # a comment is recorded once, in the run that handled it, and again only when its outcome changes
    for line in text.split("\n"):
        parts = [p.strip() for p in line.split(" — ")]
        if len(parts) >= 3 and not line.startswith(("CI:", "Status:")):
            comments[line.split()[0]] = line.strip() if re.match(r"(reply drafted|asked the user)\b", parts[-1], re.I) else None
    pending = []
    for line in last.split("\n"):
        ci = re.match(r"CI:\s*(.+)$", line)
        if ci and re.search(r":\s*pending\b", ci.group(1)):
            pending.append(f"CI {ci.group(1).strip()}")
    pending += [line for line in comments.values() if line]
    for line in last.split("\n"):
        status = re.match(r"Status:\s*(.+)$", line)
        if status and not status.group(1).strip().lower().startswith("ready to merge"):
            pending.append(f"Status: {status.group(1).strip()}")
    return pending


def pull_request():
    """(the PR's fields, None), (None, None) when the branch has no PR, or (None, why gh couldn't say)."""
    try:
        out = subprocess.run(["gh", "pr", "view", "--json", "number,url,title,headRefOid,state,mergeCommit"], capture_output=True,
                             text=True, timeout=GH_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, f"gh pr view: {error}"
    if out.returncode:
        if "no pull requests found" in out.stderr:
            return None, None
        return None, "gh pr view: " + ((out.stderr.strip().splitlines() or [f"exit {out.returncode}"])[-1])
    try:
        pr = json.loads(out.stdout)
        if not (isinstance(pr.get("number"), int) and re.fullmatch(r"[0-9a-f]{40,64}", pr.get("headRefOid") or "")):
            raise ValueError(f"unexpected answer: {out.stdout.strip()[:200]}")
    except (ValueError, AttributeError) as error:
        return None, f"gh pr view: {error}"
    return pr, None


def ci_state(pr, pr_error, off):
    """(word, tone, detail) for the CI of the PR's head commit only."""
    if "ci" in off:
        return "CI phase off", "dim", ""
    if pr_error:
        return "unknown", "need", pr_error
    if not pr:
        return "no PR yet", "dim", ""
    head = pr["headRefOid"]
    try:
        checks = ci_wait.checks(head)
    except ci_wait.Unreadable as error:
        return "unknown", "need", f"GitHub couldn't be read for {head}: {error}"
    if not checks:
        if ci_wait.runs_no_ci(head):
            return "no CI", "dim", "the repository runs no CI"
        return "missing", "need", f"no checks for {head}"
    failed = [name for name, check, _ in checks if ci_wait.failed(check)]
    running = [name for name, check, _ in checks if ci_wait.running(check)]
    names = ", ".join(f"{name}: {check}" for name, check, _ in checks)
    if failed:
        return "FAIL", "need", f"on {head}: {names}"
    if running:
        return "pending", "need", f"on {head}: {names}"
    return "PASS", "ok", f"on {head}: {names}"


def quality_record(pr):
    """(the last usable `quality-log pr` line for the PR, from the last REPORT_LIMIT of quality.jsonl, None), or (None, why not, as HTML)."""
    url = quality_log_cli.PR_URL.match(pr.get("url") or "")
    if not url:
        return None, f'{state("unknown", "dim")} the PR URL {esc(pr.get("url") or "")} names no repository'
    host, remote = url["host"].lower(), url["remote"].lower()
    try:
        with open(review_stamp.quality_log(), "rb") as fh:
            size = fh.seek(0, os.SEEK_END)
            start = max(size - REPORT_LIMIT - 1, 0)  # one byte early: a window starting on a line's first byte keeps it
            fh.seek(start)
            window = fh.read(REPORT_LIMIT + 1)
    except FileNotFoundError:
        return None, state("not recorded", "dim")
    except (OSError, RuntimeError) as error:  # RuntimeError: git timing out while quality_log() finds the main checkout
        return None, f'{state("unavailable", "need")} {esc(getattr(error, "strerror", None) or str(error))}'
    if start:
        window = window.partition(b"\n")[2]  # the window starts inside a line
    found = None
    for raw in reversed(window.split(b"\n")):
        try:
            line = json.loads(raw)
        except (ValueError, RecursionError):  # not JSON, not UTF-8, or a truncated last append
            continue
        if (isinstance(line, dict) and line.get("kind") == "pr" and type(line.get("name")) is int
                and line["name"] == pr["number"] and isinstance(line.get("host"), str) and isinstance(line.get("remote"), str)
                and line["host"].lower() == host and line["remote"].lower() == remote):
            found = line
            break
    if not found:
        return None, state(f"not in the last {REPORT_LIMIT // 1024 // 1024} MB of the log" if start else "not recorded", "dim")
    return found, None


def coverage_words(found):
    """A quality record's line coverage in words, or None when it holds no usable count."""
    coverage = (found or {}).get("coverage")
    covered, measured = (coverage.get("covered"), coverage.get("measured")) if isinstance(coverage, dict) else (None, None)
    if type(covered) is not int or type(measured) is not int or not 0 <= covered <= measured:
        return None
    return f"{covered}/{measured} lines ({covered * 100 // measured}%)" if measured else "0 lines measured"


def signals_line(pr, pr_error):
    """The Signals row: the PR's quality record, shown as a snapshot, so one recorded before HEAD's commit is flagged."""
    if pr_error:
        return f'{state("unknown", "need")} {esc(pr_error)}'
    if not pr:
        return state("no PR yet", "dim")
    found, why = quality_record(pr)
    if found is None:
        return why

    unknown = state("unknown", "dim")

    def count(value, words, warn=False):
        if type(value) is not int or value < 0:
            return f"{unknown} {words}"
        return state(f"{value} {words}", "need" if value else "ok") if warn else f"{value} {words}"

    recorded = f"recorded {unknown}"
    with contextlib.suppress(ValueError, TypeError):
        at = datetime.datetime.strptime(found.get("ts"), quality_log_cli.TS_FORMAT)
        recorded = f'recorded {esc(found["ts"])}'
        with contextlib.suppress(ValueError, RuntimeError, OSError):  # no age warning when git can't say
            if int(review_stamp.git("log", "-1", "--format=%ct", "HEAD")) > at.timestamp():
                recorded += f' · {state("recorded before the last commit", "need")}'
    verify = found.get("verify")
    verify_html = (state(verify, "ok" if verify == "pass" else "need")
                   if verify in {verdict for _, verdict in quality_log_cli.VERIFY_VERDICTS} | {"none"} else unknown)
    fresh = found.get("verify_current")
    current = (state("current when recorded", "ok") if fresh is True else state("stale when recorded", "need") if fresh is False
               else unknown)
    red = found.get("red_check")
    red_html = (state(red.replace("_", " "), {"failed": "need", "passed": "ok"}.get(red, "dim")) if red in {verdict for _, verdict in quality_log_cli.RED_CHECKS}
                else unknown)
    measured = coverage_words(found)
    coverage_html = unknown if measured is None else state(measured, "dim" if measured.startswith("0 lines") else "ok")
    tampered = found.get("tampered")
    tampered_html = (", ".join(count(tampered.get(kind), kind.replace("_", " "), warn=True)
                               for kind in quality_log_cli.TAMPER_KINDS) if isinstance(tampered, dict) else unknown)
    structure = found.get("structure")
    if isinstance(structure, dict):
        # Facts, not warnings: structure-facts sets no threshold, so neither tone nor "unknown" belongs here.
        complexity = quality_log_cli.structure_part(structure, "complexity")
        clones = quality_log_cli.structure_part(structure, "new_clones")
        partial = " (partial)"
        structure_html = (
            (f'complexity +{complexity["added"]} \u2212{complexity["removed"]} (largest +{complexity["max_function"]})'
             f'{"" if complexity["complete"] else partial}' if complexity else state("complexity not measured", "dim"))
            + " · " + (f'{clones["count"]} new clones{"" if clones["complete"] else partial}' if clones
                       else state("clones not measured", "dim")))
    else:
        structure_html = state("structure not measured", "dim")
    return (f'{recorded} · {count(found.get("added"), "lines added")}, {count(found.get("deleted"), "deleted")}, '
            f'{count(found.get("files"), "files")} · {count(found.get("test_files"), "test files touched")} · '
            f'{count(found.get("tests_deleted"), "test files deleted", warn=True)} · verify {verify_html}, {current} · '
            f'red check {red_html} · coverage {coverage_html} · weakened tests: {tampered_html} · {structure_html}')


# "Merge: …", "Merge with …", "Merge once …": not "Merge order: …", which is a decision of its own
MERGE_NOTE = r"\W*merge\b(?![*_ ]*\s+order\b)"
QUIET = ("phase off", "not needed")  # states that ask nothing of the reader


def stamp_tone(word):
    return "ok" if word == "current" else "dim" if word in QUIET else "need"


def stamp_state(kind, phase, off, needed=True):
    if phase in off:
        return "phase off"
    if not needed:
        return "not needed"
    if review_stamp.stamp_matches(kind, review_stamp.fingerprint_for(kind)):
        return "current"
    stamps = (review_stamp.stamp_path(kind), review_stamp.legacy_stamp_path(kind))
    return "stale" if any(os.path.exists(path) for path in stamps) else "missing"


def changed_files(base):
    """{top-level directory: [(path, added, removed)]} of the change against its base, the working tree's included."""
    counted = []
    for entry in review_stamp.git_checked("diff", "--numstat", "-z", "--no-renames", base).split(b"\0"):
        if entry:
            added, removed, path = os.fsdecode(entry).split("\t", 2)
            counted.append((path, added, removed))
    counted += [(path, "new", "0") for path in review_stamp.git_paths("ls-files", "--others", "--exclude-standard")]
    groups = {}
    for path, added, removed in counted:
        top = path.split("/", 1)[0] + "/" if "/" in path else "(top level)"
        groups.setdefault(top, []).append((path, added, removed))
    return groups


def section_table(text, title, columns):
    """[{column: cell}] of the first table under the `## <title>` heading, in any case as the stamp reads it, the columns
    lowercased, or None without one."""
    body, inside = [], False
    for line, fenced in outside_fences(text):
        level = not fenced and heading(line, 2)
        if level and level[0] == 2:
            if inside:
                break
            inside = level[1].lower() == title.lower()
        elif inside and not fenced:
            body.append(line)
    names, rows = None, []
    for line in body:
        cells = review_stamp.table_cells(line)
        if not cells:
            if names:
                break
            continue
        if TABLE_RULE.match(line):
            continue
        if names is None:
            names = [c.strip("*_ ").lower() for c in cells]
            continue
        rows.append({c: cells[names.index(c)] if c in names and names.index(c) < len(cells) else "" for c in columns})
    return rows if names else None


def output_lines(lines):
    """(steps, result lines, runner tests) of one output: its `precondition:`, `step:` and `note:` lines, its `PASS` and `FAIL`
    lines, and [(section, name, "ok" or "FAIL")] of a test runner's lines, which count only after a `== <section>` line."""
    steps, said, tests, section = [], [], [], None
    for line in lines:
        bare = line.strip()
        runner = re.match(r"(ok|FAIL) +(\S.*)", line.rstrip()) if section is not None else None
        if line.startswith("== "):
            section = line[3:].strip()
        elif runner:
            tests.append((section, runner.group(2), runner.group(1)))
        elif re.match(r"(precondition|step|note):\s*\S", bare):
            steps.append(bare)
        elif re.match(r"(PASS|FAIL)\b", bare):
            said.append(bare)
    return steps, said, tests


def note_items(text):
    """The decide section's top-level list items, each with its nested lines, or its paragraphs when it has no list."""
    items, paragraphs, para, after_item = [], [], [], False
    for line in text.split("\n") + [""]:
        item = re.match(r"([-*+]|\d+[.)])\s+(.*)$", line)
        if item:
            items.append(item.group(2).strip())
            after_item = True
        elif items and line.strip() and not heading(line) and (after_item or line.startswith((" ", "\t"))):  # a line right under an item continues it, indented or not
            items[-1] += "\n" + re.sub(r"^([-*+]|\d+[.)])\s+", "", line.strip())
        elif line.strip() and not heading(line):
            para.append(line.strip())
        elif para:
            paragraphs.append(" ".join(para))
            para = []
        after_item = after_item and bool(line.strip())
    return items or paragraphs


def level_two_sections(text):
    """{`## ` heading, lowercased: its body} of a report."""
    found, current = {}, None
    for line, fenced in outside_fences(text):
        title = not fenced and heading(line, 2)
        if title and title[0] == 2:
            current = title[1].strip().lower()
            found[current] = []
        elif current is not None:
            found[current].append(line)
    return {name: "\n".join(lines).strip() for name, lines in found.items()}


def lens_briefs():
    """({lens, lowercased: the sentence under its heading in the review's lenses.md, by its heading and by triage's
    name}, why it couldn't be read or None). A missing lenses.md gives no briefs and no why: the names show alone."""
    text, why = read_report(os.path.join(HERE, "..", "skills", "kit-review", "lenses.md"))
    briefs = {m.group(1).strip().lower(): m.group(2).strip() for m in re.finditer(r"^## (.+)\n\n(.+)$", text or "", re.M)}
    briefs.update({key: briefs[title.lower()] for key, title in triage.LENS_TITLES.items() if title.lower() in briefs})
    return briefs, None if why and why.startswith("no report") else why


def test_level(name):
    """The test level a Level cell or a Test types row names, from LEVELS, OTHER_LEVEL or NO_LEVEL."""
    name = name.strip("*_` \t").lower()
    if not name:
        return NO_LEVEL
    word = re.match(r"[a-z0-9-]+(?: budget)?", name)
    word = LEVEL_ALIASES.get(word.group(0), word.group(0)) if word else ""
    return next((level for level in LEVELS if word == level or name.startswith(level + " ") or
                 word.startswith(level + "-")), OTHER_LEVEL)


def notes_head(text):
    """(the `# ` title or None, the lead paragraph or None) of the notes: what stands before their first section."""
    before = []
    for line, fenced in outside_fences(text):
        title = not fenced and heading(line, 3)
        if title and (title[0] == 2 or title[1].lower() in NOTE_SECTIONS):
            break
        before.append(line)
    title = next((heading(line, 1)[1] for line in before if heading(line, 1)), None)
    return title, first_paragraph("\n".join(line for line in before if not heading(line, 1))) or None


def split_facts(text, labels):
    """({label: value}, the text without those lines): `Label: value` lines outside fences, an indented line continuing one."""
    by_name = {label.lower(): label for label in labels}
    pattern = re.compile(r"(?:[-*+] +)?[*_]*(" + "|".join(re.escape(label) for label in labels) + r")[*_]*:[*_]* *(.*)", re.I)
    facts, rest, current = {}, [], None
    for line, fenced in outside_fences(text):
        found = pattern.fullmatch(line.strip()) if not fenced else None
        if found:
            current = by_name[found.group(1).lower()]
            facts[current] = found.group(2).strip()
        elif current and not fenced and line.strip() and line.startswith((" ", "\t")):
            facts[current] += " " + line.strip()
        else:
            current = None
            rest.append(line)
    return facts, "\n".join(rest).strip()


def pull_subsections(text, names):
    """({name: its body}, the text without them): the `###` subsections the page places itself."""
    found, rest, current = {}, [], None
    for line, fenced in outside_fences(text):
        title = not fenced and heading(line, 3)
        if title:
            current = next((name for name in names if name.lower() == title[1].strip().lower()), None)
            if current:
                found[current] = []
                continue
        (found[current] if current else rest).append(line)
    return {name: "\n".join(lines).strip() for name, lines in found.items()}, "\n".join(rest).strip()


def labelled_parts(entry, labels):
    """(what comes first, {label: value}, the other parts) of an entry whose parts are separated by " — "."""
    head, *parts = entry.split(" — ")
    pattern = re.compile(r"[*_]*(" + "|".join(re.escape(label) for label in labels) + r")[*_]*:[*_]*\s*(.*)", re.I | re.S)
    by_name = {label.lower(): label for label in labels}
    fields, others = {}, []
    for part in parts:
        found = pattern.fullmatch(part.strip())
        if found:
            fields[by_name[found.group(1).lower()]] = found.group(2).strip()
        else:
            others.append(part)
    return head.strip(), fields, others


def is_blocking(raw):
    """Whether an item's own text marks it as blocking, however it wrote the mark: only a plain "no" says it doesn't."""
    return any(found.group(1).strip("*_ .") and not NOT_BLOCKING.match(found.group(1).strip("*_ ")) for found in BLOCKING_MARK.finditer(raw))


def impact_missing(fields, required):
    return any(not fields.get(name) for name in required)


def parse_decision(item):
    """{title, Options, Cost, Recommendation, Accepts, Blocking, extra} of one item of the notes' Decisions."""
    first, *rest = item.split("\n")
    pattern = re.compile(r"[*_]*(" + "|".join(DECISION_FIELDS) + r")[*_]*:[*_]*\s*(.*)", re.I)
    by_name = {field.lower(): field for field in DECISION_FIELDS}
    decision = {"title": first, "extra": [], "raw": item}
    for line in rest:
        found = pattern.fullmatch(line.strip())
        if found:
            decision[by_name[found.group(1).lower()]] = found.group(2).strip()
        else:
            decision["extra"].append(line)
    return decision


def not_proven_items(text):
    """Each gap the validation report records: (the gap, its impact fields, its raw text), with no fields for the old prose sections."""
    if text is None:
        return []
    sections = level_two_sections(text)
    items = []
    for raw in note_items(sections.get("not proven", "")):
        head, fields, others = labelled_parts(raw.replace("\n", " "), NOT_PROVEN_FIELDS)
        items.append((" — ".join([head] + others), fields, raw))
    old = [item for name, body in sections.items() if name.startswith(OLD_NOT_PROVEN) for item in note_items(body)]
    outside = "\n".join(line for line, fenced in outside_fences(text) if not fenced)
    old = [OLD_NOT_PROVEN_LINE.sub("", item, count=1).strip() for item in old]
    old += [entry for _, entry in pr_validation.labelled(OLD_NOT_PROVEN_LINE.sub(lambda found: found.group(1).capitalize() + ":", outside), OLD_NOT_PROVEN_LABELS)]
    return ([item for item in items if not SAYS_NONE.match(item[0])]
            + [(item, {}, item) for item in dict.fromkeys(old) if not SAYS_NONE.match(item) and not any(item in raw for _, _, raw in items)])


def guide_expected(text):
    """{guide step: its Expected text} of the checks guide."""
    found, step = {}, None
    for line, fenced in outside_fences(text):
        title = not fenced and heading(line)
        if title:
            name = re.match(review_stamp.GUIDE_STEP, title[1])
            step = name.group(1) if name else None
            continue
        expected = not fenced and step and step not in found and EXPECTED_LINE.match(line.strip())
        if expected:
            found[step] = expected.group(1).strip()
    return found


def planted_bugs(rows):
    """(killed, planted) from a mutation row's Result, or None: only a count the report states."""
    for row in rows:
        counted = KILLED_COUNT.search(row["detail"]) if row["level"] == "mutation" else None
        if counted and int(counted.group(1)) <= int(counted.group(2)):
            return int(counted.group(1)), int(counted.group(2))
    return None


NO_OUTPUT = "no output"


def evidence_freshness(page, row, merged_tree, scripts):
    """Whether a row's evidence covers the tree being merged: current, stale, unknown when an output doesn't say which commit
    it saw or the row names no evidence, or NO_OUTPUT when all it has is a screenshot or a video, which hold no commit."""
    words, media = set(), False
    for _, real in named_files(page, row):
        if real is None or not os.path.isfile(real) or os.path.dirname(real) == scripts:
            continue
        if real.lower().endswith(IMAGE_AND_VIDEO):
            media = True
            continue
        try:
            tree = review_stamp.evidence_tree(real)
        except OSError:
            tree = None
        words.add(None if not tree else "current" if tree == merged_tree else "stale")
    return (NO_OUTPUT if media else "unknown") if not words else "stale" if "stale" in words else "current" if words == {"current"} else "unknown"


def unread_results(lines):
    """(first cell, result) of each row whose result reads like a failure or a skip in words the stamp and the page don't count: left out, it would read as nothing wrong."""
    names = None
    for line in lines:
        cells = review_stamp.table_cells(line)
        if not cells:
            names = None
        elif {"Result", "Evidence"} <= {cell.strip("*_") for cell in cells}:
            names = [cell.strip("*_") for cell in cells]
        elif names and len(cells) > names.index("Result"):
            result = cells[names.index("Result")]
            if FAILURE_LIKE_RESULT.match(result) and not ANY_RESULT.match(result):
                yield cells[0], result


def verdict_of_change(stops, calls):
    """The word for the merge, by VERDICT_RULE: the reasons were sorted into stops and calls where they were found."""
    return "Not ready to merge" if stops else "Your call" if calls else "Ready to merge"


# Rendering

CASE_WORDS = {"+": "Checks that it works", "-": "Checks that it refuses", "−": "Checks that it refuses"}
RESULT_WORDS = {"PASS": "Passed", "FAIL": "FAIL", "NOT RUN": "NOT RUN"}


def not_recorded(kind, path):
    return (f'<p class="absent">{state("not recorded", "dim")} {esc(MAKERS[kind])} at <code>{esc(path)}</code></p>')


def unavailable(why):
    return f'<p class="absent">{state("unavailable", "need")} {esc(why)}</p>'


def level_id(level):
    return "level-" + ("not-recorded" if level == NO_LEVEL else re.sub(r"[^a-z0-9]+", "-", level).strip("-"))


def item_list(page, key, label, items, empty):
    """One of the summary's lists: (link, text, ...) items, each with a link to its details."""
    page.ids.add(key)
    return (f'<div class="list" id="{key}"><h2>{label} <span class="n">{len(items)}</span></h2>'
            f'<ol class="items" id="{key}-items">'
            + "".join(f'<li>{body} <a class="go" href="{esc(href)}">details</a></li>' for href, body, *_ in items)
            + "</ol>" + ("" if items else f"<p>{state(empty, 'ok')}</p>") + "</div>")


def sentence_list(parts):
    return parts[0] if len(parts) == 1 else ", ".join(parts[:-1]) + " and " + parts[-1]


def counted(n, word):
    return f"{n} {word}{'s' * (n != 1)}"


def not_recorded_word():
    return state("Not recorded", "dim")


def section(sid, eyebrow, title, body):
    """A section of the page. The id sits inside the disclosure: a link opens a closed <details> only through what it holds."""
    return (f'<details class="sec" open><summary><hgroup><p class="eyebrow">{esc(eyebrow)}</p><h2>{title}</h2></hgroup></summary>'
            f'<div class="body" id="{sid}">{body}</div></details>')


def fold(title, count, inner, opened=False, inner_id=None):
    """A long list behind its count."""
    anchor = f' id="{inner_id}"' if inner_id else ""
    return (f'<details class="more"{" open" if opened else ""}><summary><b>{esc(title)}</b> <span class="n">{count}</span> '
            f'<span class="hint"></span></summary><div class="inner"{anchor}>{inner}</div></details>')


def fact_list(page, facts, labels, judged=(), absent="Not recorded"):
    """A fact sheet: each label with what the notes say, or what's missing named. `judged` labels are the agent's judgment."""
    def label(name):
        return f'{esc(name)}<span class="judg">Agent&#x27;s judgment</span>' if name in judged else esc(name)

    def value(name):
        said = facts.get(name)
        return page.inline(said) if said else esc(absent(name) if callable(absent) else absent)
    return '<dl class="facts">' + "".join(f"<dt>{label(name)}</dt><dd>{value(name)}</dd>" for name in labels) + "</dl>"


def impact_cell(label, value):
    return f'<td data-l="{esc(label)}">{value}</td>'


def stack_table(headers, rows, table_id=""):
    anchor = f' id="{table_id}"' if table_id else ""
    return (f'<table class="grid-impact stack"{anchor}><thead><tr>' + "".join(f'<th scope="col">{esc(h)}</th>' for h in headers)
            + f'</tr></thead><tbody>{"".join(rows)}</tbody></table>')


def read_change(page, page_path, evidence, off, phases_error, paths, texts, whys):
    """Everything the change's page says, read once from the spec, the notes, the reports, git and GitHub."""
    c = SimpleNamespace(page=page, page_path=page_path, evidence=evidence, off=off, phases_error=phases_error,
                        paths=paths, texts=texts, whys=whys)
    c.spec_path, c.criteria, spec_why = review_stamp.spec_criteria()
    c.spec_text, c.spec_read_why = read_report(c.spec_path) if c.spec_path else (None, spec_why)
    c.spec_path = c.spec_path or "the spec"
    c.goal = re.search(r"^Goal:\s*(.+)$", c.spec_text or "", re.M)
    c.spec_title = re.search(r"^# (.+)$", c.spec_text or "", re.M)
    c.notes = notes_by_section(texts["decision-notes"]) if texts["decision-notes"] is not None else None
    c.notes_title, c.lead = notes_head(texts["decision-notes"]) if c.notes is not None else (None, None)
    c.ship_path = os.path.join(os.path.expanduser("~/.agents/repos"), review_stamp.repo_name(), "ship.md")
    c.ship_text, c.ship_why = read_report(c.ship_path)

    c.branch = review_stamp.git("branch", "--show-current")
    c.head = review_stamp.git("rev-parse", "--verify", "--quiet", "HEAD") or "no commit yet"
    c.tree = review_stamp.working_tree()
    c.base = review_stamp.merge_base()
    c.base_ref = review_stamp.branch_base()[0]
    c.pr, c.pr_error = pull_request()
    c.github = GITHUB_PR.fullmatch(c.pr.get("url") or "") if c.pr else None
    if c.github:
        page.repo_url, page.blob_sha = c.github.group(1), c.pr["headRefOid"]
    c.pr_link = (f'<a href="{esc(c.pr["url"])}"{REL}>#{c.pr["number"]}</a>' if c.github else f'#{c.pr["number"]}' if c.pr else "")
    page.local_roots.append(os.path.realpath(os.path.dirname(paths["review"])))
    c.ci_word, c.ci_tone, c.ci_detail = ci_state(c.pr, c.pr_error, off)
    c.validate_needed = any(not review_stamp.NOT_BEHAVIOR.search(p) for p in review_stamp.changed_paths()[1])
    c.stamps = {"review": stamp_state("review", "review", off),
                "validate": stamp_state("validate", "validate", off, c.validate_needed)}
    c.pr_tree = review_stamp.git("rev-parse", "--verify", "--quiet", f"{c.pr['headRefOid']}^{{tree}}") if c.pr else ""
    c.merged_tree = c.pr_tree or c.tree

    c.verify_word, c.verify_line = None, None
    if "verify" in off:
        c.verify_word, c.verify_line = "phase off", "phase off"
    elif texts["verify"] is not None:
        verdict = re.search(r"^# Verify: (.+)$", texts["verify"], re.M)
        words = verdict.group(1).strip().rstrip(".,") if verdict else ""
        if words:
            c.verify_word = "checked nothing" if words.startswith("PASS, but nothing") else words.split()[0].rstrip(",")
            c.verify_line = pr_validation.verify_line(texts["verify"])[0][len("- Verify: "):]
        else:
            whys["verify"] = f"{paths['verify']} has no `# Verify:` verdict"

    c.review = None
    if "review" not in off and texts["review"] is not None:
        c.review = parse_review(texts["review"])
        if c.review is None:
            whys["review"] = f"{paths['review']} has no Review line and no Fixed, Rejected, Pre-existing, Open or Not run entry"
    c.entries = c.review[2] if c.review else []

    c.rows = []
    if "validate" not in off and texts["validation"] is not None:
        c.rows = check_rows(texts["validation"])
        if not c.rows:
            whys["validation"] = f"{paths['validation']} has no PASS, FAIL or NOT RUN row in a table with Result and Evidence columns"
    c.validation_ok = "validate" not in off and texts["validation"] is not None and bool(c.rows)
    c.pre_pr_a = c.validation_ok and all(row["expected"] is None for row in c.rows)
    test_types = (section_table(texts["validation"], "Test types", ("type", "ran", "evidence")) or []) if c.validation_ok else []
    c.not_run_types = {}  # a level the Test types table marks not run: its row, said once with the checks it holds
    type_of = {}  # a check id a Test types row's Evidence names: that row's level, the first row winning
    for t in test_types:
        if re.sub(r"[\s*_`]", "", t["ran"]).lower() == "no":
            c.not_run_types.setdefault(test_level(t["type"]), t)
        if t["type"].strip():
            for word in re.findall(r"[A-Za-z0-9_.-]+", t["evidence"]):
                type_of.setdefault(word.strip(".-"), test_level(t["type"]))
    c.rows_at = {}
    for row in c.rows:
        row["anchor"] = page.new_id(f"check-{row['id']}")
        row["level"] = test_level(row["level"] or "")
        if row["level"] == NO_LEVEL:
            row["level"] = type_of.get(row["id"], NO_LEVEL)
        c.rows_at.setdefault(row["level"], []).append(row)
    c.freshness_unread = None
    try:
        c.stale_problems, c.stale_warnings = (review_stamp.stale_evidence(texts["validation"].split("\n"), evidence)
                                              if c.validation_ok else ([], []))
    except OSError as error:  # one unreadable output hides the others' staleness too, so the verdict can't say Ready
        c.stale_problems, c.stale_warnings = [], []
        c.freshness_unread = f"{os.path.basename(error.filename or 'an output')}: {error.strerror or error}"
    c.counts = {result: sum(row["result"] == result for row in c.rows) for result in RESULTS}
    c.guide = (review_stamp.guide_steps(texts["checks-guide"]) if "validate" not in off and texts["checks-guide"] is not None else {})
    c.environment = os.path.join(evidence, review_stamp.ENVIRONMENT_RECORD)
    c.named_in = {}  # the criteria each test is named in, by a spec `verify:` that names it in backticks
    for item in c.criteria or []:
        number, verify = re.match(r"(\d{1,6})\.", item), item.partition("verify:")[2]
        for name in re.findall(r"`([^`\n]+)`", verify) if number else ():
            c.named_in.setdefault(name.strip(), []).append(int(number.group(1)))
    c.ac_known = c.validation_ok and any(row["ac_column"] for row in c.rows)
    c.criteria_numbers = [(int(found.group(1)), found.group(2)) for found in (re.match(r"(\d{1,6})\.\s*(.*)", item) for item in c.criteria or []) if found]
    c.uncovered = [n for n, _ in c.criteria_numbers if c.ac_known and not any(n in row["acs"] for row in c.rows)]
    c.not_proven = not_proven_items(texts["validation"]) if c.validation_ok else []
    c.open_items = [(n, *labelled_parts(entry, OPEN_FIELDS), entry) for n, (_, _, entry) in
                    enumerate((e for e in c.entries if e[0] == "Open"), 1)]
    c.lenses = section_table(texts["review"], "Lenses", ("lens", "model", "findings", "confirmed", "outcomes")) if c.review else None
    c.failed_lenses = [lens for lens in c.lenses or [] if not LENS_COUNT.fullmatch(lens["findings"].strip())]
    c.failed_reviewers = [entry for outcome, _, entry in c.entries
                          if outcome == "Not run" and REVIEWER_FAILED.search(entry) and not SAYS_NONE.match(entry) and not SWITCHED_OFF.search(entry)]
    c.unread_results = list(unread_results(texts["validation"].split("\n"))) if c.validation_ok else []
    c.briefs, c.briefs_why = lens_briefs()
    notes = c.notes or {}
    c.problem_facts, c.problem_text = split_facts(notes.get("problem") or "", PROBLEM_FACTS)
    c.solution_facts, solution_text = split_facts(notes.get("solution") or "", SOLUTION_FACTS)
    c.placed, c.solution_text = pull_subsections(solution_text, (ARCHITECTURE_MAP, REGRESSIONS))
    legacy = note_items(notes.get("decide") or "")  # only here is a "Merge…" item the recommendation: under Decisions it is a decision
    c.merge_note = next((item for item in legacy if re.match(MERGE_NOTE, item, re.I)), None)
    c.decisions = [parse_decision(item) for item in note_items(notes.get("decisions") or "") + legacy
                   if item is not c.merge_note and not SAYS_NONE.match(item) and not NO_DECISIONS.match(item)]
    return c


def source_state(c, kind, phase):
    """The state word for a source report: phase off, or unavailable with the reason, or None when it was read."""
    if phase in c.off:
        return "phase off"
    if kind == "validation" and not c.validate_needed and c.texts["validation"] is None:
        return "not needed"
    if kind == "verify" and c.verify_word is None or kind == "review" and c.review is None or kind == "validation" and not c.validation_ok:
        return "unavailable: " + c.whys[kind]
    return None


def source_html(c, kind, phase):
    why = source_state(c, kind, phase)
    return state(why.split(": ")[0], "dim") if why in QUIET else f'{state("unavailable", "need")} {esc(why[len("unavailable: "):])}'


# The problem and the solution

def agent_prose(page, text, prefix):
    return f'<p class="by">Written by the agent</p>{page.markdown(text, prefix, top=4, figures=True)}' if text else ""


def problem_section(c):
    page, notes = c.page, c.notes or {}
    prose = "\n\n".join(part for part in (c.problem_text, notes.get("task")) if part)
    if prose:
        story = agent_prose(page, prose, "problem")
    elif c.goal:
        story = f'<p>{page.inline(c.goal.group(1))}</p><p class="by">The spec&#x27;s goal</p>'
    else:
        story = f"<p>{not_recorded_word()}</p>"
    background = page.inline(c.problem_facts["Background"]) if c.problem_facts.get("Background") else not_recorded_word()
    body = (f'<h3>Some background first</h3><p>{background}</p><h3>What went wrong</h3>{story}'
            + fact_list(page, c.problem_facts, ("Who it hits", "What they see", "How bad", "How often", "If we wait"), ("How bad", "How often"),
                        lambda name: "No deadline recorded" if name == "If we wait" else "Not recorded"))
    title = page.inline(c.problem_facts["Headline"], links=False) if c.problem_facts.get("Headline") else "The problem"
    return section("problem", "The problem", title, body)


def regression_table(page, text):
    """The notes' table of where a regression could show up, each row the agent's judgment."""
    table = [cells for cells in (review_stamp.table_cells(line) for line in text.split("\n")) if cells]
    rules = [line for line in text.split("\n") if TABLE_RULE.match(line)]
    if len(table) < 2 or not rules:
        return f"<p>{not_recorded_word()}</p>" if not text else page.markdown(text, "regressions", top=4)
    names = [cell.strip("*_ ").lower() for cell in table[0]]
    rows = [cells for cells in table[1:] if not TABLE_RULE.match("|".join(cells)) and not all(TABLE_RULE.match(cell) for cell in cells)]

    def cell(cells, column):
        at = names.index(column) if column in names else None
        return cells[at] if at is not None and at < len(cells) else ""

    def checked(cells):
        said = cell(cells, "what checked it").strip()
        return page.inline(said) if said else '<span class="need">Not checked</span>'
    body = "".join("<tr>" + impact_cell("What could break", page.inline(cell(cells, "system")))
                   + impact_cell("Why it could", page.inline(cell(cells, "why it could regress")))
                   + impact_cell("What checked it", checked(cells)) + "</tr>" for cells in rows)
    return ('<p class="src">Agent&#x27;s judgment, from the spec&#x27;s change map and a search of the code.</p>'
            + stack_table(("What could break", "Why it could", "What checked it"), [body], "regressions"))


def solution_section(c):
    page, notes = c.page, c.notes or {}
    prose = "\n\n".join(part for part in (c.solution_text, notes.get("change")) if part)
    para = first_paragraph(c.texts["pr-body"]) if c.texts["pr-body"] else None
    if prose:
        story = agent_prose(page, prose, "solution")
    elif para:
        story = f'<p>{page.inline(para)}</p><p class="by">The PR description&#x27;s first paragraph</p>'
    else:
        story = f"<p>{not_recorded_word()}</p>"
    example = "" if re.search(r"^#+\s*worked example\s*$", prose, re.I | re.M) else f"<h3>Worked example</h3><p>{not_recorded_word()}</p>"
    experience = (f'<h3>Your experience</h3>{page.markdown(notes["users"], "users", top=4)}' if notes.get("users") else "")
    drawn = c.placed.get(ARCHITECTURE_MAP)
    if drawn:
        lines = drawn.split("\n")
        images = [(n, found) for n, found in ((n, FIGURE_LINE.fullmatch(line.strip())) for n, line in enumerate(lines)) if found]
        taken = {at for at, _ in images}
        rest = "\n".join(line for n, line in enumerate(lines) if n not in taken)
        figure = "".join(page.figure(found.group(1), found.group(2), "fig mapfig") for _, found in images)
        arch = (page.markdown(rest, "map", top=4) + figure
                + '<ul class="legend"><li><i class="c"></i>Changed</li><li><i class="a"></i>Could be affected</li><li><i></i>Not touched</li></ul>')
    else:
        arch = f"<p>{not_recorded_word()}</p>"
    regressions = c.placed.get(REGRESSIONS) or ""
    body = (f"<h3>How it works</h3>{story}{example}{experience}"
            f'<h3>Architecture map</h3>{arch}<h3>Where a regression could show up</h3>{regression_table(page, regressions)}'
            + fact_list(page, c.solution_facts, ("For you", "Time added", "Connects to", "If it fails", "To undo", "Rejected")).replace(
                '<dl class="facts">', '<dl class="facts" id="undo">', 1))
    title = page.inline(c.solution_facts["Headline"], links=False) if c.solution_facts.get("Headline") else "The solution"
    return section("fix", "The solution", title, body)


# Testing

def check_blocks(c):
    """Each check's disclosure, evidence inside it: shown in full even when an earlier check, or the notes, showed the same file."""
    page, scripts = c.page, os.path.join(c.page.root, "checks")
    c.missing_files = {}
    videos = review_stamp.usable_videos(c.evidence)
    c.without_video = [row for row in c.rows if row["result"] in ("PASS", "FAIL")
                       and not review_stamp.names_a_file(row["observed"], videos)]  # as the validate stamp reads them
    unfilmed = {row["anchor"] for row in c.without_video}

    def test_rows(at):
        return "".join(f'<tr><td><code>{esc(name)}</code></td><td>{state(result, "need" if result == "FAIL" else "ok")}</td>'
                       f'<td>{", ".join(f"AC{n}" for n in c.named_in.get(name, []))}</td></tr>' for name, result in at)

    def test_table(label, at):
        return (f'<div class="table" tabindex="0" role="region" aria-label="Table: {esc(label)}">'
                '<table><thead><tr><th scope="col">Test</th><th scope="col">Result</th><th scope="col">Named in</th></tr></thead>'
                f"<tbody>{test_rows(at)}</tbody></table></div>")

    outputs = {}  # realpath of a text output: its (steps, result lines, runner tests), and the row that lists its tests
    for row in c.rows:
        blocks, steps, said, tests, partial, listed_in, unread = [], [], [], [], False, [], False
        row["fresh"] = evidence_freshness(page, row, c.merged_tree, scripts)
        for named, real in named_files(page, row):
            why_unread = ("is outside the evidence directory" if real is None else "is missing" if not os.path.exists(real)
                          else "is not a file" if not os.path.isfile(real) else "can't be read" if not os.access(real, os.R_OK) else None)
            if why_unread:
                c.missing_files.setdefault(row["anchor"], []).append((os.path.basename(named), why_unread))
            blocks.append((real, page.file_block(named, real, again=True)))
            unread = unread or real in page.past
            if real in page.lines and os.path.dirname(real) != scripts:
                if real not in outputs:
                    outputs[real] = (output_lines(page.lines[real]), row)
                (found_steps, found_said, found_tests), owner = outputs[real]
                steps, said = steps + found_steps, said + found_said
                if owner is row and found_tests and not any(t is found_tests[0] for t in tests):
                    tests, partial = tests + found_tests, partial or real in page.cut
                elif found_tests and owner is not row:
                    listed_in.append(owner)  # a suite output several checks cite counts its tests once, at its first
        blocks = log_and_video_tabs(page, row, blocks, scripts)
        row["tests"] = (len(tests), sum(result == "FAIL" for _, _, result in tests), partial)
        fits = page.charge(*steps, *said, *(section + name for section, name, _ in tests))
        if not fits:
            steps, said, tests = [], [], []
        over = not fits or unread
        runner = "".join(f'<span class="said">runner tests listed under <a href="#{other["anchor"]}"><code>{esc(other["id"])}</code></a></span>'
                         for other in {id(other): other for other in listed_in}.values())
        if tests:
            by_section = {}
            for name_section, name, result in tests:
                by_section.setdefault(name_section, []).append((name, result))
            failed = [(name, result) for _, name, result in tests if result == "FAIL"]
            named = [(name, result) for _, name, result in tests if name in c.named_in]
            # shown again above the full list: the failed and named tests, and each section's name twice more
            if not page.charge(*(name for name, _ in failed + named), *(2 * name_section for name_section in by_section)):
                failed, named = [], []
            runner += (f'<details class="runner"><summary>{len(tests)} tests from the runner · {row["tests"][1]} FAIL · criteria '
                       f'{esc(row["ac"]) or "none"}' + (" · partial: the log's middle was cut" if partial else "") + "</summary>"
                       '<div class="table" tabindex="0" role="region" aria-label="Table: tests by section"><table><thead><tr>'
                       '<th scope="col">Section</th><th scope="col">Tests</th><th scope="col">FAIL</th></tr></thead><tbody>'
                       + "".join(f'<tr><td><code>{esc(name_section)}</code></td><td>{len(at)}</td><td>'
                                 + (state(str(n), "need") if (n := sum(r == "FAIL" for _, r in at)) else "0") + "</td></tr>"
                                 for name_section, at in by_section.items()) + "</tbody></table></div>"
                       + (f'<p class="runner-h">Failures</p>{test_table("failed tests", failed)}' if failed else "")
                       + (f'<p class="runner-h">Named in the spec</p>{test_table("tests the spec names", named)}' if named else "")
                       + f'<details class="earlier"><summary>All {len(tests)} tests, by section</summary>'
                       + "".join(f'<p class="runner-h">{esc(name_section)}</p>{test_table(f"tests in {name_section}", at)}'
                                 for name_section, at in by_section.items())
                       + "</details></details>")
        acs = " ".join(f'<a class="ac" href="#ac-{n}">AC{n}</a>' for n in row["acs"]) or (esc(row["ac"]) or state("no AC", "dim"))
        kind = CASE_WORDS.get(row["case"].strip("*_ "), row["case"])
        meta = " · ".join(part for part in (esc(kind), f"proves {acs}", f"evidence {row['fresh']}",
                                            state("no video", "need") if row["anchor"] in unfilmed else "") if part)
        outcome = RESULT_WORDS.get(row["result"], row["result"])
        expected = page.inline(row["expected"]) if row["expected"] and row["expected"].strip() else not_recorded_word()
        observed = page.inline(row["observed"])
        actual = page.inline(row["detail"]) if row["detail"] else {"PASS": "As expected.", "NOT RUN": "Did not run."}.get(row["result"]) or ("" if observed else not_recorded_word())
        steps_html = ("<ol>" + "".join(f"<li>{esc(step)}</li>" for step in steps) + "</ol>" if steps else
                      state("linked", "dim") + " past the 20 MB embedded in total: the steps and results are in the evidence below"
                      if over else not_recorded_word())
        row["block"] = (
            f'<details class="check"{"" if row["result"] == "PASS" else " open"}><summary>'
            f'<span class="cid">{esc(row["id"])}</span><h4>{page.inline(row["check"], links=False) or esc(row["id"])}</h4>'
            f'<span class="chip">{esc(LAYER_NAMES[row["level"]])}</span>'
            f'<span class="res {result_tone(row["result"]) if row["result"] != "PASS" else "ok"}">{esc(outcome)}</span></summary>'
            f'<div class="inner" id="{row["anchor"]}"><p class="meta">{meta}</p><dl>'
            f'<dt>Steps</dt><dd>{steps_html}</dd><dt>Expected</dt><dd>{expected}</dd>'
            f'<dt>Actual</dt><dd>{actual}' + (f" {observed}" if observed else "")
            + "".join(f'<span class="said">{esc(line)}</span>' for line in said) + runner
            + f'</dd><dt>Source</dt><dd>{page.path(c.paths["validation"], c.paths["validation"] + ":" + str(row["line"]))}</dd></dl>'
            f'{"".join(blocks) or state("no evidence named", "dim")}</div></details>')


def log_and_video_tabs(page, row, blocks, scripts):
    """The check's evidence blocks, with a log and a playable video of the same stem as Video and Log tabs where the
    first of the two stood; the Log tab is selected unless the check passed. A video bin/evidence-video --replay made,
    which leaves <stem>.replay beside it, is labeled as a replay of the log, read on every build."""
    def kind(real):
        if real is None or not os.path.isfile(real) or os.path.dirname(real) == scripts:
            return None
        ext = os.path.splitext(real)[1].lower()
        return "log" if ext == ".txt" else "video" if ext in PLAYABLE else None

    by_stem = {}
    for real, html in blocks:
        if kind(real):
            by_stem.setdefault(os.path.splitext(real)[0], {}).setdefault(kind(real), html)
    pairs = {stem: found for stem, found in by_stem.items() if len(found) == 2}
    shown, out = set(), []
    for real, html in blocks:
        stem = real and os.path.splitext(real)[0]
        if stem not in pairs or html not in pairs[stem].values():
            out.append(html)
            continue
        if stem in shown:
            continue
        shown.add(stem)
        name = page.new_id(f"tabs-{row['id']}")
        log_first = row["result"] != "PASS"
        replay = os.path.isfile(stem + ".replay")
        labels = {"video": "Replay of the log" if replay else "Video", "log": "Log"}
        radios = "".join(f'<input type="radio" class="t-{tab}" name="{name}" id="{tab_id}"{" checked" if on else ""}>'
                         f'<label for="{tab_id}">{labels[tab]}</label>'
                         for tab, on in (("video", not log_first), ("log", log_first)) if (tab_id := page.new_id(f"{name}-{tab}")))
        caption = (f'<p class="meta">A replay of {esc(os.path.basename(stem))}.txt, recorded after the check ran in full: '
                   "not a live recording.</p>" if replay else "")
        out.append(f'<fieldset class="tabs"><legend class="vh">Evidence of {esc(row["id"])}: the {"replay" if replay else "video"} '
                   f'and the log of {esc(os.path.basename(stem))}</legend>'
                   f'{radios}<div class="pane p-video">{caption}{pairs[stem]["video"]}</div><div class="pane p-log">{pairs[stem]["log"]}</div></fieldset>')
    return out


def freshness_sentence(c):
    """Whether the evidence covers the commit being merged, read from the outputs' own headers."""
    commit = (c.pr["headRefOid"] if c.pr else c.head)[:7]
    words = [row["fresh"] for row in c.rows]
    tally = f'{c.counts["FAIL"]} failed and {c.counts["NOT RUN"]} did not run.'
    if "stale" in words:
        return (f'<p id="freshness"><strong class="need">This evidence is stale.</strong> '
                f'{words.count("stale")} of {counted(len(words), "check")} ran on another commit than <code>{esc(commit)}</code>, the one you would merge. {tally}</p>')
    if not set(words) & {"current", NO_OUTPUT} or any(row["fresh"] == "unknown" and row["result"] in ("PASS", "FAIL") for row in c.rows):
        return (f'<p id="freshness"><strong class="dim">Whether this evidence covers <code>{esc(commit)}</code> is unknown:</strong> '
                f"at least one output doesn&#x27;t say which commit it ran on, so the page can&#x27;t tell. {tally}</p>")
    media = counted(words.count(NO_OUTPUT), "check")
    if "current" not in words:
        return (f'<p id="freshness">No output here names a commit: every check has only a screenshot or video, which can&#x27;t show that it covers <code>{esc(commit)}</code>. {tally}</p>')
    return (f'<p id="freshness">Every output covers commit <code>{esc(commit)}</code>, the one you would merge.'
            + (f" {media} {'has' if words.count(NO_OUTPUT) == 1 else 'have'} only a screenshot or video, which can&#x27;t name a commit." if NO_OUTPUT in words else "") + f" {tally}</p>")


def layers_table(c):
    def chips(level):
        at = c.rows_at.get(level, [])
        steps = {step: info for step, info in c.guide.items() if step not in SETUP_STEPS} if level == "manual" else {}
        todo = [step for step, info in steps.items() if info["result"] != "PASS"]
        passed = [step for step in steps if step not in todo]
        shown = "".join(f'<a class="chip" href="#{row["anchor"]}">{esc(row["id"])}</a> ' for row in at)
        shown += "".join(f'<a class="chip" href="#todo-{esc(step)}">{esc(step)}</a> ' for step in passed)
        shown += "".join(f'<a class="chip todo" href="#todo-{esc(step)}">{esc(step)}</a> ' for step in todo)
        ran, ran_failed = sum(row["tests"][0] for row in at), sum(row["tests"][1] for row in at)
        runner = (f' <span class="meta">({counted(ran, "test")} in the runner output' + (f", {ran_failed} FAIL" if ran_failed else "") + ")</span>") if ran else ""
        skipped = c.not_run_types.get(level)
        all_skipped = skipped and at and all(row["result"] == "NOT RUN" for row in at)
        said = ""
        if skipped:
            reason = c.page.inline(skipped["evidence"]) or state("no reason recorded", "need")
            said = f'<p>{esc(skipped["type"])} not run' + (f" ({counted(len(at), 'check')})" if all_skipped else "") + f": {reason}</p>"
        if not at and not steps:
            return said or '<span class="none">None in this change</span>'
        return said + f'<span class="count">{len(at) + len(passed)}</span> {shown}' + ('<span class="meta">to do</span>' if todo else "") + runner
    known = list(ALWAYS_LAYERS) + [level for level in LEVELS + (OTHER_LEVEL, NO_LEVEL)
                                   if (level in c.rows_at or level in c.not_run_types) and level not in ALWAYS_LAYERS]
    return ('<h3>Which layer each test belongs to</h3><table class="layers"><thead><tr><th scope="col">Layer</th><th scope="col">What it proves</th>'
            '<th scope="col">Tests</th></tr></thead><tbody>'
            + "".join(f'<tr><th scope="row"><span class="layername">{esc(LAYER_NAMES[level])}</span></th><td>{esc(LAYER_MEANS[level])}</td><td>{chips(level)}</td></tr>'
                      for level in known) + "</tbody></table>")


def automated_part(c):
    page = c.page
    automated = [row for row in c.rows if row["level"] in AUTOMATED_LEVELS]
    checks_run = esc(re.sub(r"^(?:PASS|FAIL)\b,? *", "", c.verify_line or "")) if c.verify_word in ("PASS", "FAIL") else esc(c.verify_line or "")
    if c.verify_word == "PASS":
        here = f"Passed. {checks_run}"
    elif c.verify_word == "phase off":
        here = state("phase off", "dim")
    elif c.verify_word:
        here = f'{state(RESULT_WORDS.get(c.verify_word, c.verify_word), "need")} {checks_run}'
    else:
        here = "Not recorded"
    ci = {"PASS": "Passed.", "FAIL": "Failed.", "pending": "Still running.", "missing": "No checks yet.", "no CI": "This repository runs no CI.",
          "CI phase off": "Switched off.", "no PR yet": "No PR yet, so no CI."}.get(c.ci_word, esc(c.ci_word))
    planted = planted_bugs(c.rows)
    if planted:
        killed, total = planted
        shown = min(total, MAX_DOTS)
        dots = (f'<ul class="dots" role="img" aria-label="{killed} of {total} planted bugs caught">'
                + "".join(f'<li{"" if n < killed else " class=miss"}></li>' for n in range(shown)) + "</ul>")
        bugs = f"{killed} of {total} caught.{dots}"
    else:
        bugs = "Not measured"
    measured = coverage_words(quality_record(c.pr)[0]) if c.pr else None
    has_problem = any(row["result"] != "PASS" for row in automated)
    return ('<div id="automated"><h3>Automated tests</h3><dl class="facts">'
            f"<dt>On this machine</dt><dd>{here}</dd><dt>In CI</dt><dd>{ci}</dd><dt>Planted bugs</dt><dd>{bugs}</dd>"
            f'<dt>Coverage</dt><dd>{esc(measured) if measured else "Not measured"}</dd></dl>'
            + (fold("Evidence of the automated tests", len(automated), "".join(row["block"] for row in automated),
                    opened=has_problem) if automated else "") + "</div>")


def manual_part(c):
    groups = [level for level in LEVELS + (OTHER_LEVEL, NO_LEVEL) if level not in AUTOMATED_LEVELS and level in c.rows_at]
    manual = sum(len(c.rows_at[level]) for level in groups)
    passed = sum(row["result"] == "PASS" for level in groups for row in c.rows_at[level])
    not_run = sum(row["result"] == "NOT RUN" for level in groups for row in c.rows_at[level])
    ran = manual - not_run
    skipped = f" {not_run} did not run." if not_run else ""
    lead = (f"<p>The agent ran {counted(ran, 'test')} against the real behaviour; {passed} passed.{skipped}</p>" if manual
            else "<p>The agent ran no test against the real behaviour.</p>")
    return ('<div id="manual"><h3>Tests the agent ran for real</h3>' + lead
            + "".join(f'<h4 id="{c.page.new_id(level_id(level))}">{esc(LAYER_NAMES[level])} <span class="n">{len(c.rows_at[level])}</span></h4>'
                      + "".join(row["block"] for row in c.rows_at[level]) for level in groups) + "</div>")


def todo_part(c):
    expected = guide_expected(c.texts["checks-guide"]) if c.guide else {}
    steps = [(step, info) for step, info in c.guide.items() if step not in SETUP_STEPS and info["result"] != "PASS"]
    done = [(step, info) for step, info in c.guide.items() if step not in SETUP_STEPS and info["result"] == "PASS"]

    def when(step):
        return "after the merge" if step.startswith("P") else "before the merge"

    def step_html(step, info):
        result = f' {state(info["result"], "need")}{esc(info["date"])}' if info["result"] else ""
        return (f'<div class="todo-step"><h4 id="todo-{esc(step)}"><span class="cid">{esc(step)}</span> {esc(info["name"])} '
                f'<span class="chip todo">By hand · to do</span>{result}</h4>'
                f'<p class="meta"><span class="owner">{esc(info["owner"])}</span> · {when(step)}</p>'
                f'<p>{c.page.inline(expected[step]) if expected.get(step) else not_recorded_word()}</p></div>')
    if "validate" in c.off:
        inner = f'<p>{state("phase off", "dim")}</p>'
    elif c.texts["checks-guide"] is None:
        inner = (f'<p class="absent">{state("not recorded", "dim")} the checks guide</p>' if c.whys["checks-guide"].startswith("no report")
                 else unavailable(c.whys["checks-guide"]))
    elif not steps:
        inner = "<p>Nothing left to do by hand.</p>"
    else:
        inner = "".join(step_html(*step) for step in steps)
    inner += "".join(f'<p class="src" id="todo-{esc(step)}"><span class="cid">{esc(step)}</span> {esc(info["name"])}: already passed{esc(info["date"])}.</p>' for step, info in done)
    return f'<h3 id="todo">Tests still to do</h3>{inner}'


def coverage_matrix(c):
    """Each criterion against what proves it, by the kind of proof; a gap shows as a gap."""
    page = c.page
    if c.spec_text is None:
        return not_recorded("spec", c.spec_path) if not c.spec_read_why or c.spec_read_why.startswith("no report") else unavailable(c.spec_read_why)
    if not c.criteria_numbers:
        return f"<p>{state('not recorded', 'dim')} no numbered acceptance criteria</p>"

    def chips(rows):
        return " ".join(f'<a class="chip" href="#{row["anchor"]}">{esc(row["id"])} {state(row["result"], result_tone(row["result"]))}</a>'
                        for row in rows) or '<span class="none">None</span>'
    rows_html = []
    for n, words in c.criteria_numbers:
        first, rest = first_sentence(words)
        how = "how it&#x27;s checked" if rest.startswith("— verify:") else "the rest"
        promise = page.inline(first) + (f'<details class="crit"><summary>{how}</summary><p>{page.inline(rest)}</p></details>' if rest else "")
        covering = [row for row in c.rows if n in row["acs"]]
        if not c.validation_ok:
            why = (source_state(c, "validation", "validate") or "not recorded").split(":")[0]
            proof = f'<td colspan="3" data-l="Proof">{state(why, "dim" if why in QUIET else "need")}</td>'
        elif not c.ac_known:
            proof = f'<td colspan="3" data-l="Proof">{state("Not recorded", "dim")} the validation tables have no AC column</td>'
        elif not covering:
            proof = '<td colspan="3" data-l="Proof" class="need">No check</td>'
        else:
            proof = (impact_cell("Run for real", chips([row for row in covering if row["level"] not in AUTOMATED_LEVELS]))
                     + impact_cell("Test suite", chips([row for row in covering if row["level"] in AUTOMATED_LEVELS and row["level"] != "mutation"]))
                     + impact_cell("Bugs planted", chips([row for row in covering if row["level"] == "mutation"])))
        rows_html.append(f'<tr id="ac-{n}"><th scope="row">AC{n}</th>{impact_cell("Promise", promise)}{proof}</tr>')
    table = ('<table class="grid-impact stack matrix"><thead><tr><th scope="col">Criterion</th><th scope="col">Promise</th><th scope="col">Run for real</th>'
             f'<th scope="col">Test suite</th><th scope="col">Bugs planted</th></tr></thead><tbody>{"".join(rows_html)}</tbody></table>')
    return fold("What had to be true, and what proves it", len(rows_html), table, opened=bool(c.uncovered) or not c.ac_known)


def testing_section(c):
    page = c.page
    if c.validation_ok:
        freshness = freshness_sentence(c)
    else:
        freshness = f'<p id="freshness">{source_html(c, "validation", "validate")}. Whether any evidence covers this commit is unknown.</p>'
    fresh = [(page.new_id("fresh"), "stale", problem) for problem in c.stale_problems] + \
            [(page.new_id("fresh"), "freshness warning", warning) for warning in c.stale_warnings]
    fresh_list = ('<ul class="fresh">' + "".join(f'<li id="{anchor}">{state(word, "need")} {esc(message)}</li>' for anchor, word, message in fresh)
                  + "</ul>") if fresh else ""
    if os.path.isfile(c.environment):
        environment = fold("Where these ran", 1, page.file_block(*page.resolve(c.environment), again=True), inner_id="environment")
    elif c.validation_ok:
        environment = (f'<p class="absent" id="environment"><span class="k">Environment:</span> '
                       f'{state("not recorded", "dim") if c.pre_pr_a else state("missing", "need")} <code>{esc(c.environment)}</code></p>')
    else:
        environment = ""
    return section("testing", "Testing", "What was tested, and what wasn&#x27;t",
                   freshness + fresh_list + layers_table(c) + automated_part(c) + manual_part(c) + todo_part(c) + coverage_matrix(c) + environment)


# Review

def bar(width, *parts):
    return f'<div class="fbar" style="--w:{width:.1f}%">' + "".join(f'<span class="{kind}" style="width:{share:.1f}%"></span>' for kind, share in parts) + "</div>"


def review_funnel(c):
    numbers = [lens for lens in c.lenses or [] if lens not in c.failed_lenses]
    raised = sum(int(lens["findings"]) for lens in numbers) if numbers else None
    confirmed = sum(int(lens["confirmed"]) for lens in numbers) if numbers and all(LENS_COUNT.fullmatch(lens["confirmed"].strip()) for lens in numbers) else None
    tally = {outcome: sum(e[0] == outcome for e in c.entries) for outcome in REVIEW_OUTCOMES}
    lines = sum(tally[outcome] for outcome in REVIEW_OUTCOMES if outcome != "Not run")
    scale = max(raised or 0, confirmed or 0, lines, 1)
    width = lambda n: n * 100 / scale  # noqa: E731
    fixed, others = tally["Fixed"], tally["Rejected"] + tally["Pre-existing"]
    rows = [(raised, "findings raised", bar(width(raised or 0), ("c-raised", 100))),
            (confirmed, "held up when checked against the code", bar(width(confirmed or 0), ("c-raised", 100))),
            (lines, "lines in the report, which groups related findings and small ones",
             bar(width(lines), *((kind, n * 100 / lines) for kind, n in (("c-ok", fixed), ("c-dim", others), ("c-need", tally["Open"])) if lines and n)))]
    funnel = '<div class="funnel">' + "".join(
        f'<div class="frow"><p><strong>{n if n is not None else "Not recorded"}</strong> {words}</p>{drawn}</div>' for n, words, drawn in rows) + "</div>"
    explained = []
    if raised is not None and confirmed is not None and raised != confirmed:
        explained.append(f"{raised - confirmed} of the findings raised were not confirmed when checked.")
    if confirmed is not None and confirmed != lines:
        explained.append("The report&#x27;s lines differ from the confirmed count because it groups related findings and small ones.")
    if c.lenses is None:
        explained.append("The report has no Lenses table, so per-lens counts not recorded.")
    src = (f'<p class="src">{tally["Fixed"]} fixed, {tally["Rejected"]} rejected, {tally["Open"]} open, {tally["Pre-existing"]} already there before this change. '
           f'All bars share one scale. {" ".join(explained)}</p>')
    reconstructed = "".join(f'<p class="src need">{esc(line.strip())}</p>' for line in c.texts["review"].split("\n") if RECONSTRUCTED.search(line))
    return funnel + src + reconstructed


def finding_item(page, anchor, entry):
    nits = nit_list(entry)
    if nits:
        body = f'<p class="fh">{esc(nits[0])}</p>' + "".join(f'<p class="fr">{page.inline(item)}</p>' for item in nits[1])
    else:
        head, *rest = entry.split(" — ", 1)
        body = f'<p class="fh">{page.inline(head)}</p>' + "".join(f'<p class="fr">{page.inline(part)}</p>' for part in rest)
    return f'<li id="{anchor}">{body}</li>'


def review_section(c):
    page = c.page
    word = c.stamps["review"]
    head = (f'<p>{state("This review is stale", "need")} its stamp doesn&#x27;t cover this commit, so what follows may be out of date.</p>'
            if word == "stale" else "")
    if not c.review:
        return section("review", "Code review", "What the review found", f'{head}<p>{source_html(c, "review", "review")}</p>')
    fields = c.review[1]
    model = fields.get("cross-model") or fields.get("cross-model reading")
    families = list(dict.fromkeys(lens["model"].strip() for lens in c.lenses or [] if lens["model"].strip() not in ("", "—", "-")))
    names = (list(dict.fromkeys(lens["lens"] for lens in c.lenses if lens not in c.failed_lenses)) if c.lenses is not None else
             [name.strip() for name in split_outside_parentheses(fields.get("lenses") or "") if name.strip()])
    names = [name for name in names if not name.lower().endswith("-recheck")]  # a re-check round, not a lens
    readers_off = [phase for phase in ("second-model", "claude-review", "codex-review") if phase in c.off]
    rounds = re.match(r"\d{1,9}", fields.get("re-check rounds") or "")
    who = ((f"{esc(sentence_list(families))}, " if families else "")
           + f'{len(names)} {"lens" if len(names) == 1 else "lenses"}: {esc(", ".join(names)) or "Not recorded"}'
           + (f'. Cross-model: {esc(model)}' if model else ". Cross-model: Not recorded")
           + (f'. {counted(int(rounds.group(0)), "re-check round")}' if rounds else "")
           + "".join(f". {esc(phase)} off by you" for phase in readers_off) + ".")
    worst = re.search(r"^Worst catch:\s*(.+)$", c.texts["review"], re.M)
    skipped = [(entry, label) for outcome, label, entry in c.entries if outcome == "Not run" and not SAYS_NONE.match(entry)
               and not SWITCHED_OFF.search(entry)]
    lens_skips = [f'{lens["model"]} {lens["lens"]}: {lens["findings"]}' for lens in c.failed_lenses if not SWITCHED_OFF.search(lens["findings"])]
    not_run = ("; ".join([page.inline(entry) for entry, _ in skipped] + [page.inline(line) for line in lens_skips]) or ("Every lens ran." if c.lenses else "Not recorded"))
    facts = (f'<dl class="facts"><dt>Who read it</dt><dd>{who}</dd>'
             f'<dt>Worst it caught<span class="judg">Agent&#x27;s judgment</span></dt><dd>{page.inline(worst.group(1)) if worst else "Not recorded"}</dd>'
             f'<dt>Not looked at</dt><dd id="review-not-run">{not_run}</dd></dl>')

    def lens_cell(value):
        return page.inline(value) if value.strip() and value.strip() not in ("—", "-") else state("not recorded", "dim")

    def brief(name):
        if c.briefs_why:
            return state("unavailable", "need")
        return esc(c.briefs[name.lower()]) if name.lower() in c.briefs else state("not recorded", "dim")
    if c.lenses is not None:
        lens_rows = "".join(f'<tr><th scope="row">{esc(lens["lens"])}</th><td>{brief(lens["lens"])}</td><td>{lens_cell(lens["model"])}</td>'
                            + (f'<td>{lens_cell(lens["findings"])}</td>' + f'<td>{state("not recorded", "dim")}</td>' * 2 if lens in c.failed_lenses else
                               f'<td>{lens_cell(lens["findings"])}</td><td>{lens_cell(lens["confirmed"])}</td><td>{lens_cell(lens["outcomes"])}</td>')
                            + "</tr>" for lens in c.lenses)
        count = len(c.lenses)
    else:
        lens_rows = "".join(f'<tr><th scope="row">{esc(name)}</th><td>{brief(name)}</td>' + f'<td>{state("not recorded", "dim")}</td>' * 4 + "</tr>" for name in names)
        count = len(names)
    lens_table = (f'<div class="table" tabindex="0" role="region" aria-label="Table: {", ".join(LENS_COLUMNS)}"><table class="lenses"><thead><tr>'
                  + "".join(f'<th scope="col">{column}</th>' for column in LENS_COLUMNS) + f"</tr></thead><tbody>{lens_rows}</tbody></table></div>")
    lens_fold = fold("Each lens, what it looks for and what it raised", count, lens_table, opened=count <= LONG_LIST, inner_id="review-lenses")

    open_rows = []
    for n, finding, impact, others, _ in c.open_items:
        cell_of = lambda name: page.inline(impact[name]) if impact.get(name) else IMPACT_NOT_RECORDED  # noqa: E731
        nits = nit_list(finding)
        said = (f'<p class="fh">{esc(nits[0])}</p>' + "".join(f'<p class="fr">{page.inline(item)}</p>' for item in nits[1])) if nits else page.inline(finding)
        reading = "".join(f'<p class="fr">{page.inline(part)}</p>' for part in others)
        open_rows.append(f'<tr id="review-open-{n}">' + impact_cell("The finding", said + reading)
                         + impact_cell("If it goes wrong", cell_of("If it goes wrong")) + impact_cell("Worst case", cell_of("Worst case"))
                         + impact_cell("Why it can wait", cell_of("Can wait because")) + "</tr>")
    still_open = (f'<h3 class="g need" id="review-open">Still open, and what each means for you <span class="n">{len(open_rows)}</span></h3>'
                  + stack_table(("The finding", "If it goes wrong", "Worst case", "Why it can wait"), open_rows)
                  if open_rows else '<p id="review-open">Nothing was left open.</p>')

    def outcome_fold(outcome, title):
        anchor = f"review-{outcome.lower()}"
        entries = [(label, entry) for kind, label, entry in c.entries if kind == outcome]
        listed = "".join(finding_item(page, f"{anchor}-{n}", entry) for n, (_, entry) in enumerate(entries, 1))
        return fold(title, len(entries), f'<ul class="find">{listed}</ul>' if entries else "<p>None.</p>", inner_id=anchor)
    return section("review", "Code review", "What the review found",
                   head + review_funnel(c) + facts + still_open
                   + outcome_fold("Fixed", "Fixed before you saw it") + outcome_fold("Rejected", "Rejected, with the reason")
                   + outcome_fold("Pre-existing", "Already there before this change") + lens_fold)


# Not proven, and decisions

def limit_rows(c):
    """Each gap: (gap html, fields). Named gaps, then checks that didn't run and criteria without a check, none of them with an invented impact."""
    page = c.page
    named = c.not_proven
    rows = [(page.inline(gap), fields) for gap, fields, _ in named]
    said = {word.strip(".-") for gap, *_ in named for word in re.findall(r"[\w.-]+", gap)}
    for row in c.rows:
        if row["result"] == "NOT RUN" and row["id"] not in said:
            rows.append((f'<code>{esc(row["id"])}</code> did not run: {page.inline(row["check"], links=False)}', {}))
    rows += [(f"AC{n} has no check", {}) for n in c.uncovered]
    return rows


def limits_section(c):
    rows = limit_rows(c)
    if rows:
        inline = c.page.inline
        cell_of = lambda fields, name: inline(fields[name]) if fields.get(name) else IMPACT_NOT_RECORDED  # noqa: E731
        table = stack_table(("Not proven for real", "If it goes wrong", "Worst case", "Checked by"), [
            "<tr>" + impact_cell("Not proven for real", gap) + impact_cell("If it goes wrong", cell_of(fields, "If it goes wrong"))
            + impact_cell("Worst case", cell_of(fields, "Worst case"))
            + impact_cell("Checked by", inline(fields["Checked by"]) if fields.get("Checked by") else "Not recorded") + "</tr>" for gap, fields in rows])
        intro = "<p>Each row is a gap, what it would mean for you if the code is wrong there, and how it gets checked. A test proves only the path it ran.</p>"
    else:
        table, intro = "", "<p>No gap recorded.</p>"
    if not c.validation_ok:
        intro = f'<p>{source_html(c, "validation", "validate")}. No gap can be read from it.</p>'
    guide = ""
    if c.guide and c.texts["checks-guide"] is not None:
        guide = f'<details class="more"><summary><b>The steps to check this yourself</b></summary><div class="inner">{c.page.markdown(c.texts["checks-guide"], "guide")}</div></details>'
    return section("limits", "Not proven", "What the tests can&#x27;t promise", intro + table + guide)


def options_list(page, options):
    items = []
    for option in split_outside_parentheses(options, ";"):
        named = re.match(r"\s*([A-Z])\b[ :.)—-]*(.*)", option, re.S)
        items.append(f"<li><b>{named.group(1)}</b>{page.inline(named.group(2))}</li>" if named else f"<li>{page.inline(option.strip())}</li>")
    return f'<ul class="opts">{"".join(items)}</ul>'


def decide_section(c):
    page = c.page
    if not c.decisions:
        return section("decide", "Your decisions", "What only you can decide", "<p>No decisions needed.</p>")
    articles = []
    for n, decision in enumerate(c.decisions, 1):
        def said(name):
            return page.inline(decision[name]) if decision.get(name) else "Not recorded"
        options = options_list(page, decision["Options"]) if decision.get("Options") else "<p>Options: Not recorded</p>"
        accepts = f"<p class=\"default\">Merging without answering accepts {said('Accepts')}</p>"
        extra = "".join(f"<p>{page.inline(line)}</p>" for line in decision["extra"])
        articles.append(f'<article class="decision"><h3 id="d{n}">{n}. {page.inline(decision["title"])}</h3>{extra}{options}'
                        f"<p><strong>Cost:</strong> {said('Cost')}</p><p><strong>Recommendation:</strong> {said('Recommendation')}</p>{accepts}</article>")
    return section("decide", "Your decisions", "What only you can decide", "".join(articles))


# The verdict and the control panel

def verdict_reasons(c):
    """(stops, calls, notes), each [(link, phrase for the sentence, what to read)]. VERDICT_RULE is the rule this applies."""
    page, texts, whys = c.page, c.texts, c.whys
    stops, calls, notes = [], [], []
    ci_phrases = {"FAIL": "CI failed", "pending": "CI is still running", "missing": "CI has no checks yet", "unknown": "CI couldn't be read", "no PR yet": "there is no PR, so no CI"}
    if c.ci_word not in ("PASS", "no CI", "CI phase off"):
        stops.append(("#footer", ci_phrases.get(c.ci_word, f"CI reads {c.ci_word}"), esc(c.ci_detail)))
    if c.pr and c.pr.get("state") in ("MERGED", "CLOSED"):
        stops.append(("#footer", f"the PR is already {c.pr['state'].lower()}", esc(c.pr["url"])))
    if c.pr and c.head != c.pr["headRefOid"]:
        stops.append(("#footer", "the local HEAD differs from the PR head", f"local <code>{esc(c.head)}</code>, PR {page.commit(c.pr['headRefOid'])}"))
    for row in c.rows:
        if row["result"] == "FAIL":
            stops.append((f"#{row['anchor']}", f"{row['id']} failed", page.inline(row["check"])))
    for step, info in c.guide.items():
        if info["result"] == "FAIL":
            stops.append((f"#guide-{step}", f"checks guide step {step} failed", esc(info["name"])))
    if c.verify_word and c.verify_word not in ("PASS", "phase off", "checked nothing"):
        stops.append(("#footer", "verify failed", esc(c.verify_line or c.verify_word)))
    for phase, kind, name in (("review", "review", "review"), ("validate", "validation", "validation")):
        word = c.stamps[phase]
        state_of = source_state(c, kind, phase)
        if state_of and state_of not in QUIET:
            stops.append((f"#annex-{kind}", f"the {name} is missing", esc(state_of[len("unavailable: "):])))
        elif word in ("stale", "missing"):
            stops.append((f"#annex-{kind}", f"the {name} is stale" if word == "stale" else f"the {name} has no stamp", f"The {esc(phase)} stamp reads {esc(word)}."))
    for message in c.stale_problems:
        stops.append(("#freshness", "the evidence is stale", esc(message)))
    for n, finding, _, _, raw in c.open_items:
        if is_blocking(raw):
            stops.append((f"#review-open-{n}", f"open finding: {finding}", page.inline(finding)))
    for gap, _, raw in c.not_proven:
        if is_blocking(raw):
            stops.append(("#limits", f"not proven: {gap}", page.inline(gap)))
    for decision in c.decisions:
        if is_blocking(decision["raw"]):
            stops.append(("#decide", f"blocking decision: {decision['title']}", page.inline(decision["title"])))

    for row in c.rows:
        if row["result"] == "NOT RUN":
            calls.append((f"#{row['anchor']}", f"{row['id']} did not run", page.inline(row["check"])))
        for name, why_unread in c.missing_files.get(row["anchor"], []):
            calls.append((f"#{row['anchor']}", f"{row['id']} names {name}, which {why_unread}", esc(name)))
    on_another = [row["id"] for row in c.rows if row["fresh"] == "stale"]
    if on_another and not c.stale_problems:  # a stale_problem already stops the merge
        calls.append(("#freshness", f"{sentence_list(on_another)} ran on another commit", "Their evidence doesn't cover what you would merge."))
    unknown = [row["id"] for row in c.rows if row["fresh"] == "unknown" and row["result"] in ("PASS", "FAIL")]
    if unknown:
        calls.append(("#freshness", f"{sentence_list(unknown)} {'do' if len(unknown) != 1 else 'does'} not say which commit {'they' if len(unknown) != 1 else 'it'} ran on",
                      "An output with no commit can't show it covers what you would merge."))
    for lens in c.failed_lenses:
        if not SWITCHED_OFF.search(lens["findings"]):
            calls.append(("#review-lenses", f'the {lens["model"]} {lens["lens"]} lens did not run', page.inline(lens["findings"])))
    for entry in c.failed_reviewers:
        calls.append(("#review-not-run", "a reviewer did not run", page.inline(entry)))
    for check, result in c.unread_results:
        calls.append(("#testing", f"{check} has a result the page can't count: {result}", "Read it as not passed until the report says PASS, FAIL or NOT RUN."))
    for skipped in c.not_run_types.values():
        calls.append(("#testing", f'{skipped["type"]} tests did not run', page.inline(skipped["evidence"]) or "No reason recorded."))
    if c.criteria_numbers and c.validation_ok and not c.ac_known:
        calls.append(("#testing", "no check names a criterion", "The validation report has no AC column, so nothing ties a check to what was asked."))
    if c.freshness_unread:
        calls.append(("#freshness", "an output can't be read, so the evidence's freshness is unknown", esc(c.freshness_unread)))
    for n in c.uncovered:
        calls.append((f"#ac-{n}", f"AC{n} has no check", f"AC{n} has no check."))
    # A row whose missing file is its video already has a reason above.
    unfilmed = [row for row in c.without_video
                if not any(name.lower().endswith(review_stamp.VIDEO_EXTENSIONS) for name, _ in c.missing_files.get(row["anchor"], []))]
    if unfilmed:
        ids = [row["id"] for row in unfilmed]
        calls.append((f"#{unfilmed[0]['anchor']}", f"video evidence is missing for {sentence_list(ids)}",
                      "Each Evidence cell names no usable video (a non-empty .webm or .mp4 in the evidence directory), so a validate "
                      "stamp taken now refuses it. Record each with bin/evidence-video."))
    without_impact = [finding for _, finding, impact, _, _ in c.open_items if impact_missing(impact, OPEN_IMPACT)]
    gaps = [gap for gap, fields, _ in c.not_proven if impact_missing(fields, GAP_IMPACT)]
    if without_impact or gaps:
        total = len(without_impact) + len(gaps)
        calls.append(("#limits" if gaps else "#review-open", f"{counted(total, 'item')} {'have' if total != 1 else 'has'} no recorded impact",
                      "; ".join(page.inline(item) for item in without_impact + gaps)))

    for kind, label in (("checks-guide", "the checks guide"), ("follow-pr", "the follow-pr report"), ("decision-notes", "the decision notes")):
        if texts[kind] is None and not whys[kind].startswith("no report") and not (kind == "checks-guide" and "validate" in c.off):
            calls.append((f"#annex-{kind}", f"{label} can't be read", f'{state("unavailable", "need")} {esc(whys[kind])}'))
    notes_text = texts["decision-notes"]
    notes_missing = whys["decision-notes"].startswith("no report") if notes_text is None else not notes_text.replace("\ufeff", "").strip()
    if notes_missing:
        calls.append(("#annex-decision-notes", "the decision notes are missing",
                      f'{state("missing" if notes_text is None else "empty", "need")} {esc(MAKERS["decision-notes"])}, at {page.path(c.paths["decision-notes"])}'))
    if texts["pr-body"] is None and not whys["pr-body"].startswith("no report"):
        notes.append(("#annex-pr-body", "PR description", f'{state("unavailable", "need")} {esc(whys["pr-body"])}'))
    if c.ship_text is None and not c.ship_why.startswith("no report"):
        notes.append(("#ship-steps", "Ship steps", f'{state("unavailable", "need")} {esc(c.ship_why)}'))
    if c.briefs_why:
        notes.append(("#review-lenses", "Lens descriptions", f'{state("unavailable", "need")} {esc(c.briefs_why)}'))
    if c.spec_text is None and c.spec_read_why and not c.spec_read_why.startswith("no report"):
        calls.append(("#annex-spec", "the spec can't be read", f'{state("unavailable", "need")} {esc(c.spec_read_why)}'))
    suite = os.path.join(c.evidence, "suite.txt")
    if "verify" not in c.off and c.verify_word is None:
        c.verify_missing = ("no report yet: the stop hook writes it when verify runs, or run "
                            "<code>python3 ~/.agents/hooks/stop_checks.py verify</code>, which also writes the verify stamp"
                            + (f". Until then the unit evidence is the full suite run, {page.path(suite, 'suite.txt')}" if os.path.isfile(suite) else ""))
        calls.append(("#footer", "no verify report", f'{state("missing", "need")} {c.verify_missing if whys["verify"] and whys["verify"].startswith("no report") else esc(whys["verify"] or "")}'))
    else:
        c.verify_missing = ""
    if c.verify_word == "checked nothing":
        calls.append(("#footer", "verify checked nothing", f'{state("checked nothing", "need")} {esc(c.verify_line or "")}'))
    if c.validation_ok and not c.pre_pr_a and not os.path.isfile(c.environment):
        notes.append(("#environment", "Environment", f'{state("missing", "need")} <code>{esc(c.environment)}</code>'))
    for warning in c.stale_warnings:
        notes.append(("#freshness", "Evidence freshness", f'{state("freshness warning", "need")} {esc(warning)}'))
    if c.phases_error:
        notes.append(("#footer", "Phase switches", f'{state("unavailable", "need")} {esc(c.phases_error)}'))
    if c.texts["follow-pr"] is not None:
        notes += [("#follow-pr-pending", "Follow-pr, pending", page.inline(line)) for line in follow_pr_pending(c.texts["follow-pr"])]
    if not c.changed:
        notes.append(("#annex-changed", "No diff", 'No file differs from the base: if this branch answers a question rather than changes code, add a '
                                                   '<code>Mode: investigation</code> line to the decision notes for the investigation page.'))
    return stops, calls, notes


def ready_sentence(c):
    """What the Ready word stands on, from the values it read."""
    parts = [{"no CI": "the repository runs no CI", "CI phase off": "the CI phase is off"}.get(c.ci_word, "CI passed")]
    for phase, name in (("review", "review"), ("validate", "validation")):
        parts.append(f"the {name} is {c.stamps[phase]}" if c.stamps[phase] != "phase off" else f"the {name} phase is off")
    parts.append("no check failed")
    parts.append("nothing is marked blocking")
    return sentence_list(parts)


def hero(c, title, stops, calls, notes):
    page = c.page
    word = verdict_of_change(stops, calls)
    reasons = stops or calls
    tone = "ok" if not reasons else "need"
    if reasons:
        phrases = [esc(phrase) for _, phrase, _ in reasons[:VERDICT_REASONS]]
        if len(reasons) > VERDICT_REASONS:
            phrases.append(f"{len(reasons) - VERDICT_REASONS} more")
        said = sentence_list(phrases)
    else:
        said = esc(ready_sentence(c))
    choices = (f' <a href="#decide">{counted(len(c.decisions), "choice")} {"are" if len(c.decisions) != 1 else "is"} yours.</a>' if c.decisions else "")
    verdict = f'<p class="verdict"><strong class="{tone}">{esc(word)}:</strong> {said}.{choices}</p>'
    listed = "".join(
        f'<p class="why-h">{heading}</p><ul id="{list_id}">' + "".join(f'<li><a href="{esc(href)}">{esc(phrase)}</a>: {detail}</li>' for href, phrase, detail in items) + "</ul>"
        for list_id, heading, items in (("stops", "What stops the merge", stops), ("calls", "What needs your call", calls), ("notes", "Also worth a look", notes)) if items)
    why = (f'<details class="why" id="verdict-why"><summary>Why this verdict</summary><p class="src">{esc(VERDICT_RULE)}</p>'
           + (listed or "<p>Nothing stops the merge and nothing needs your call.</p>") + "</details>")
    facts = {**c.problem_facts, **c.solution_facts}
    notes_read = c.notes or {}

    def sentence(text):
        return page.inline(first_sentence(" ".join(text.split()))[0], links=False) if text and text.strip() else "Not recorded."
    problem = c.problem_facts.get("What they see") or first_paragraph(c.problem_text) or first_paragraph(notes_read.get("task") or "") or (c.goal.group(1) if c.goal else "")
    fails, not_run = c.counts["FAIL"], c.counts["NOT RUN"]
    manual = sum(row["level"] not in AUTOMATED_LEVELS and row["result"] != "NOT RUN" for row in c.rows)
    if c.validation_ok:
        tested = f'{sum(row["result"] == "PASS" for row in c.rows)} of {counted(len(c.rows), "check")} passed, {manual} run for real; {fails} failed and {not_run} did not run.'
    else:
        tested = "Not recorded."
    fresh_words = [row.get("fresh") for row in c.rows]
    validation_state = source_state(c, "validation", "validate")
    test_word = ("Clear" if c.validation_ok and validation_state is None and c.stamps["validate"] == "current" and not fails and not not_run and "stale" not in fresh_words and "unknown" not in fresh_words
                 and not c.not_run_types and not c.uncovered and not c.missing_files and not c.without_video and not c.unread_results else "Read this")
    if c.review:
        kinds = {outcome: sum(e[0] == outcome for e in c.entries) for outcome in REVIEW_OUTCOMES}
        reviewed = f'{kinds["Fixed"]} fixed, {kinds["Rejected"]} rejected, {kinds["Open"]} left open.'
    else:
        reviewed = "Not recorded."
    lens_down = any(not SWITCHED_OFF.search(lens["findings"]) for lens in c.failed_lenses)
    review_word = "Clear" if c.review and not c.open_items and c.stamps["review"] == "current" and not lens_down and not c.failed_reviewers else "Read this"
    limits = limit_rows(c)
    gaps = len(limits)
    all_named = not any(impact_missing(fields, GAP_IMPACT) for _, fields in limits)
    proven = (f'{counted(gaps, "gap")} recorded' + (", each named with what it would mean for you." if all_named else ".")) if gaps else "No gap recorded."
    unread = validation_state is not None and validation_state not in QUIET
    if validation_state:
        proven = "Not recorded." if unread else f"Validation {validation_state}."
    decided = (f'You have {counted(len(c.decisions), "decision")} before the merge.' if c.decisions else "No decisions needed.")
    rows = (("problem", "The problem", sentence(problem), None), ("fix", "Stability", sentence(notes_read.get("stability")), None),
            ("fix", "Your experience", sentence(notes_read.get("users")), None), ("testing", "Testing", tested, test_word),
            ("review", "Code review", reviewed, review_word), ("limits", "Not proven", proven, "Read this" if gaps or unread else None if validation_state else "Clear"),
            ("undo", "Undo", sentence(facts.get("To undo")), None), ("decide", "Your decisions", decided, "Yours" if c.decisions else None))
    panel = '<div class="panel">' + "".join(
        f'<a href="#{href}"><b>{label}</b><span>{body}</span><i class="{"ok" if word_of == "Clear" else "need" if word_of else ""}">{word_of or ""}</i></a>'
        for href, label, body, word_of in rows) + "</div>"
    lead = c.lead or (c.goal.group(1) if c.goal else "") or (first_paragraph(c.texts["pr-body"]) if c.texts["pr-body"] else "") or first_paragraph(c.problem_text)
    return (f'<header class="hero"><h1>{esc(title)}</h1><p class="lead">{page.inline(lead) if lead else "Not recorded."}</p>{verdict}{why}{panel}</header>')


# The footer: what's left after the merge, the reports, the ids

def after_merge(c):
    page = c.page
    merge = (f'<p id="merge-note"><strong>The agent&#x27;s recommendation:</strong> {page.inline(c.merge_note.replace(chr(10), " "))}</p>' if c.merge_note else "")
    pending = follow_pr_pending(c.texts["follow-pr"]) if c.texts["follow-pr"] is not None else []
    follow = ('<ul id="follow-pr-pending">' + "".join(f"<li>Follow-pr, pending: {page.inline(line)}</li>" for line in pending) + "</ul>") if pending else ""
    steps = [(step, info) for step, info in c.guide.items() if step.startswith("P")]
    if "validate" in c.off:
        after = f'<p>{state("phase off", "dim")}</p>'
    elif c.texts["checks-guide"] is None:
        after = f'<p>{state("not recorded", "dim") if c.whys["checks-guide"].startswith("no report") else state("unavailable", "need")} the checks guide</p>'
    elif steps:
        after = '<ol class="owned">' + "".join(
            f'<li><span class="owner">{esc(info["owner"])}</span> <a href="#guide-{esc(step)}"><code>{esc(step)}</code></a> '
            f'{esc(info["name"])}: {state(info["result"] or "left", result_tone(info["result"] or ""))}{esc(info["date"])}</li>' for step, info in steps) + "</ol>"
    else:
        after = f'<p>{state("none", "dim")} the checks guide has no step after the merge</p>'
    ship = f'<h3 id="ship-steps">Ship steps</h3><p class="meta">from <code>{esc(c.ship_path)}</code></p>'
    if c.ship_text is None:
        ship += (f'<p class="absent">{state("not recorded", "dim")} no ship steps for this repository</p>' if c.ship_why.startswith("no report")
                 else unavailable(c.ship_why))
    else:
        found = level_two_sections(c.ship_text)
        merged = (c.pr.get("mergeCommit") or {}).get("oid") if c.pr and c.pr.get("state") == "MERGED" else None
        for key, name in SHIP_SECTIONS:
            body = found.get(name.lower())
            if not body:
                part = f'<p>{state("not recorded", "dim")}</p>'
            else:
                # only in text: a marker inside a tag's attribute (a table's aria-label) would break the tag
                part = "".join(piece if piece.startswith("<") else
                               re.sub(r"\(inferred:", lambda m: f'{state("unconfirmed", "need")} {m.group(0)}', piece)
                               for piece in re.split(r"(<[^>]*>)", page.markdown(body, f"shipmd-{key}", top=5)))
                if re.match(r"[`*_]*unknown\b", body, re.I):
                    part = f'<p>{state("unconfirmed", "need")}</p>{part}'
            if key == "rollback":
                part += (f'<p class="ids">PR {c.pr_link} · merge commit {page.commit(merged)}</p>' if merged else
                         f'<p class="ids">PR {c.pr_link} · {state("not merged", "dim")}</p>' if c.pr else
                         f'<p class="ids">{state("no PR yet", "dim")}</p>')
            ship += f'<div class="ship" id="ship-{key}"><h4>{name}</h4>{part}</div>'
    return f"<details><summary>Merge, ship and roll back</summary>{merge}{follow}<h3>After the merge</h3>{after}{ship}</details>"


def report_annexes(c):
    page = c.page
    annexes = {"spec": (c.spec_path, c.spec_text, c.spec_read_why)}
    annexes.update({kind: (c.paths[kind], c.texts[kind], c.whys[kind]) for kind in c.paths})
    phase_of = {"verify": "verify", "review": "review", "validation": "validate", "checks-guide": "validate"}
    out = ""
    for kind, label in ANNEXES:
        path, text, why = annexes[kind]
        if phase_of.get(kind) in c.off:
            body = f'<p>{state("phase off", "dim")}</p>'
        elif text is None:
            body = (f'<p class="absent">{state("not recorded", "dim")} {esc(MAKERS[kind])}</p>' if not why or why.startswith("no report")
                    else unavailable(why.replace(path, "the file")))
        elif not page.charge(text):
            body = f'<p>{state("linked", "dim")} past the 20 MB embedded in total: <a href="{esc(file_href(path))}">{esc(os.path.basename(path))}</a></p>'
        else:
            body = page.markdown(text, f"annex-{kind}", top=3)
        out += (f'<details class="annex"><summary>{label} <code>{esc(path)}</code></summary>'
                f'<div class="annex-body" id="annex-{kind}">' + (f'<p class="meta"><a href="{esc(href)}">open the file</a></p>'
                   if text is not None and phase_of.get(kind) not in c.off and (href := page.local_href(path)) else "")
                + f'{body}</div></details>')
    groups = c.changed
    dir_rows = "".join(f'<tr><th scope="row">{esc(top)}</th><td>{len(files)}</td>'
                       f'<td>+{sum(int(a) for _, a, _ in files if a.isdigit())}</td>'
                       f'<td>-{sum(int(r) for _, _, r in files if r.isdigit())}</td></tr>' for top, files in sorted(groups.items()))
    file_rows = "".join(f"<tr><td><code>{esc(path)}</code></td><td>+{esc(a)}</td><td>-{esc(r)}</td></tr>"
                        for _, files in sorted(groups.items()) for path, a, r in files)
    out += (f'<details class="annex"><summary>Changed files against <code>{esc(c.base)}</code> ({esc(c.base_ref)}), '
            'the working tree included</summary><div class="annex-body" id="annex-changed">'
            + ('<div class="table" tabindex="0" role="region" aria-label="Changed directories"><table class="dirs"><thead><tr><th scope="col">Directory</th><th scope="col">Files</th>'
               f'<th scope="col">Added</th><th scope="col">Removed</th></tr></thead><tbody>{dir_rows}</tbody></table></div>'
               '<div class="table" tabindex="0" role="region" aria-label="Changed files"><table><thead><tr><th scope="col">File</th>'
               f'<th scope="col">Added</th><th scope="col">Removed</th></tr></thead><tbody>{file_rows}</tbody></table></div>'
               if groups else f'<p>{state("none", "dim")} no file differs from the base</p>') + "</div></details>")
    return f"<details><summary>Full reports</summary>{out}</details>"


def change_footer(c):
    page, pr = c.page, c.pr
    pr_text = (f'{c.pr_link} {esc(pr.get("state") or "")} <a href="{esc(pr["url"])}"{REL}>{esc(pr["url"])}</a>' if c.github else
               f'#{pr["number"]} {esc(pr.get("state") or "")} <code>{esc(pr.get("url") or "")}</code>' if pr else
               state("unknown", "need") + " " + esc(c.pr_error) if c.pr_error else state("no PR yet", "dim"))
    covers = (f'commit {page.commit(pr["headRefOid"])}, tree <code>{esc(c.pr_tree)}</code>' if pr and c.pr_tree else
              f'commit {page.commit(pr["headRefOid"])}, tree {state("unavailable", "dim")} not in this repository' if pr else state("no PR yet", "dim"))
    # the CI detail names the PR head; a commit is linked only once GitHub has it: the PR's head, or one a remote branch holds
    ci_html = esc(c.ci_detail).replace(esc(pr["headRefOid"]), page.commit(pr["headRefOid"])) if pr else esc(c.ci_detail)
    pushed = bool(pr) and (c.head == pr["headRefOid"] or bool(review_stamp.git("branch", "-r", "--contains", c.head)))
    head_html = page.commit(c.head, pushed) if re.fullmatch(r"[0-9a-f]{40,64}", c.head) else f"<code>{esc(c.head)}</code>"
    phases = f'{state("unavailable", "need")} {esc(c.phases_error)}' if c.phases_error else esc(phase_switches.describe(c.off))
    verify_html = (state(c.verify_word, result_tone(c.verify_word)) if c.verify_word and c.verify_word != "phase off" else source_html(c, "verify", "verify"))
    now = datetime.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %z")
    return (f'<footer id="footer">{after_merge(c)}{report_annexes(c)}'
            f'<dl class="sum"><div class="row"><dt id="sum-signals">Signals</dt><dd>{signals_line(pr, c.pr_error)}</dd></div></dl>'
            '<dl class="ids">'
            f'<dt>PR</dt><dd>{pr_text}</dd>'
            f'<dt>Commit and tree</dt><dd>{covers}</dd>'
            f'<dt>CI</dt><dd>{state(c.ci_word, c.ci_tone)} {ci_html}</dd>'
            f'<dt>Stamps</dt><dd>review stamp {state(c.stamps["review"], stamp_tone(c.stamps["review"]))}, '
            f'validate stamp {state(c.stamps["validate"], stamp_tone(c.stamps["validate"]))}</dd>'
            '<dt>Verify</dt><dd>'
            + (f'{state("missing", "need")} {c.verify_missing}'
               if c.whys["verify"] and c.whys["verify"].startswith("no report") and "verify" not in c.off
               else f'{verify_html} {esc(c.verify_line or "")}' + (f" · {page.path(c.paths['verify'])}" if c.texts["verify"] is not None else ""))
            + '</dd>'
            f'<dt>Phases off</dt><dd>{phases}</dd>'
            f'<dt>HEAD read</dt><dd>commit {head_html}, working tree <code>{esc(c.tree)}</code>, branch <code>{esc(c.branch)}</code></dd>'
            f'<dt>Generated</dt><dd>{esc(now)}</dd>'
            f'<dt>Page</dt><dd>local file, not published · <a href="{esc(file_href(c.page_path))}"><code>{esc(c.page_path)}</code></a></dd>'
            f'</dl><p class="src">Decision page for <code>{esc(c.branch)}</code>, from its spec, reports and evidence.</p></footer>')


def build(page_path, evidence):
    page = Page(evidence)
    page.ids.update(("main", "footer", "environment", "problem", "fix", "undo", "testing", "review", "limits", "decide", "freshness", "automated",
                     "manual", "todo", "regressions", "review-open", "review-not-run", "review-lenses", "verdict-why", "merge-note", "ship-steps"))
    off, phases_error = phase_switches.phases_off_or_error(os.getcwd())
    kinds = ("decision-notes", "pr-body", "verify", "review", "validation", "checks-guide", "follow-pr")
    paths = dict(zip(kinds, review_stamp.report_paths(*kinds)))
    texts, whys = {}, {}
    for kind in kinds:
        texts[kind], whys[kind] = read_report(paths[kind])
    if texts["decision-notes"] is not None and review_stamp.is_investigation(texts["decision-notes"]):
        return build_investigation(page_path, page, off, phases_error, paths, texts, whys)
    c = read_change(page, page_path, evidence, off, phases_error, paths, texts, whys)
    c.changed = changed_files(c.base)

    # The copies of report text shown outside the annexes: the notes' panel sentences and facts, the review's findings,
    # the checks, the ship steps, the guide's steps. Each source is under REPORT_LIMIT, so they fit in the total before
    # any evidence, and the evidence and annexes after them fall back to links. When they don't (long non-ASCII reports),
    # nothing is left for evidence or annexes.
    if not page.charge(texts["decision-notes"] or "", (c.notes or {}).get("decide") or "", texts["review"] or "", texts["review"] or "",
                       texts["validation"] or "", c.ship_text or "", texts["checks-guide"] or "", texts["pr-body"] or ""):
        page.embedded = TOTAL_LIMIT

    # Built in the order that spends the embed budget: the notes' figures, then the evidence, then the annexes
    problem = problem_section(c)
    fix = solution_section(c)
    check_blocks(c)
    testing = testing_section(c)
    review = review_section(c)
    limits = limits_section(c)
    decide = decide_section(c)
    stops, calls, notes = verdict_reasons(c)
    title = c.notes_title or (c.pr["title"] if c.pr else None) or (c.spec_title.group(1) if c.spec_title else c.branch)
    main = hero(c, title, stops, calls, notes) + problem + fix + testing + review + limits + decide
    return change_document(title, main, change_footer(c), c.page.scene_style())


def page_head(title, style):
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
            f'<meta http-equiv="Content-Security-Policy" content="{esc(CSP)}">'
            f'<meta name="viewport" content="width=device-width, initial-scale=1"><meta name="referrer" content="no-referrer">'
            f"<title>{esc(title)}</title><style>{style}</style></head><body>")


def change_document(title, main, footer, scene_style):
    return page_head(title, CHANGE_STYLE + scene_style) + f'<a class="skip" href="#main">Skip to the verdict</a><main id="main">{main}</main>{footer}</body></html>\n'


def document(title, purpose, strip, main, footer):
    """The investigation page around its parts: the CSP, the skip link and the header."""
    return (page_head(title, STYLE) + f'<a class="skip" href="#main">Skip to the summary</a>'
            f'<header class="top"><h1>{esc(title)}</h1><p class="purpose">{purpose}</p><p class="strip">{strip}</p></header>'
            f'<main id="main">{main}</main>{footer}</body></html>\n')


def split_hypotheses(text):
    """(the text before the first `###`, [(title, description, {"for": text, "against": text} or None per part)])."""
    intro, found, part = [], [], None
    for line, fenced in outside_fences(text):
        title = not fenced and heading(line)
        start = not fenced and HYPOTHESIS_PART.fullmatch(line.strip())
        if title and title[0] == 3:
            found.append((title[1], [], {}))
            part = None
        elif found and start:
            part = start.group(1).lower()
            found[-1][2].setdefault(part, []).append(start.group(2))
        elif found:
            (found[-1][2][part] if part else found[-1][1]).append(line)
        else:
            intro.append(line)
    join = lambda lines: "\n".join(lines).strip()
    return join(intro), [(t, join(d), {k: join(v) for k, v in parts.items()}) for t, d, parts in found]


def build_investigation(page_path, page, off, phases_error, paths, texts, whys):
    """The investigation page: the question, the answer, the hypotheses, the options and the findings; nothing on it
    waits on a pull request, CI, the stamps or ship steps, so gh is never called."""
    spec_path, _, spec_why = review_stamp.spec_criteria()
    spec_text, spec_read_why = read_report(spec_path) if spec_path else (None, spec_why)
    spec_path = spec_path or "the spec"
    spec_title = re.search(r"^# (.+)$", spec_text or "", re.M)
    notes = level_two_sections(texts["decision-notes"])
    branch = review_stamp.git("branch", "--show-current")
    head = review_stamp.git("rev-parse", "--verify", "--quiet", "HEAD") or "no commit yet"
    base, base_ref = review_stamp.merge_base(), review_stamp.branch_base()[0]
    status = review_stamp.run_git(["status", "--porcelain"])
    changed = sum(len(files) for files in changed_files(base).values())
    now = datetime.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %z")
    page.local_roots.append(os.path.realpath(os.path.dirname(paths["validation"])))
    if not page.charge(texts["decision-notes"], texts["validation"] or ""):
        page.embedded = TOTAL_LIMIT
    blockers = []  # (link, text, the section it opens or None); no phase switch applies here, so an unreadable one isn't one
    for kind, why in (("spec", spec_read_why), ("validation", whys["validation"])):
        if why and not why.startswith("no report"):
            blockers.append((f"#annex-{kind}", f'{state("unavailable", "need")} {esc(why)}', 5))

    missing = set()

    def evidence_of(text, anchor, number=None):
        """The files the text names, below it: an image shown, a text file folded; one named inside the evidence
        directory but not there is a blocker."""
        out = []
        for named, real in files_the_notes_name(page, text):
            if real is not None and not os.path.exists(real) and real not in missing:
                missing.add(real)
                blockers.append((f"#{anchor}", f'<code>{esc(named)}</code> {state("missing", "need")}: the decision notes '
                                               "name it, the evidence directory doesn't hold it", number))
            block = page.file_block(named, real)
            out.append(f'<details class="earlier"><summary>{esc(os.path.basename(named))}</summary>{block}</details>'
                       if block.startswith('<div class="file text"') else block)
        return "".join(out)

    def part(text, anchor, number):
        return ((page.markdown(text, anchor, top=4) if text.strip() else f'<p>{state("none recorded", "dim")}</p>')
                + evidence_of(text, anchor, number))

    def required(heading_text, key):
        body = (notes.get(key) or "").strip()
        if not body:
            blockers.append(("#annex-decision-notes", f'<code>## {esc(heading_text)}</code> {state("missing", "need")} '
                                                     "in the decision notes", None))
        return body

    question = required("The question", "the question")
    answer = required("The answer", "the answer")
    confidence, confidence_reason, kept = None, "", []
    for line, fenced in outside_fences(answer):
        found = not fenced and confidence is None and CONFIDENCE.fullmatch(line.strip())
        if found:
            value = found.group(1).strip(" \t*_.")
            level = CONFIDENCE_LEVEL.fullmatch(value)
            confidence, confidence_reason = (level.group(1).lower(), level.group(2)) if level else (value.lower(), "")
        else:
            kept.append(line)
    if answer and confidence not in ("high", "medium", "low"):
        word, said = ("missing", "") if confidence is None else ("unknown", f" <code>{esc(confidence)}</code>")
        blockers.append(("#sum-answer", f'The answer\'s <code>Confidence:</code> line {state(word, "need")}{said}: '
                                        "write high, medium or low", None))
    if answer and not "\n".join(kept).strip():
        blockers.append(("#sum-answer", f'<code>## The answer</code> {state("missing", "need")}: it holds only its '
                                        "<code>Confidence:</code> line", None))
    # The question's and the answer's files first: the page shows them first, and a file is embedded where it first shows
    question_evidence, answer_evidence = evidence_of(question, "sum-question"), evidence_of(answer, "sum-answer")
    answer = "\n".join(kept).strip()
    # An `Unblocks:` line written flush under its item still belongs to it
    decide = re.sub(r"(?m)^(?=[*_]*Unblocks[*_]*:)", "  ", required("What you must decide", "what you must decide"))

    # Your decisions: an item `None` says there is nothing to decide
    decisions = []
    for item in note_items(decide):
        first, *rest = item.split("\n")
        if not rest and first.strip("*_.: ").lower() == "none":
            continue
        unblocks = next((UNBLOCKS.fullmatch(line.strip()) for line in rest if UNBLOCKS.fullmatch(line.strip())), None)
        lines = "".join(f'<span class="sub">{page.inline(line)}</span>' for line in rest if not UNBLOCKS.fullmatch(line.strip()))
        said = page.inline(unblocks.group(1)) if unblocks and unblocks.group(1).strip() else state("not recorded", "dim")
        decisions.append(("#annex-decision-notes", page.inline(first) + lines
                          + f'<span class="sub"><span class="k">Unblocks:</span> {said}</span>'
                          + evidence_of(item, "decisions")))

    # Hypotheses, options, not checked
    intro, hypotheses = split_hypotheses(notes.get("hypotheses") or "")
    s1 = (page.markdown(intro, "hyp-intro", top=3) if intro else "") + evidence_of(intro, "s01", 1)
    for n, (title, description, parts) in enumerate(hypotheses, 1):
        page.ids.add(f"hyp-{n}")
        s1 += (f'<div class="hyp" id="hyp-{n}"><h3>{page.inline(title)}</h3>'
               + (page.markdown(description, f"hyp-{n}-text", top=4) if description else "") + evidence_of(title + "\n" + description, f"hyp-{n}", 1)
               + '<dl class="row">' + "".join(f'<dt>{label}</dt><dd id="hyp-{n}-{key}">{part(parts.get(key, ""), f"hyp-{n}-{key}", 1)}</dd>'
                                             for key, label in (("for", "For"), ("against", "Against"))) + "</dl></div>")
    s1 = s1 or f'<p>{state("none recorded", "dim")}</p>'
    s2 = part(notes.get("options") or "", "s02", 2)
    rows = check_rows(texts["validation"], RESULTS + review_stamp.FINDINGS) if texts["validation"] is not None else []
    for row in rows:
        row["anchor"] = page.new_id(f"check-{row['id']}")
    not_run = [row for row in rows if row["result"] == "NOT RUN"]
    if not page.charge("".join(row["observed"] for row in not_run)):  # their reasons show again under Not checked
        page.embedded = TOTAL_LIMIT
    s3 = (f'<div id="not-checked-notes">{part(notes.get("not checked") or "", "not-checked-notes", 3)}</div><h3>Checks NOT RUN</h3>'
          + ('<ol class="items" id="not-run">' + "".join(
              f'<li><a href="#{row["anchor"]}"><code>{esc(row["id"])}</code></a> {page.inline(row["check"])}: '
              f'{page.inline(row["observed"]) or state("no reason recorded", "dim")}</li>' for row in not_run) + "</ol>"
             if not_run else f'<p id="not-run">{state("none", "dim")} no finding is NOT RUN</p>'))

    # Findings: a result is what was found, not a gate, so no row is a failure
    items = []
    for row in rows:
        blocks = "".join(page.file_block(named, real) for named, real in named_files(page, row))
        expected = row["expected"]
        items.append(
            f'<li class="check" id="{row["anchor"]}"><details><summary><span class="cid">{esc(row["id"])}</span> '
            f'{state(FINDING_WORDS.get(row["result"], row["result"]), "dim" if row["result"] == "NOT RUN" else "neutral")} '
            f'<span class="ac">{esc(row["ac"]) or state("no AC", "dim")}</span> '
            f'<span class="ctext">{page.inline(row["check"], links=False)}</span></summary><dl class="row">'
            f'<dt>Expected</dt><dd>{page.inline(expected) if expected and expected.strip() else state("not recorded", "dim")}</dd>'
            f'<dt>Observed</dt><dd>{page.inline(row["observed"]) or state("not recorded", "dim")}</dd>'
            f'<dt>Evidence</dt><dd>{blocks or state("no evidence named", "dim")}</dd>'
            f'<dt>Source</dt><dd>{page.path(paths["validation"], paths["validation"] + ":" + str(row["line"]))}</dd></dl></details></li>')
    s4 = (f'<ol class="checks">{"".join(items)}</ol>' if items else
          f'<p class="absent">{state("not recorded", "dim")} no findings table in <code>{esc(paths["validation"])}</code></p>')
    found_words = review_stamp.FINDINGS + ("NOT RUN", "PASS", "FAIL")
    s4_meta = " · ".join(f"{n} {FINDING_WORDS.get(word, word)}" for word in found_words
                         if (n := sum(row["result"] == word for row in rows))) or "no findings"

    # Reports, as annexes
    annexes = {"spec": (spec_path, spec_text, spec_read_why), "decision-notes": (paths["decision-notes"], texts["decision-notes"], None),
               "validation": (paths["validation"], texts["validation"], whys["validation"])}
    s5 = ""
    for kind, label in ANNEXES:
        if kind not in annexes:
            continue
        path, text, why = annexes[kind]
        if text is None:
            body = (f'<p class="absent">{state("not recorded", "dim")}</p>' if not why or why.startswith("no report")
                    else unavailable(why.replace(path, "the file")))
        elif not page.charge(text):
            body = f'<p>{state("linked", "dim")} past the 20 MB embedded in total: <a href="{esc(file_href(path))}">{esc(os.path.basename(path))}</a></p>'
        else:
            body = page.markdown(text, f"annex-{kind}", top=3)
        s5 += (f'<details class="annex" id="annex-{kind}"><summary>{label} <code>{esc(path)}</code></summary>'
               f'<div class="annex-body">' + (f'<p class="meta"><a href="{esc(href)}">open the file</a></p>'
                                              if text is not None and (href := page.local_href(path)) else "")
               + f"{body}</div></details>")

    # The summary
    confidence_html = (state(f"{confidence} confidence", "neutral") + (f" {page.inline(confidence_reason)}" if confidence_reason else "")
                       if confidence in ("high", "medium", "low") else "")
    rows_html = (("question", "The question", page.markdown(question, "question", top=3) + question_evidence
                  if question else state("missing", "need")),
                 ("answer", "The answer", (page.markdown(answer, "answer", top=3) if answer else "") + f"<p>{confidence_html}</p>"
                  + answer_evidence if answer or confidence_html else state("missing", "need")),
                 ("gates", "Gates", f'{state("does not apply", "dim")} {DOES_NOT_APPLY}: an investigation delivers an answer, '
                                    "not a change to merge"))
    summary = ('<section id="summary" aria-labelledby="h00"><h2 class="vh" id="h00">Summary</h2><dl class="sum">'
               + "".join(f'<div class="row"><dt id="sum-{key}">{label}</dt><dd>{body}</dd></div>' for key, label, body in rows_html)
               + "</dl>" + item_list(page, "decisions", "Your decisions", decisions, "nothing to decide")
               + item_list(page, "blockers", "Blockers the agent owns", blockers, "no blocker")
               + '<nav class="toc" aria-label="Sections"><ol>'
               + "".join(f'<li><a href="#s0{n}">{name}</a></li>' for n, name in INVESTIGATION_SECTIONS.items()) + "</ol></nav></section>")
    opened = {number for _, _, number in blockers if number}
    metas = {1: "1 hypothesis" if len(hypotheses) == 1 else f"{len(hypotheses)} hypotheses", 2: "the options weighed",
             3: f"{len(not_run)} NOT RUN", 4: s4_meta, 5: "the spec, the decision notes and the validation report"}
    sections = {1: s1, 2: s2, 3: s3, 4: s4, 5: s5}
    body_html = "".join(
        f'<details class="sec"{" open" if n in opened else ""} id="s0{n}"><summary><h2 id="h0{n}"><span class="num">0{n}</span> '
        f'{INVESTIGATION_SECTIONS[n]}</h2><span class="meta">{esc(metas[n])}</span></summary><div class="sec-body">{sections[n]}</div></details>'
        for n in sorted(sections))

    # Header, footer
    title = spec_title.group(1) if spec_title else branch
    todo = f'{len(decisions)} decision{"s" * (len(decisions) != 1)} · {len(blockers)} blocker{"s" * (len(blockers) != 1)}'
    tree = (state("unknown", "need") + " " + esc(" ".join(status.stderr.split())) if status.returncode
            else "dirty" if status.stdout.strip() else "clean")
    footer = ('<footer id="footer"><dl class="ids">'
              f'<dt>Repository</dt><dd>{esc(review_stamp.repo_name())}</dd>'
              f'<dt>Base</dt><dd>commit <code>{esc(base)}</code>, where it left <code>{esc(base_ref)}</code></dd>'
              f'<dt>HEAD</dt><dd><code>{esc(head)}</code></dd>'
              f'<dt>Working tree</dt><dd>{tree}</dd>'
              f'<dt>Branch</dt><dd><code>{esc(branch)}</code></dd>'
              + (f'<dt>Changed files</dt><dd>{changed} against the base</dd>' if changed else "")
              + f'<dt>Phases off</dt><dd>{esc(phase_switches.describe(off)) if not phases_error else state("unavailable", "need")}</dd>'
              f'<dt>Generated</dt><dd>{esc(now)}</dd>'
              f'<dt>Page</dt><dd>local file, not published · <a href="{esc(file_href(page_path))}"><code>{esc(page_path)}</code></a></dd>'
              '</dl></footer>')
    return document(title, f"Investigation page for <code>{esc(branch)}</code>, from its notes, findings and evidence",
                    f'<a class="todo {"need" if blockers else "ok"}" href="#decisions">{todo}</a>', summary + body_html, footer)


