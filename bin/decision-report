#!/usr/bin/env python3
"""Write the branch's decision page: one local HTML page, built from the spec, the agent's decision notes, the reports,
the evidence and the pull request's CI. A summary comes first: the task, the solution, the review, the tests and the
gates, then your decisions, the blockers the agent owns and the warnings. Five folded sections follow (coverage, tests,
review, merge and ship, and the reports as annexes), each open only while it holds a failure or a blocker, then a footer
of identifiers.

  decision-report <page> <evidence dir>    run by `reports html`, which passes both paths; prints the page's path

The page runs no script and loads nothing from the network. Of the files the reports name, it reads only those inside
the evidence directory, and embeds text up to 200 KB (head and tail kept), images up to 2 MB, 20 MB in all; the rest is linked by file:// path.
Besides the reports, it reads the repository's ship.md under ~/.agents/repos and the review's lenses.md, bounded as a report is.
It is written to a temporary file and renamed into place; when generation fails, the page is removed and the error
printed (exit 1), so an older page is never taken for the current one.
"""
import base64
import contextlib
import datetime
import html
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
import urllib.parse

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(HERE, "..", "hooks"))
import phase_switches  # noqa: E402
import review_stamp  # noqa: E402

sys.dont_write_bytecode = True  # loading the scripts below would leave bin/__pycache__ behind


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(name, loader))
    loader.exec_module(module)
    return module


pr_validation = load("pr_validation", os.path.join(HERE, "pr-validation"))
ci_wait = load("ci_wait", os.path.join(HERE, "ci-wait"))
triage = load("triage", os.path.join(HERE, "triage"))
ci_wait.GH_TIMEOUT = GH_TIMEOUT = 20

CSP = "default-src 'none'; img-src file: data:; media-src file:; style-src 'unsafe-inline'; base-uri 'none'; form-action 'none'"
TEXT_LIMIT = 200 * 1024
IMAGE_LIMIT = 2 * 1024 * 1024
TOTAL_LIMIT = 20 * 1024 * 1024
REPORT_LIMIT = 2 * 1024 * 1024
IMAGES = {".png": "image/png", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".gif": "image/gif", ".webp": "image/webp"}
VIDEOS = (".webm", ".mp4", ".mov")
PLAYABLE = {".webm": "video/webm", ".mp4": "video/mp4"}  # a .mov plays only in Safari, so it stays a link
TAIL_LINES = 40
ACTIVE = (".html", ".htm", ".xhtml", ".svg", ".xml")  # opened from a link, these run their own scripts, outside the CSP
FILE_TOKEN = re.compile(r"(?<![\w./~-])[\w.-]+\.(?:txt|log|out|md|json|csv|png|jpe?g|gif|webp|webm|mp4|mov|sh|py|html)(?![\w.-])")
PATH_TOKEN = re.compile(r"(?<![\w(\]])(?:~|/)[^\s|()\[\]`'\"<>]*[^\s|()\[\]`'\"<>.,;:]")
# The label excludes `[`: a run of unmatched brackets would otherwise be scanned again from each one.
INLINE = re.compile(r"`([^`\n]+)`|\*\*([^*\n]+)\*\*|!?\[([^\[\]\n]*)\]\(((?:[^()\n]|\([^()\n]*\))*)\)")
TABLE_RULE = re.compile(r"[ \t]*(?:\|[ \t]*)?:?-{3,}")
CONTROL = re.compile(r"[\x00-\x08\x0b-\x1f\x7f]")
NOTE_SECTIONS = {"what the task must do": "task", "what the change does": "change", "what it changes for users": "users",
                 "what you must decide": "decide"}
SECTIONS = {1: "Coverage", 2: "Tests", 3: "Review", 4: "Merge and ship", 5: "Reports"}
LEVELS = ("unit", "integration", "e2e", "mutation", "property", "regex", "design", "a11y", "query budget", "migration", "manual")
# triage's and the quality log's names for a test type, as a Test types row or a Level cell may give them
LEVEL_ALIASES = {"accessibility": "a11y", "visual": "design", "query-budget": "query budget"}
OTHER_LEVEL = "other"  # any other name: one column, so a report can't widen the matrix without bound
NO_LEVEL = "level not recorded"
LENS_COLUMNS = ("Lens", "What it checks", "Model", "Findings", "Confirmed", "Outcomes")
SHIP_SECTIONS = (("deploy", "Deploy"), ("smoke", "Smoke checks"), ("rollback", "Rollback"), ("installed", "Installed on this machine"))
ANNEXES = (("spec", "Spec"), ("decision-notes", "Decision notes"), ("pr-body", "PR body"), ("verify", "Verify report"),
           ("review", "Review report"), ("validation", "Validation report"), ("checks-guide", "Checks guide"),
           ("follow-pr", "Follow-pr report"))
REVIEW_OUTCOMES = ("Fixed", "Rejected", "Pre-existing", "Open", "Not run")
RESULTS = ("PASS", "FAIL", "NOT RUN")
MAKERS = {"spec": "the kit-spec skill writes it", "decision-notes": "kit-ship writes them before it generates this page",
          "pr-body": "kit-ship writes it when it opens the pull request", "verify": "the stop hook's verify writes it",
          "review": "the kit-review skill writes it", "validation": "the kit-validate skill writes it",
          "checks-guide": "the kit-validate skill writes it", "follow-pr": "the kit-follow-pr skill writes it"}


def esc(text):
    return html.escape(CONTROL.sub("�", text), quote=True)


def file_href(path):
    return "file://" + urllib.parse.quote(path)


def state(word, tone):
    """A state word, set in mono and colored by tone: ok (proven), need (needs the owner), dim (not run, not recorded)."""
    return f'<span class="st {tone}">{esc(word)}</span>'


def result_tone(result):
    return {"PASS": "ok", "FAIL": "need"}.get(result, "dim")


def heading(line, deepest=6):
    """(level, text) of an ATX heading line, or None. Trailing `#`s are stripped in Python: the regex that does it
    backtracks cubically on a long run of spaces."""
    found = re.match(rf"(#{{1,{deepest}}})[ \t]+(.*)$", line)
    if not found:
        return None
    text = found.group(2).rstrip()
    closed = text.rstrip("#")
    if closed != text and (not closed or closed[-1] in " \t"):
        text = closed.rstrip()
    return len(found.group(1)), text


def read_report(path):
    """(text, None), or (None, why) when the report is missing, can't be read or is over REPORT_LIMIT."""
    try:
        with open(path, encoding="utf-8") as fh:
            text = fh.read(REPORT_LIMIT + 1)
        if len(text) > REPORT_LIMIT:
            return None, f"{path} is over the {REPORT_LIMIT // 1024 // 1024} MB a report may have"
        return text.replace("\r\n", "\n"), None
    except FileNotFoundError:
        return None, f"no report at {path}"
    except OSError as error:
        return None, f"can't read {path}: {error.strerror}"
    except UnicodeDecodeError as error:
        return None, f"can't read {path}: not UTF-8 ({error.reason} at byte {error.start})"


class Page:
    """What the page renders with: the evidence directory it may read, the bytes embedded so far, the ids taken."""

    def __init__(self, evidence):
        self.evidence = evidence
        self.root = os.path.realpath(evidence)
        self.embedded = 0
        self.shown = {}  # realpath of a file already embedded: the id of the block that shows it
        self.lines = {}  # realpath of a text file embedded: its lines past bin/evidence's header, the cut middle left out
        self.cut = set()
        self.past = set()  # text files linked, not read, past the total: their steps and results are not on the page  # realpath of a text file whose middle was cut, so its lines are partial
        self.ids = set()
        scripts = os.path.join(evidence, "checks")
        inside = os.path.isdir(scripts) and os.path.realpath(scripts) == os.path.join(self.root, "checks")
        self.scripts = sorted(os.listdir(scripts)) if inside else []  # the kept check scripts, listed once

    def charge(self, *texts):
        """Count the text's UTF-8 bytes toward TOTAL_LIMIT, or count nothing and say False when they don't fit."""
        size = sum(len(text.encode()) for text in texts)
        if self.embedded + size > TOTAL_LIMIT:
            return False
        self.embedded += size
        return True

    def new_id(self, wanted):
        base = re.sub(r"[^A-Za-z0-9_.-]+", "-", wanted).strip("-") or "x"
        found, n = base, 1
        while found in self.ids:
            n += 1
            found = f"{base}-{n}"
        self.ids.add(found)
        return found

    # Files

    def resolve(self, target):
        """(the path as named, its real path when that lies inside the evidence directory, else None)."""
        if target.startswith("file://"):
            target = urllib.parse.unquote(target[len("file://"):])
        named = os.path.expanduser(target)
        named = named if os.path.isabs(named) else os.path.join(self.evidence, named)
        real = os.path.realpath(named)
        return named, real if os.path.commonpath([self.root, real]) == self.root else None

    def file_block(self, named, real):
        """One file a check names: shown, linked, missing, or not read when it lies outside the evidence directory."""
        label = f"<code>{esc(named)}</code>"
        if real is None:
            return f'<div class="file">{label} {state("not read", "dim")} outside the evidence directory</div>'
        if not os.path.exists(real):
            return f'<div class="file">{label} {state("missing", "need")}</div>'
        link = f'<a href="{esc(file_href(real))}">{esc(os.path.basename(real))}</a>'
        if real.lower().endswith(ACTIVE):
            return f'<div class="file">{label} {state("not linked", "dim")} it would run its own scripts; open it yourself</div>'
        if not os.path.isfile(real):
            return f'<div class="file">{link} {state("not read", "dim")} not a regular file</div>'
        if real in self.shown:
            return f'<div class="file">{link} <a href="#{self.shown[real]}">shown above</a></div>'
        size = os.path.getsize(real)
        ext = os.path.splitext(real)[1].lower()
        block_id = self.new_id("file-" + os.path.basename(real))
        if ext in PLAYABLE:
            self.shown[real] = block_id
            return (f'<div class="file video" id="{block_id}"><video controls preload="metadata">'
                    f'<source src="{esc(file_href(real))}" type="{PLAYABLE[ext]}">{link}</video>'
                    f'<p class="name">{link} <span class="size">{size} bytes</span></p></div>')
        if ext in VIDEOS:
            return f'<div class="file" id="{block_id}">{link} {state("linked", "dim")} video, {size} bytes</div>'
        if ext in IMAGES:
            if size > IMAGE_LIMIT or self.embedded + size > TOTAL_LIMIT:
                why = "over 2 MB" if size > IMAGE_LIMIT else "past the 20 MB embedded in total"
                return f'<div class="file" id="{block_id}">{link} {state("linked", "dim")} {why}, {size} bytes</div>'
            with open(real, "rb") as fh:
                data = fh.read(IMAGE_LIMIT + 1)
            if len(data) > IMAGE_LIMIT:
                return f'<div class="file" id="{block_id}">{link} {state("linked", "dim")} over 2 MB</div>'
            self.embedded += len(data)
            self.shown[real] = block_id
            return (f'<figure class="file" id="{block_id}"><img src="data:{IMAGES[ext]};base64,'
                    f'{base64.b64encode(data).decode()}" alt="{esc(os.path.basename(real))}">'
                    f"<figcaption>{link}</figcaption></figure>")
        return self.text_block(real, size, link, block_id)

    def text_block(self, real, size, link, block_id):
        with open(real, "rb") as fh:
            head, tail = fh.read(TEXT_LIMIT + 1), b""
            if len(head) > TEXT_LIMIT:  # the head and the tail, each cut at a line end inside them
                head = head[:TEXT_LIMIT // 2]
                head = head[:head.rfind(b"\n") + 1] or head
                fh.seek(max(size, TEXT_LIMIT + 1) - TEXT_LIMIT // 2)
                tail = fh.read(TEXT_LIMIT // 2)
                start = tail.find(b"\n")
                tail = tail[start + 1:] if 0 <= start < len(tail) - 1 else tail
        if b"\0" in head[:8192]:
            return f'<div class="file" id="{block_id}">{link} {state("linked", "dim")} binary, {size} bytes</div>'
        if self.embedded + len(head) + len(tail) > TOTAL_LIMIT:
            self.past.add(real)
            return f'<div class="file" id="{block_id}">{link} {state("linked", "dim")} past the 20 MB embedded in total</div>'
        self.embedded += len(head) + len(tail)
        self.shown[real] = block_id
        body = head.decode(errors="replace").replace("\r\n", "\n")
        fields = ""
        lines = body.split("\n")
        if lines[0].startswith("$ ") and len(lines) > 1 and review_stamp.EVIDENCE_IN_LINE.fullmatch(lines[1]):
            lines[0], lines[1] = lines[1], lines[0]  # before the commit and tree, bin/evidence wrote `$ ` first
        ran = review_stamp.EVIDENCE_IN_LINE.fullmatch(lines[0])
        if ran:  # bin/evidence's header: `# in`, maybe `# fingerprint`, `$ command`, a blank line
            rest = lines[1:]
            if rest and rest[0].startswith("# fingerprint "):
                rest = rest[1:]
            command = rest[0][2:] if rest and rest[0].startswith("$ ") else None
            rest = rest[1:] if command is not None else rest
            rest = rest[1:] if rest and not rest[0].strip() else rest
            pairs = [("Command", command), ("Directory", ran.group("dir")), ("Time", ran.group("time")),
                     ("Exit", ran.group("exit")),
                     ("Commit", (ran.group("commit") or "") + (" with uncommitted changes" if ran.group("uncommitted") else "")),
                     ("Tree", ran.group("tree"))]
            fields = '<dl class="fields">' + "".join(
                f"<dt>{name}</dt><dd>{'<code>' + esc(value) + '</code>' if value else state('not recorded', 'dim')}</dd>"
                for name, value in pairs) + "</dl>"
            body = "\n".join(rest)
        lines = body.rstrip("\n").split("\n") if body.strip("\n") else []
        tail_lines = tail.decode(errors="replace").replace("\r\n", "\n").rstrip("\n").split("\n") if tail else []
        self.lines[real] = lines + tail_lines
        if tail:
            self.cut.add(real)
        last = tail_lines if tail else lines  # the visible tail never spans the cut
        earlier = last[:-TAIL_LINES]
        fold = ""
        if tail or earlier:
            cut = (f'<pre class="out">{esc(chr(10).join(lines))}</pre><p class="cut">{state("cut", "dim")} '
                   f"{size - len(head) - len(tail)} of {size} bytes cut from the middle; the full file: {link}</p>" if tail else "")
            count = len(lines) + len(earlier) if tail else len(earlier)
            fold = (f'<details class="earlier"><summary>{count} earlier line{"s" * (count != 1)}'
                    f'{", the middle cut" if tail else ""}</summary>{cut}'
                    + (f'<pre class="out">{esc(chr(10).join(earlier))}</pre>' if earlier else "") + "</details>")
        return (f'<div class="file text" id="{block_id}"><p class="name">{link} <span class="size">{size} bytes</span></p>'
                f'{fields}<pre class="out tail">{esc(chr(10).join(last[-TAIL_LINES:]))}</pre>{fold}</div>')

    # Markdown, a safe subset: headings, fenced blocks, tables, lists, paragraphs, code spans, bold and links

    def inline(self, text, links=True):
        """Code spans, bold and links; with links off (inside a <summary>, which can't hold one) a link is its label."""
        out, at = [], 0
        text = text.replace("\\|", "|")
        for found in INLINE.finditer(text):
            out.append(esc(text[at:found.start()]))
            at = found.end()
            code, bold, label, target = found.groups()
            if code is not None:
                out.append(f"<code>{esc(code)}</code>")
            elif bold is not None:
                out.append(f"<strong>{self.inline(bold, links)}</strong>")
            elif links:
                out.append(self.link(found.group(0), label, target.strip()))
            else:
                out.append(esc(label or target))
        out.append(esc(text[at:]))
        return "".join(out)

    def link(self, source, label, target):
        """A link to a file of the evidence directory; anything else (another scheme, a path outside) stays its text."""
        if re.match(r"[A-Za-z][A-Za-z0-9+.-]*:", target) and not target.startswith("file://"):
            return esc(source)
        _, real = self.resolve(target)
        if real is None or not os.path.exists(real) or real.lower().endswith(ACTIVE):
            return f"{esc(label)} <code>{esc(target)}</code>" if label else esc(source)
        return f'<a href="{esc(file_href(real))}">{esc(label or os.path.basename(real))}</a>'

    def markdown(self, text, prefix, top=3, figure=False):
        """Blocks of Markdown: the shallowest heading becomes h(top), a deeper one one level further each, capped at h6."""
        out, para, items, lines, i = [], [], [], text.split("\n"), 0
        list_indent = 0  # the first item's indentation: a deeper item is nested under the item before it

        def flush():
            if para:
                out.append(f"<p>{self.inline(chr(10).join(para))}</p>")
                para.clear()
            if items:
                html, nested = [], []
                for ordered, deep, body in items + [(False, False, None)]:
                    if not deep and nested:
                        tag = "ol" if nested[0][0] else "ul"
                        html[-1] = html[-1][:-len("</li>")] + f"<{tag}>" + "".join(
                            f"<li>{self.inline(b)}</li>" for _, _, b in nested) + f"</{tag}></li>"
                        nested.clear()
                    if deep:
                        nested.append((ordered, deep, body))
                    elif body is not None:
                        html.append(f"<li>{self.inline(body)}</li>")
                tag = "ol" if items[0][0] else "ul"
                out.append(f"<{tag}>" + "".join(html) + f"</{tag}>")
                items.clear()

        fenced, depths = False, []
        for line in lines:  # a shell comment inside a fence is not a heading
            if re.match(r"\s*(```|~~~)", line):
                fenced = not fenced
            elif not fenced and heading(line):
                depths.append(heading(line)[0])
        shallowest = min(depths, default=1)
        while i < len(lines):
            line = lines[i]
            fence = re.match(r"\s*(```+|~~~+)", line)
            title = heading(line)
            item = re.match(r"(\s*)([-*+]|\d+[.)])\s+(.*)$", line)
            cells = review_stamp.table_cells(line)
            if fence:
                flush()
                end = next((j for j in range(i + 1, len(lines)) if lines[j].strip().startswith(fence.group(1))), len(lines))
                body = lines[i + 1:end]
                if figure:  # one block per line, so a wrapped relation hangs under its own start on a phone
                    out.append('<figure><pre class="cmd"><code>' + "".join(f'<span class="ln">{esc(ln) or " "}</span>' for ln in body)
                               + "</code></pre></figure>")
                else:
                    out.append(f'<pre class="cmd"><code>{esc(chr(10).join(body))}</code></pre>')
                i = end + 1
                continue
            if title:
                flush()
                level = min(6, top + title[0] - shallowest)
                step = re.match(review_stamp.GUIDE_STEP, title[1])
                anchor = self.new_id(f"{prefix}-{step.group(1) if step else title[1].lower()}")
                out.append(f'<h{level} id="{anchor}">{self.inline(title[1])}</h{level}>')
            elif cells and i + 1 < len(lines) and TABLE_RULE.match(lines[i + 1]):
                flush()
                rows = []
                j = i + 2
                while j < len(lines) and review_stamp.table_cells(lines[j]):
                    rows.append(review_stamp.table_cells(lines[j]))
                    j += 1
                out.append(self.table(cells, rows))
                i = j
                continue
            elif item:
                if para:
                    flush()
                if not items:
                    list_indent = len(item.group(1))
                items.append([item.group(2)[0].isdigit(), bool(items) and len(item.group(1)) > list_indent, item.group(3)])
            elif not line.strip():
                flush()
            elif items and line.startswith((" ", "\t")):
                items[-1][2] += "\n" + line.strip()
            else:
                if items:
                    flush()
                para.append(line)
            i += 1
        flush()
        return "".join(out)

    def table(self, header, rows):
        head = "".join(f'<th scope="col">{self.inline(c)}</th>' for c in header)
        body = "".join("<tr>" + "".join(f"<td>{self.inline(c)}</td>" for c in row) + "</tr>" for row in rows)
        name = esc("Table: " + ", ".join(header))
        return f'<div class="table" tabindex="0" role="region" aria-label="{name}"><table><thead><tr>{head}</tr></thead><tbody>{body}</tbody></table></div>'


# Sources

def outside_fences(text):
    """Each line of text with whether it is a fence line or inside a fenced block, where a `#` line is no heading."""
    fenced = False
    for line in text.split("\n"):
        if re.match(r"\s*(```|~~~)", line):
            fenced = not fenced
            yield line, True
        else:
            yield line, fenced


def notes_by_section(text):
    """{section key: the notes' Markdown under its heading}."""
    found, current = {}, None
    for line, fenced in outside_fences(text):
        title = not fenced and heading(line, 3)
        if title and title[1].lower() in NOTE_SECTIONS:
            current = NOTE_SECTIONS[title[1].lower()]
            found[current] = []
        elif current:
            found[current].append(line)
    return {n: "\n".join(lines).strip() for n, lines in found.items()}


def first_paragraph(text):
    """The first paragraph of prose, past any leading headings and HTML comments a PR template puts first."""
    text = re.sub(r"<!--.*?(-->|$)", "", text, flags=re.S)
    lines = []
    for line in text.strip().split("\n"):
        if not line.strip() or heading(line) and not lines:
            if lines:
                break
            continue
        lines.append(line)
    return "\n".join(lines)


def parse_review(text):
    """(header line or None, {header field: value}, [(outcome, label, entry, line number)]), or None when the text
    holds neither a review header nor any entry."""
    lines = text.split("\n")
    header = next((re.sub(r"^#+[ \t]+", "", line.strip()) for line in lines
                   if re.match(r"(?:#+[ \t]+)?(Self-review|Review)( \(|$)", line)), None)
    labels = "|".join(re.escape(o) for o in REVIEW_OUTCOMES)
    entries = []
    starts = {}  # each line's text after its label or bullet, to its first line number
    for n, l in enumerate(lines, 1):
        bullet = re.match(r"[ \t]*[-*][ \t]+(.*)$", l)
        starts.setdefault((bullet.group(1) if bullet else l.partition(":")[2]).strip(), n)
    for label, entry in pr_validation.labelled(text, rf"(?:{labels})(?: \([^)\n]*\))?"):
        line = starts.get(entry.strip())
        entries.append((next(o for o in REVIEW_OUTCOMES if label.startswith(o)), label, entry, line))
    if header is None and not entries:
        return None
    fields = {}
    inside = re.match(r"(Self-review|Review) \((.*)\)\s*$", header or "")
    for part in inside.group(2).split(";") if inside else ():
        key, _, value = part.partition(":")
        fields[key.strip().lower()] = value.strip()
    return header, fields, entries


def check_rows(text):
    """[{id, result, check, ac, acs, ac_column, case, expected (None without the column), observed, line, group, level
    (None without the column)}] in report order."""
    lines = text.split("\n")
    rows = []
    groups, group = [], ""  # each line's `## ` section
    for line in lines:
        group = line[3:].strip() if line.startswith("## ") else group
        groups.append(group)
    for index, names, cells, result in review_stamp.result_table(lines):
        group = groups[index]

        def cell(name, prefix=False):
            at = next((i for i, n in enumerate(names) if (n.startswith(name) if prefix else n == name)), None)
            return None if at is None else (cells[at] if at < len(cells) else "")
        ac = cell("AC")
        rows.append({"id": cells[0].strip("*_ "), "result": result, "check": cell("Check") or "", "ac": ac or "",
                     "acs": [int(n) for n in re.findall(r"\bAC(\d+)\b", ac or "")], "ac_column": ac is not None, "case": cell("Case", True) or "",
                     "expected": cell("Expected", True), "observed": cell("Evidence") or "", "line": index + 1,
                     "group": group, "level": (cell("Level") or "").strip("*_` ").lower() or None})
    return rows


def named_files(page, row):
    """(path as named, real path inside the evidence directory or None) for each file the row's Evidence cell names,
    then the check's kept script from checks/."""
    cell, found = row["observed"], []
    for link in INLINE.finditer(cell):
        target = (link.group(4) or "").strip()
        if link.group(4) is not None and not (re.match(r"[A-Za-z][A-Za-z0-9+.-]*:", target) and not target.startswith("file://")):
            found.append(page.resolve(target))
    # A code span or bold text names its files on purpose; a word in the prose ("took ~3s", "GET /api/x 200",
    # "README.md updated") counts only when that file exists.
    spans = " ".join(m.group(1) or m.group(2) for m in INLINE.finditer(cell) if m.group(4) is None)
    prose = INLINE.sub(" ", cell)
    exists = lambda token: os.path.lexists(os.path.join(page.evidence, os.path.expanduser(token)))
    for text, named_on_purpose in ((spans, True), (prose, False)):
        found += [page.resolve(token) for token in PATH_TOKEN.findall(text) + FILE_TOKEN.findall(text)
                  if named_on_purpose or exists(token)]
    found += [page.resolve(os.path.join(page.evidence, "checks", name)) for name in page.scripts
              if name.startswith(row["id"] + ".")]
    unique, seen = [], set()
    for named, real in found:
        key = real or named
        if key not in seen:
            seen.add(key)
            unique.append((named, real))
    return unique


def follow_pr_pending(text):
    """The CI checks the follow-pr report's latest run leaves pending, the comments every run left pending (a reply
    drafted or a question to the user, until a later line for the same id says otherwise), and the latest Status when
    it isn't ready to merge."""
    runs = re.split(r"^## Run\b", text, flags=re.M)
    last = runs[-1] if len(runs) > 1 else text
    comments = {}  # a comment is recorded once, in the run that handled it, and again only when its outcome changes
    for line in text.split("\n"):
        parts = [p.strip() for p in line.split(" — ")]
        if len(parts) >= 3 and not line.startswith(("CI:", "Status:")):
            comments[line.split()[0]] = line.strip() if re.match(r"(reply drafted|asked the user)\b", parts[-1], re.I) else None
    pending = []
    for line in last.split("\n"):
        ci = re.match(r"CI:\s*(.+)$", line)
        if ci and re.search(r":\s*pending\b", ci.group(1)):
            pending.append(f"CI {ci.group(1).strip()}")
    pending += [line for line in comments.values() if line]
    for line in last.split("\n"):
        status = re.match(r"Status:\s*(.+)$", line)
        if status and not status.group(1).strip().lower().startswith("ready to merge"):
            pending.append(f"Status: {status.group(1).strip()}")
    return pending


def pull_request():
    """(the PR's fields, None), (None, None) when the branch has no PR, or (None, why gh couldn't say)."""
    try:
        out = subprocess.run(["gh", "pr", "view", "--json", "number,url,title,headRefOid,state,mergeCommit"], capture_output=True,
                             text=True, timeout=GH_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired) as error:
        return None, f"gh pr view: {error}"
    if out.returncode:
        if "no pull requests found" in out.stderr:
            return None, None
        return None, "gh pr view: " + ((out.stderr.strip().splitlines() or [f"exit {out.returncode}"])[-1])
    try:
        pr = json.loads(out.stdout)
        if not (isinstance(pr.get("number"), int) and re.fullmatch(r"[0-9a-f]{40,64}", pr.get("headRefOid") or "")):
            raise ValueError(f"unexpected answer: {out.stdout.strip()[:200]}")
    except (ValueError, AttributeError) as error:
        return None, f"gh pr view: {error}"
    return pr, None


def ci_state(pr, pr_error, off):
    """(word, tone, detail) for the CI of the PR's head commit only."""
    if "ci" in off:
        return "CI phase off", "dim", ""
    if pr_error:
        return "unknown", "need", pr_error
    if not pr:
        return "no PR yet", "dim", ""
    head = pr["headRefOid"]
    try:
        checks = ci_wait.checks(head)
    except ci_wait.Unreadable as error:
        return "unknown", "need", f"GitHub couldn't be read for {head}: {error}"
    if not checks:
        if ci_wait.runs_no_ci(head):
            return "no CI", "dim", "the repository runs no CI"
        return "missing", "need", f"no checks for {head}"
    failed = [name for name, check, _ in checks if ci_wait.failed(check)]
    running = [name for name, check, _ in checks if ci_wait.running(check)]
    names = ", ".join(f"{name}: {check}" for name, check, _ in checks)
    if failed:
        return "FAIL", "need", f"on {head}: {names}"
    if running:
        return "pending", "need", f"on {head}: {names}"
    return "PASS", "ok", f"on {head}: {names}"


QUIET = ("phase off", "not needed")  # states that ask nothing of the reader


def stamp_tone(word):
    return "ok" if word == "current" else "dim" if word in QUIET else "need"


def stamp_state(kind, phase, off, needed=True):
    if phase in off:
        return "phase off"
    if not needed:
        return "not needed"
    if review_stamp.stamp_matches(kind, review_stamp.fingerprint_for(kind)):
        return "current"
    stamps = (review_stamp.stamp_path(kind), review_stamp.legacy_stamp_path(kind))
    return "stale" if any(os.path.exists(path) for path in stamps) else "missing"


def changed_files(base):
    """{top-level directory: [(path, added, removed)]} of the change against its base, the working tree's included."""
    counted = []
    for entry in review_stamp.git_checked("diff", "--numstat", "-z", "--no-renames", base).split(b"\0"):
        if entry:
            added, removed, path = os.fsdecode(entry).split("\t", 2)
            counted.append((path, added, removed))
    counted += [(path, "new", "0") for path in review_stamp.git_paths("ls-files", "--others", "--exclude-standard")]
    groups = {}
    for path, added, removed in counted:
        top = path.split("/", 1)[0] + "/" if "/" in path else "(top level)"
        groups.setdefault(top, []).append((path, added, removed))
    return groups


def section_table(text, title, columns):
    """[{column: cell}] of the first table under the `## <title>` heading, in any case as the stamp reads it, the columns
    lowercased, or None without one."""
    body, inside = [], False
    for line, fenced in outside_fences(text):
        level = not fenced and heading(line, 2)
        if level and level[0] == 2:
            if inside:
                break
            inside = level[1].lower() == title.lower()
        elif inside and not fenced:
            body.append(line)
    names, rows = None, []
    for line in body:
        cells = review_stamp.table_cells(line)
        if not cells:
            if names:
                break
            continue
        if TABLE_RULE.match(line):
            continue
        if names is None:
            names = [c.strip("*_ ").lower() for c in cells]
            continue
        rows.append({c: cells[names.index(c)] if c in names and names.index(c) < len(cells) else "" for c in columns})
    return rows if names else None


def output_lines(lines):
    """(steps, result lines, runner tests) of one output: its `precondition:` and `step:` lines, its `PASS` and `FAIL`
    lines, and [(section, name, "ok" or "FAIL")] of a test runner's lines, which count only after a `== <section>` line."""
    steps, said, tests, section = [], [], [], None
    for line in lines:
        bare = line.strip()
        runner = re.match(r"(ok|FAIL) +(\S.*)", line.rstrip()) if section is not None else None
        if line.startswith("== "):
            section = line[3:].strip()
        elif runner:
            tests.append((section, runner.group(2), runner.group(1)))
        elif re.match(r"(precondition|step):\s*\S", bare):
            steps.append(bare)
        elif re.match(r"(PASS|FAIL)\b", bare):
            said.append(bare)
    return steps, said, tests


def note_items(text):
    """The decide section's top-level list items, each with its nested lines, or its paragraphs when it has no list."""
    items, paragraphs, para = [], [], []
    for line in text.split("\n") + [""]:
        item = re.match(r"([-*+]|\d+[.)])\s+(.*)$", line)
        if item:
            items.append(item.group(2).strip())
        elif items and line.strip() and line.startswith((" ", "\t")):
            items[-1] += "\n" + re.sub(r"^([-*+]|\d+[.)])\s+", "", line.strip())
        elif line.strip() and not heading(line):
            para.append(line.strip())
        elif para:
            paragraphs.append(" ".join(para))
            para = []
    return items or paragraphs


def split_first(text):
    """(the first paragraph, the rest) of a notes section."""
    text = re.sub(r"<!--.*?(-->|$)", "", text, flags=re.S)  # as first_paragraph does, so the paragraph is found in it
    first = first_paragraph(text)
    at = text.find(first) if first else -1
    return first, (text[at + len(first):].strip() if at >= 0 else text.strip())


def ship_sections(text):
    """{`## ` heading, lowercased: its body} of ship.md."""
    found, current = {}, None
    for line, fenced in outside_fences(text):
        title = not fenced and heading(line, 2)
        if title and title[0] == 2:
            current = title[1].strip().lower()
            found[current] = []
        elif current is not None:
            found[current].append(line)
    return {name: "\n".join(lines).strip() for name, lines in found.items()}


def lens_briefs():
    """({lens, lowercased: the sentence under its heading in the review's lenses.md, by its heading and by triage's
    name}, why it couldn't be read or None). A missing lenses.md gives no briefs and no why: the names show alone."""
    text, why = read_report(os.path.join(HERE, "..", "skills", "kit-review", "lenses.md"))
    briefs = {m.group(1).strip().lower(): m.group(2).strip() for m in re.finditer(r"^## (.+)\n\n(.+)$", text or "", re.M)}
    briefs.update({key: briefs[title.lower()] for key, title in triage.LENS_TITLES.items() if title.lower() in briefs})
    return briefs, None if why and why.startswith("no report") else why


def test_level(name):
    """The test level a Level cell or a Test types row names, from LEVELS, OTHER_LEVEL or NO_LEVEL."""
    name = name.strip("*_` \t").lower()
    if not name:
        return NO_LEVEL
    word = re.match(r"[a-z0-9-]+(?: budget)?", name)
    word = LEVEL_ALIASES.get(word.group(0), word.group(0)) if word else ""
    return next((level for level in LEVELS if word == level or name.startswith(level + " ") or
                 word.startswith(level + "-")), OTHER_LEVEL)


# Rendering

CASE_WORDS = {"+": "positive case", "-": "negative case", "−": "negative case"}


def not_recorded(kind, path):
    return (f'<p class="absent">{state("not recorded", "dim")} {esc(MAKERS[kind])} at <code>{esc(path)}</code></p>')


def unavailable(why):
    return f'<p class="absent">{state("unavailable", "need")} {esc(why)}</p>'


def level_id(level):
    return "level-" + ("not-recorded" if level == NO_LEVEL else re.sub(r"[^a-z0-9]+", "-", level).strip("-"))


def build(page_path, evidence):
    page = Page(evidence)
    page.ids.update({"main", "summary", "h00", "footer", "environment"})
    off, phases_error = phase_switches.phases_off_or_error(os.getcwd())
    kinds = ("decision-notes", "pr-body", "verify", "review", "validation", "checks-guide", "follow-pr")
    paths = dict(zip(kinds, review_stamp.report_paths(*kinds)))
    texts, whys = {}, {}
    for kind in kinds:
        texts[kind], whys[kind] = read_report(paths[kind])
    spec_path, criteria, spec_why = review_stamp.spec_criteria()
    spec_text, spec_read_why = read_report(spec_path) if spec_path else (None, spec_why)
    spec_path = spec_path or "the spec"
    goal = re.search(r"^Goal:\s*(.+)$", spec_text or "", re.M)
    spec_title = re.search(r"^# (.+)$", spec_text or "", re.M)
    notes = notes_by_section(texts["decision-notes"]) if texts["decision-notes"] is not None else None
    ship_path = os.path.join(os.path.expanduser("~/.agents/repos"), review_stamp.repo_name(), "ship.md")
    ship_text, ship_why = read_report(ship_path)

    branch = review_stamp.git("branch", "--show-current")
    head = review_stamp.git("rev-parse", "--verify", "--quiet", "HEAD") or "no commit yet"
    tree = review_stamp.working_tree()
    base = review_stamp.merge_base()
    base_ref = review_stamp.branch_base()[0]
    pr, pr_error = pull_request()
    ci_word, ci_tone, ci_detail = ci_state(pr, pr_error, off)
    validate_needed = any(not review_stamp.NOT_BEHAVIOR.search(p) for p in review_stamp.changed_paths()[1])
    stamps = {"review": stamp_state("review", "review", off),
              "validate": stamp_state("validate", "validate", off, validate_needed)}
    now = datetime.datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %z")

    # Verify
    verify_word, verify_line = None, None
    if "verify" in off:
        verify_word, verify_line = "phase off", "phase off"
    elif texts["verify"] is not None:
        verdict = re.search(r"^# Verify: (.+)$", texts["verify"], re.M)
        words = verdict.group(1).strip().rstrip(".,") if verdict else ""
        if words:
            verify_word = "checked nothing" if words.startswith("PASS, but nothing") else words.split()[0].rstrip(",")
            verify_line = pr_validation.verify_line(texts["verify"])[0][len("- Verify: "):]
        else:
            whys["verify"] = f"{paths['verify']} has no `# Verify:` verdict"

    # Review
    review = None
    if "review" not in off and texts["review"] is not None:
        review = parse_review(texts["review"])
        if review is None:
            whys["review"] = f"{paths['review']} has no Review line and no Fixed, Rejected, Pre-existing, Open or Not run entry"

    # Validation
    rows = []
    if "validate" not in off and texts["validation"] is not None:
        rows = check_rows(texts["validation"])
        if not rows:
            whys["validation"] = f"{paths['validation']} has no PASS, FAIL or NOT RUN row in a table with Result and Evidence columns"
    validation_ok = "validate" not in off and texts["validation"] is not None and rows
    pre_pr_a = validation_ok and all(row["expected"] is None for row in rows)
    test_types = (section_table(texts["validation"], "Test types", ("type", "ran", "evidence")) or []) if validation_ok else []
    type_of = {}  # a check id a Test types row's Evidence names: that row's level, the first row winning
    for t in test_types:
        for word in re.findall(r"[A-Za-z0-9_]+", t["evidence"]):
            type_of.setdefault(word, test_level(t["type"]))
    rows_at = {}
    for row in rows:
        row["anchor"] = page.new_id(f"check-{row['id']}")
        row["level"] = test_level(row["level"] or "")
        if row["level"] == NO_LEVEL:
            row["level"] = type_of.get(row["id"], NO_LEVEL)
        rows_at.setdefault(row["level"], []).append(row)
    levels = [level for level in LEVELS + (OTHER_LEVEL, NO_LEVEL) if level in rows_at]
    stale_problems, stale_warnings = (review_stamp.stale_evidence(texts["validation"].split("\n"), evidence)
                                      if validation_ok else ([], []))

    # The copies of report text shown outside the annexes: the summary's notes, the decide items again in Merge and ship,
    # the review's findings and its Open ones twice more, the checks, the ship steps. Each source is under REPORT_LIMIT,
    # so they fit in the total before any evidence, and the evidence and annexes after them fall back to links.
    notes_decide = (notes or {}).get("decide") or ""
    page.charge(texts["decision-notes"] or "", notes_decide, texts["review"] or "", texts["review"] or "",
                texts["validation"] or "", ship_text or "", texts["checks-guide"] or "", texts["pr-body"] or "")

    def source_state(kind, phase):
        """The state word for a source report: phase off, or unavailable with the reason, or None when it was read."""
        if phase in off:
            return "phase off"
        if kind == "validation" and not validate_needed and texts["validation"] is None:
            return "not needed"
        if kind == "verify" and verify_word is None or kind == "review" and review is None or \
                kind == "validation" and not validation_ok:
            return "unavailable: " + whys[kind]
        return None

    def source_html(kind, phase):
        why = source_state(kind, phase)
        return state(why.split(": ")[0], "dim") if why in QUIET else f'{state("unavailable", "need")} {esc(why[len("unavailable: "):])}'

    # The criteria each test is named in, by a spec `verify:` that names it in backticks
    named_in = {}
    for item in criteria or []:
        number, verify = re.match(r"(\d+)\.", item), item.partition("verify:")[2]
        for name in re.findall(r"`([^`\n]+)`", verify) if number else ():
            named_in.setdefault(name.strip(), []).append(int(number.group(1)))

    # Tests: each check's row, built first so the lists know which files are missing
    missing_files = {}
    check_items = {}
    scripts = os.path.join(page.root, "checks")
    outputs = {}  # realpath of a text output: its (steps, result lines, runner tests), and the row that lists its tests
    for row in rows:
        blocks, steps, said, tests, partial, listed_in, unread = [], [], [], [], False, [], False
        for named, real in named_files(page, row):
            if real is not None and not os.path.exists(real):
                missing_files.setdefault(row["anchor"], []).append(os.path.basename(named))
            blocks.append(page.file_block(named, real))
            unread = unread or real in page.past
            if real in page.lines and os.path.dirname(real) != scripts:
                if real not in outputs:
                    outputs[real] = (output_lines(page.lines[real]), row)
                (found_steps, found_said, found_tests), owner = outputs[real]
                steps, said = steps + found_steps, said + found_said
                if owner is row and found_tests and not any(t is found_tests[0] for t in tests):
                    tests, partial = tests + found_tests, partial or real in page.cut
                elif found_tests and owner is not row:
                    listed_in.append(owner)  # a suite output several checks cite counts its tests once, at its first
        row["tests"] = (len(tests), sum(result == "FAIL" for _, _, result in tests), partial)
        fits = page.charge(*steps, *said, *(section + name for section, name, _ in tests))
        if not fits:
            steps, said, tests = [], [], []
        over = not fits or unread
        runner = "".join(f'<span class="said">runner tests listed under <a href="#{other["anchor"]}"><code>{esc(other["id"])}</code></a></span>'
                         for other in {id(other): other for other in listed_in}.values())
        if tests:
            by_section = {}
            for section, name, result in tests:
                by_section.setdefault(section, []).append((name, result))
            runner += (f'<details class="runner"><summary>{len(tests)} tests from the runner · {row["tests"][1]} FAIL · criteria '
                       f'{esc(row["ac"]) or "none"}' + (" · partial: the log's middle was cut" if partial else "") + "</summary>" + "".join(
                           f'<h4>{esc(section)}</h4><div class="table" tabindex="0" role="region" aria-label="Table: tests in {esc(section)}">'
                           '<table><thead><tr><th scope="col">Test</th><th scope="col">Result</th><th scope="col">Named in</th></tr></thead><tbody>'
                           + "".join(f'<tr><td><code>{esc(name)}</code></td><td>{state(result, "need" if result == "FAIL" else "ok")}</td>'
                                     f'<td>{", ".join(f"AC{n}" for n in named_in.get(name, []))}</td></tr>'
                                     for name, result in at)
                           + "</tbody></table></div>" for section, at in by_section.items()) + "</details>")
        expected = row["expected"]
        check_items[row["anchor"]] = (
            f'<li class="check r-{row["result"].lower().replace(" ", "")}" id="{row["anchor"]}"><details><summary>'
            f'<span class="cid">{esc(row["id"])}</span> {state(row["result"], result_tone(row["result"]))} '
            f'<span class="ac">{esc(row["ac"]) or state("no AC", "dim")}</span> <span class="case">{esc(CASE_WORDS.get(row["case"], row["case"]))}</span> '
            f'<span class="ctext">{page.inline(row["check"], links=False)}</span></summary>'
            '<dl class="row"><dt>Steps</dt><dd>'
            + ("<ol>" + "".join(f"<li>{esc(step)}</li>" for step in steps) + "</ol>" if steps else
               state("linked", "dim") + " past the 20 MB embedded in total: the steps and results are in the evidence below"
               if over else state("not recorded", "dim"))
            + f'</dd><dt>Expected</dt><dd>{page.inline(expected) if expected and expected.strip() else state("not recorded", "dim")}</dd>'
            f'<dt>Actual</dt><dd>{page.inline(row["observed"]) or state("not recorded", "dim")}'
            + "".join(f'<span class="said">{esc(line)}</span>' for line in said) + runner
            + f'</dd><dt>Evidence</dt><dd>{"".join(blocks) or state("no evidence named", "dim")}</dd>'
            f'<dt>Source</dt><dd><code>{esc(paths["validation"])}:{row["line"]}</code></dd></dl></details></li>')

    counts = {result: sum(row["result"] == result for row in rows) for result in RESULTS}
    review_counts = {o: sum(e[0] == o for e in review[2]) for o in REVIEW_OUTCOMES} if review else None
    guide = review_stamp.guide_steps(texts["checks-guide"]) if "validate" not in off and texts["checks-guide"] is not None else {}
    environment = os.path.join(evidence, review_stamp.ENVIRONMENT_RECORD)

    # Blockers the agent owns: (link, text, the section that holds it or None)
    blockers = []
    for kind, phase, label, number in (("verify", "verify", "Verify report", 5), ("review", "review", "Review report", 3),
                                       ("validation", "validate", "Validation report", 2)):
        why = source_state(kind, phase)
        if why and why not in QUIET:
            blockers.append((f"#annex-{kind}", f"{label}: {state('unavailable', 'need')} {esc(why[len('unavailable: '):])}", number))
    for kind, label in (("checks-guide", "Checks guide"), ("follow-pr", "Follow-pr report"),
                        ("decision-notes", "Decision notes"), ("pr-body", "PR description")):
        if texts[kind] is None and not whys[kind].startswith("no report") and not (kind == "checks-guide" and "validate" in off):
            blockers.append((f"#annex-{kind}", f"{label}: {state('unavailable', 'need')} {esc(whys[kind])}", 5))
    if ship_text is None and not ship_why.startswith("no report"):
        blockers.append(("#ship-steps", f"Ship steps: {state('unavailable', 'need')} {esc(ship_why)}", 4))
    briefs, briefs_why = lens_briefs()
    if briefs_why:
        blockers.append(("#review-lenses", f"Lens descriptions: {state('unavailable', 'need')} {esc(briefs_why)}", 3))
    if spec_text is None and spec_read_why and not spec_read_why.startswith("no report"):
        blockers.append(("#annex-spec", f"Spec: {state('unavailable', 'need')} {esc(spec_read_why)}", 5))
    if verify_word and verify_word not in ("PASS", "phase off"):
        blockers.append(("#annex-verify", f"Verify: {state(verify_word, 'need')} {esc(verify_line)}", 5))
    if ci_word not in ("PASS", "no PR yet", "CI phase off", "no CI"):
        blockers.append(("#footer", f"CI for the PR head: {state(ci_word, 'need')} {esc(ci_detail)}", None))
    if pr and head != pr["headRefOid"]:
        blockers.append(("#footer", f"Local HEAD <code>{esc(head)}</code> differs from the PR head <code>{esc(pr['headRefOid'])}</code>", None))
    for kind, word in stamps.items():
        if word in ("stale", "missing"):
            blockers.append(("#sum-gates", f"The {kind} stamp: {state(word, 'need')}", None))
    for row in rows:
        if row["result"] == "FAIL":
            blockers.append((f"#{row['anchor']}", f"<code>{esc(row['id'])}</code> {state('FAIL', 'need')} {page.inline(row['check'])}", 2))
    for row in rows:
        for name in missing_files.get(row["anchor"], []):
            blockers.append((f"#{row['anchor']}", f"<code>{esc(row['id'])}</code> names <code>{esc(name)}</code>: "
                                                  f"{state('missing', 'need')}", 2))
    fresh = [(page.new_id("fresh"), "stale", problem) for problem in stale_problems] + \
            [(page.new_id("fresh"), "freshness warning", warning) for warning in stale_warnings]
    for anchor, word, message in fresh[:len(stale_problems)]:
        blockers.append((f"#{anchor}", f"{state(word, 'need')} {esc(message)}", 2))
    if validation_ok and not pre_pr_a and not os.path.isfile(environment):
        blockers.append(("#environment", f"<code>{esc(environment)}</code>: {state('missing', 'need')}", 2))
    for step, info in guide.items():
        if info["result"] == "FAIL":
            named = f"{step} {info['name']}".strip()
            blockers.append((f"#guide-{step}", f"<code>{esc(named)}</code>: {state('FAIL', 'need')}{esc(info['date'])}", 5))
    if phases_error:
        blockers.append(("#footer", f"Phase switches: {state('unavailable', 'need')} {esc(phases_error)}", None))

    # Coverage: one row per criterion, one column per level
    criteria_rows, uncovered = [], []
    ac_known = validation_ok and any(row["ac_column"] for row in rows)
    columns = levels if ac_known else ["Checks"]
    for item in criteria or []:
        number = re.match(r"(\d+)\.\s*(.*)", item)
        n = int(number.group(1))
        covering = [row for row in rows if n in row["acs"]]
        cells = []
        if not validation_ok:
            why = (source_state("validation", "validate") or "not recorded").split(":")[0]
            cells = [state(why, "dim" if why in QUIET or why == "not recorded" else "need")]  # the reason is in 02
        elif not ac_known:
            cells = [state("not recorded", "dim") + " the validation tables have no AC column"]
        elif not covering:
            uncovered.append(n)
            blockers.append((f"#ac-{n}", f"AC{n} {page.inline(number.group(2))}: {state('no check', 'need')}", 1))
        else:
            cells = [" ".join(f'<a href="#{row["anchor"]}"><code>{esc(row["id"])}</code></a> {state(row["result"], result_tone(row["result"]))}'
                              for row in covering if row["level"] == level) or "—" for level in levels]
        # Explicit roles: the phone layout makes the cells blocks, which drops their table semantics.
        checks = (f'<td role="cell" colspan="{max(len(columns), 1)}" data-label="Checks">{state("no check", "need")}</td>' if not cells else
                  "".join(f'<td role="cell" data-label="{esc(column)}">{cell}</td>' for column, cell in zip(columns, cells)))
        criteria_rows.append(f'<tr role="row" id="ac-{n}"><th role="rowheader" scope="row">{n}</th>'
                             f'<td role="cell">{page.inline(number.group(2))}</td>{checks}</tr>')
    if spec_text is None:
        s1 = not_recorded("spec", spec_path) if not spec_read_why or spec_read_why.startswith("no report") else unavailable(spec_read_why)
    elif criteria_rows:
        s1 = ('<div class="table" tabindex="0" role="region" aria-label="Coverage: criteria by test level"><table class="criteria" role="table">'
              '<thead><tr role="row"><th role="columnheader" scope="col">AC</th><th role="columnheader" scope="col">Criterion</th>'
              + "".join(f'<th role="columnheader" scope="col">{esc(column)}</th>' for column in columns)
              + f'</tr></thead><tbody>{"".join(criteria_rows)}</tbody></table></div>')
    else:
        s1 = f'<p>{state("not recorded", "dim")} no numbered acceptance criteria</p>'
    s1_meta = (f'{len(criteria_rows)} criteria · {len(uncovered)} without a check' if criteria_rows and ac_known else
               f'{len(criteria_rows)} criteria · coverage not recorded' if criteria_rows else "not recorded")

    # Your decisions: (link, text)
    decisions = []
    decide = note_items(notes["decide"]) if notes and notes.get("decide") else []
    merge_note = next((item for item in decide if re.match(r"\W*merge\b[*_ ]*:", item, re.I)), None)

    def note_html(item):
        first, *rest = item.split("\n")
        return page.inline(first) + "".join(f'<span class="sub">{page.inline(line)}</span>' for line in rest)
    for item in decide:
        if item is not merge_note:
            decisions.append(("#annex-decision-notes", note_html(item)))
    open_entries = [entry for outcome, _, entry, _ in (review[2] if review else []) if outcome == "Open"]
    if len(open_entries) == 1:
        decisions.append(("#review-open-1", f"Open finding: {page.inline(open_entries[0])}"))
    elif open_entries:
        decisions.append(("#review-open-1", f'<details class="group"><summary>{len(open_entries)} review findings left Open</summary><ol>'
                                            + "".join(f'<li><a href="#review-open-{n}">{page.inline(entry)}</a></li>'
                                                      for n, entry in enumerate(open_entries, 1)) + "</ol></details>"))
    for step, info in guide.items():
        # M0 is the guide's setup (access, exports), not a check to choose
        if step[:1] in ("M", "S") and step not in ("M0", "S0") and info["result"] not in ("PASS", "FAIL"):
            named = f"{step} {info['name']}".strip()
            decisions.append((f"#guide-{step}", f"<code>{esc(named)}</code>: {state('optional', 'dim')} before the merge, "
                                                f"{esc(info['owner'])}"))
    if texts["follow-pr"] is not None:
        for line in follow_pr_pending(texts["follow-pr"]):
            decisions.append(("#annex-follow-pr", f"Follow-pr, pending: {page.inline(line)}"))
    merge = ((note_html(merge_note) if merge_note else f'Merge: {state("recommendation not recorded", "dim")}')
             + f' <span class="meta">· {len(blockers)} blocker{"s" * (len(blockers) != 1)} · CI {state(ci_word, ci_tone)}</span>')
    decisions.insert(0, ("#s04", merge))
    warnings = [(f"#{anchor}", f"{state(word, 'need')} {esc(message)}") for anchor, word, message in fresh[len(stale_problems):]]

    # Tests
    s2 = ""
    if os.path.isfile(environment):
        s2 += f'<h3 id="environment">Environment</h3>{page.file_block(*page.resolve(environment))}'
    elif validation_ok:
        s2 += (f'<p class="absent" id="environment"><span class="k">Environment:</span> '
               f'{state("not recorded", "dim") if pre_pr_a else state("missing", "need")} <code>{esc(environment)}</code></p>')
    if fresh:
        s2 += '<h3>Evidence freshness</h3><ul class="fresh">' + "".join(
            f'<li id="{anchor}">{state(word, "need")} {esc(message)}</li>' for anchor, word, message in fresh) + "</ul>"
    if validation_ok:
        filters = [("all", "All", len(rows))] + [(r.lower().replace(" ", ""), r, counts[r]) for r in RESULTS]
        s2 += ('<div class="filter"><div class="radios" role="group" aria-label="Show checks by result">'
               + "".join(f'<input type="radio" name="result" id="f-{key}"{" checked" if key == "all" else " disabled" if not n else ""}>'
                         f'<label for="f-{key}">{esc(label)} <span class="n">{n}</span></label>' for key, label, n in filters) + "</div>"
               + "".join(f'<h3 id="{page.new_id(level_id(level))}">{esc(level)} <span class="n">'
                         f'{len(rows_at[level])}</span></h3><ol class="checks" role="list">'
                         + "".join(check_items[row["anchor"]] for row in rows_at[level]) + "</ol>"
                         for level in levels) + "</div>")
        s2_meta = " · ".join(f"{r} {counts[r]}" for r in RESULTS)
    else:
        s2 += f'<p>{source_html("validation", "validate")}</p>'
        s2_meta = (source_state("validation", "validate") or "").split(":")[0]

    # Review
    lenses = section_table(texts["review"], "Lenses", ("lens", "model", "findings", "confirmed", "outcomes")) if review else None
    failed_lenses = [lens for lens in lenses or [] if not re.fullmatch(r"\d+", lens["findings"].strip())]
    header_fields = review[1] if review else {}
    model = header_fields.get("cross-model") or header_fields.get("cross-model reading")
    if review:
        s3 = (f'<p class="header"><code>{esc(review[0] or "no Review line")}</code></p><dl class="fields">'
              + "".join(f'<dt>{name}</dt><dd>{esc(header_fields[key]) if header_fields.get(key) else state("not recorded", "dim")}</dd>'
                        for name, key in (("Risk", "risk"), ("Lenses", "lenses"), ("Re-check rounds", "re-check rounds")))
              + f'<dt>Cross-model</dt><dd>{esc(model) if model else state("not recorded", "dim")}</dd></dl>')
        header_lenses = [name.strip() for name in re.split(r",(?![^()]*\))", header_fields.get("lenses") or "") if name.strip()]

        def brief(name):
            if briefs_why:
                return state("unavailable", "need")
            return esc(briefs[name.lower()]) if name.lower() in briefs else state("not recorded", "dim")

        def cell(value):
            return page.inline(value) if value.strip() and value.strip() not in ("—", "-") else state("not recorded", "dim")
        if lenses is not None:
            body = "".join(f'<tr><th scope="row">{esc(lens["lens"])}</th><td>{brief(lens["lens"])}</td><td>{cell(lens["model"])}</td>'
                           + (f'<td>{cell(lens["findings"])}</td>' + f'<td>{state("not recorded", "dim")}</td>' * 2
                              if lens in failed_lenses else
                              f'<td>{cell(lens["findings"])}</td><td>{cell(lens["confirmed"])}</td><td>{cell(lens["outcomes"])}</td>')
                           + "</tr>" for lens in lenses)
        else:
            body = "".join(f'<tr><th scope="row">{esc(name)}</th><td>{brief(name)}</td>'
                           + f'<td>{state("not recorded", "dim")}</td>' * 4 + "</tr>" for name in header_lenses)
        s3 += ('<h3 id="review-lenses">Lenses</h3>' + ("" if lenses is not None else f'<p>{state("not recorded", "dim")} per-lens counts not recorded: '
                                     "the review report has no Lenses table</p>")
               + f'<div class="table" tabindex="0" role="region" aria-label="Table: {", ".join(LENS_COLUMNS)}"><table><thead><tr>'
               + "".join(f'<th scope="col">{column}</th>' for column in LENS_COLUMNS) + f"</tr></thead><tbody>{body}</tbody></table></div>")
        s3 += "<h3>Findings</h3>"
        for outcome in REVIEW_OUTCOMES:
            entries = [e for e in review[2] if e[0] == outcome]
            anchor = f"review-{outcome.lower().replace(' ', '-')}"
            page.ids.add(anchor)
            listed = "".join(
                f'<li class="entry" id="{anchor}-{n}"><details><summary><span class="lab">{esc(label)}</span> '
                f'{page.inline(entry.split(" — ")[0], links=False)}</summary>'
                + "".join(f'<span class="part">{page.inline(part)}</span>' for part in entry.split(" — ")[1:])
                + (f' <code class="ref">{esc(paths["review"])}:{line}</code>' if line else "") + "</details></li>"
                for n, (_, label, entry, line) in enumerate(entries, 1))
            s3 += (f'<div class="outcome" id="{anchor}"><h4>{esc(outcome)} <span class="n">{len(entries)}</span></h4>'
                   + (f'<ul role="list">{listed}</ul>' if entries else f'<p>{state("none", "dim")}</p>') + "</div>")
        s3_meta = " · ".join(f"{o} {review_counts[o]}" for o in REVIEW_OUTCOMES)
    else:
        s3 = f'<p>{source_html("review", "review")}</p>'
        s3_meta = (source_state("review", "review") or "").split(":")[0]

    # Merge and ship
    s4 = ('<h3>Your decisions</h3><ol class="owned">'
          + "".join(f'<li><span class="owner">you</span> {body}</li>' for _, body in decisions) + "</ol><h3>After the merge</h3>")
    after = [(step, info) for step, info in guide.items() if step.startswith("P")]
    if "validate" in off:
        s4 += f'<p>{state("phase off", "dim")}</p>'
    elif texts["checks-guide"] is None:
        s4 += f'<p>{state("not recorded", "dim") if whys["checks-guide"].startswith("no report") else state("unavailable", "need")} the checks guide</p>'
    elif after:
        s4 += '<ol class="owned">' + "".join(
            f'<li><span class="owner">{esc(info["owner"])}</span> <a href="#guide-{esc(step)}"><code>{esc(step)}</code></a> '
            f'{esc(info["name"])}: {state(info["result"] or "left", result_tone(info["result"] or ""))}{esc(info["date"])}</li>'
            for step, info in after) + "</ol>"
    else:
        s4 += f'<p>{state("none", "dim")} the checks guide has no step after the merge</p>'
    s4 += f'<h3 id="ship-steps">Ship steps</h3><p class="meta">from <code>{esc(ship_path)}</code></p>'
    if ship_text is None:
        s4 += (f'<p class="absent">{state("not recorded", "dim")} no ship steps for this repository</p>' if ship_why.startswith("no report")
               else unavailable(ship_why))
    else:
        found = ship_sections(ship_text)
        merged = (pr.get("mergeCommit") or {}).get("oid") if pr and pr.get("state") == "MERGED" else None
        for key, name in SHIP_SECTIONS:
            body = found.get(name.lower())
            if not body:
                part = f'<p>{state("not recorded", "dim")}</p>'
            else:
                # only in text: a marker inside a tag's attribute (a table's aria-label) would break the tag
                part = "".join(piece if piece.startswith("<") else
                               re.sub(r"\(inferred:", lambda m: f'{state("unconfirmed", "need")} {m.group(0)}', piece)
                               for piece in re.split(r"(<[^>]*>)", page.markdown(body, f"shipmd-{key}", top=5)))
                if re.match(r"[`*_]*unknown\b", body, re.I):
                    part = f'<p>{state("unconfirmed", "need")}</p>{part}'
            if key == "rollback":
                part += (f'<p class="ids">PR #{pr["number"]} · merge commit <code>{esc(merged)}</code></p>' if merged else
                         f'<p class="ids">PR #{pr["number"]} · {state("not merged", "dim")}</p>' if pr else
                         f'<p class="ids">{state("no PR yet", "dim")}</p>')
            s4 += f'<div class="ship" id="ship-{key}"><h4>{name}</h4>{part}</div>'
    s4_meta = f'{len(decisions)} decision{"s" * (len(decisions) != 1)} · {len(after)} step{"s" * (len(after) != 1)} after the merge'

    # Reports, as annexes
    annexes = {"spec": (spec_path, spec_text, spec_read_why)}
    annexes.update({kind: (paths[kind], texts[kind], whys[kind]) for kind in kinds})
    phase_of = {"verify": "verify", "review": "review", "validation": "validate", "checks-guide": "validate"}
    s5 = ""
    for kind, label in ANNEXES:
        path, text, why = annexes[kind]
        if phase_of.get(kind) in off:
            body = f'<p>{state("phase off", "dim")}</p>'
        elif text is None:
            body = (f'<p class="absent">{state("not recorded", "dim")} {esc(MAKERS[kind])}</p>' if not why or why.startswith("no report")
                    else unavailable(why.replace(path, "the file")))
        elif not page.charge(text):
            body = f'<p>{state("linked", "dim")} past the 20 MB embedded in total: <a href="{esc(file_href(path))}">{esc(os.path.basename(path))}</a></p>'
        else:
            body = page.markdown(text, "guide" if kind == "checks-guide" else f"annex-{kind}", top=3)
        s5 += (f'<details class="annex" id="annex-{kind}"><summary>{label} <code>{esc(path)}</code></summary>'
               f'<div class="annex-body">{body}</div></details>')
    groups = changed_files(base)
    dir_rows = "".join(f'<tr><th scope="row">{esc(top)}</th><td>{len(files)}</td>'
                       f'<td>+{sum(int(a) for _, a, _ in files if a.isdigit())}</td>'
                       f'<td>-{sum(int(r) for _, _, r in files if r.isdigit())}</td></tr>' for top, files in sorted(groups.items()))
    file_rows = "".join(f"<tr><td><code>{esc(path)}</code></td><td>+{esc(a)}</td><td>-{esc(r)}</td></tr>"
                        for _, files in sorted(groups.items()) for path, a, r in files)
    s5 += (f'<details class="annex" id="annex-changed"><summary>Changed files against <code>{esc(base)}</code> ({esc(base_ref)}), '
           'the working tree included</summary><div class="annex-body">'
           + ('<div class="table" tabindex="0" role="region" aria-label="Changed directories"><table class="dirs"><thead><tr><th scope="col">Directory</th><th scope="col">Files</th>'
              f'<th scope="col">Added</th><th scope="col">Removed</th></tr></thead><tbody>{dir_rows}</tbody></table></div>'
              '<div class="table" tabindex="0" role="region" aria-label="Changed files"><table><thead><tr><th scope="col">File</th>'
              f'<th scope="col">Added</th><th scope="col">Removed</th></tr></thead><tbody>{file_rows}</tbody></table></div>'
              if groups else f'<p>{state("none", "dim")} no file differs from the base</p>') + "</div></details>")

    # The summary
    def fold(markdown_text, prefix, extra="", by=""):
        inner = (page.markdown(markdown_text, prefix, top=3, figure=True) if markdown_text else "") + extra
        if not inner:
            return f'<p class="by">{by}</p>' if by else ""
        return (f'<details class="more"><summary>{by + " · " if by else ""}the rest of the notes</summary>'
                f'<div class="notes">{inner}</div></details>')

    notes_absent = (state("not recorded", "dim") if whys["decision-notes"] is None or whys["decision-notes"].startswith("no report")
                    else state("unavailable", "need"))
    if notes and notes.get("task"):
        first, rest = split_first(notes["task"])
        task = f'<p>{page.inline(first)}</p>{fold(rest, "notes-1", by="Written by the agent")}'
    elif goal:
        task = (f'<p>{page.inline(goal.group(1))}</p><p class="by">The spec\'s goal · '
                + ('decision notes have no "What the task must do" section' if notes is not None else f"decision notes {notes_absent}") + "</p>")
    else:
        task = f'<p>{state("not recorded", "dim")} no decision notes and no spec goal</p>'
    users = (f'<h3>What it changes for users</h3>{page.markdown(notes["users"], "notes-3", top=4, figure=True)}'
             if notes and notes.get("users") else "")
    para = first_paragraph(texts["pr-body"]) if texts["pr-body"] else None
    if notes and notes.get("change"):
        first, rest = split_first(notes["change"])
        solution = f'<p>{page.inline(first)}</p>{fold(rest, "notes-2", users, by="Written by the agent")}'
    elif para:
        solution = f'<p>{page.inline(para)}</p>{fold("", "", users, by=f"The PR description&#39;s first paragraph · decision notes {notes_absent}")}'
    else:
        solution = f'<p>{state("not recorded", "dim")} no decision notes and no PR description</p>{fold("", "", users)}'

    if review:
        names = (list(dict.fromkeys(lens["lens"] for lens in lenses if lens not in failed_lenses)) if lenses is not None
                 else header_lenses)
        # each Not run entry by its name only: its reason is in the review section, one click away
        skipped = [re.split(r":| — ", entry, maxsplit=1)[0].strip() for outcome, _, entry, _ in review[2] if outcome == "Not run"] + \
                  [f'{lens["model"]} {lens["lens"]}: {lens["findings"]}' for lens in failed_lenses]
        review_line = (f'{len(names)} lens{"es" * (len(names) != 1)}: {esc(", ".join(names)) or state("not recorded", "dim")}'
                       f' · cross-model: {esc(model) if model else state("not recorded", "dim")}'
                       f' · Fixed {review_counts["Fixed"]} · Open '
                       + (state(str(review_counts["Open"]), "need") if review_counts["Open"] else "0")
                       + (f' · {state("not run:", "need")} {esc("; ".join(skipped))} <a class="go" href="#s03">why</a>' if skipped else ""))
    else:
        review_line = source_html("review", "review")
    if validation_ok:
        by_level = []
        for level in levels:
            at = rows_at[level]
            fails, not_run = sum(r["result"] == "FAIL" for r in at), sum(r["result"] == "NOT RUN" for r in at)
            ran, ran_failed = sum(r["tests"][0] for r in at), sum(r["tests"][1] for r in at)
            by_level.append(f'<span class="lvl">{esc(level)}</span> {sum(r["result"] == "PASS" for r in at)}/{len(at)} PASS'
                            + (f", {state(f'{fails} FAIL', 'need')}" if fails else "")
                            + (f", {state(f'{not_run} NOT RUN', 'need')}" if not_run else "")
                            + (f' ({ran} test{"s" * (ran != 1)} in the runner output' + (f", {ran_failed} FAIL" if ran_failed else "") + ")"
                               if ran else ""))
        skipped_types = [f'<span class="lvl">{esc(t["type"])}</span> not run: {page.inline(t["evidence"]) or state("no reason recorded", "need")}'
                         for t in test_types if re.sub(r"[\s*_`]", "", t["ran"]).lower() == "no"]
        tests_line = "; ".join(by_level + skipped_types)
    else:
        tests_line = source_html("validation", "validate")
    verify_html = (state(verify_word, result_tone(verify_word)) if verify_word and verify_word != "phase off"
                   else source_html("verify", "verify"))
    gates = (f'CI {state(ci_word, ci_tone)} · review stamp {state(stamps["review"], stamp_tone(stamps["review"]))}'
             f' · validate stamp {state(stamps["validate"], stamp_tone(stamps["validate"]))} · verify {verify_html}')

    def item_list(key, label, items, empty):
        page.ids.add(key)
        return (f'<div class="list" id="{key}"><h2>{label} <span class="n">{len(items)}</span></h2>'
                f'<ol class="items" id="{key}-items">'
                + "".join(f'<li>{body} <a class="go" href="{esc(href)}">details</a></li>' for href, body, *_ in items)
                + "</ol>" + ("" if items else f"<p>{state(empty, 'ok')}</p>") + "</div>")
    summary = ('<section id="summary" aria-labelledby="h00"><h2 class="vh" id="h00">Summary</h2><dl class="sum">'
               + "".join(f'<div class="row"><dt id="sum-{key}">{label}</dt><dd>{body}</dd></div>'
                         for key, label, body in (("task", "Task", task), ("solution", "Solution", solution),
                                                  ("review", "Review", review_line), ("tests", "Tests", tests_line),
                                                  ("gates", "Gates", gates)))
               + "</dl>" + item_list("decisions", "Your decisions", decisions, "nothing to decide")
               + item_list("blockers", "Blockers the agent owns", blockers, "no blocker")
               + item_list("warnings", "Warnings", warnings, "no warning")
               + '<nav class="toc" aria-label="Sections"><ol>'
               + "".join(f'<li><a href="#s0{n}">{SECTIONS[n]}</a></li>' for n in SECTIONS) + "</ol></nav></section>")

    # Header, footer
    pr_title = pr["title"] if pr else None
    title = pr_title or (spec_title.group(1) if spec_title else branch)
    pr_text = (f'#{pr["number"]} {esc(pr.get("state") or "")} <code>{esc(pr.get("url") or "")}</code>' if pr else
               state("unknown", "need") + " " + esc(pr_error) if pr_error else state("no PR yet", "dim"))
    pr_head = review_stamp.git("rev-parse", "--verify", "--quiet", f"{pr['headRefOid']}^{{tree}}") if pr else ""
    covers = (f'commit <code>{esc(pr["headRefOid"])}</code>, tree <code>{esc(pr_head)}</code>' if pr and pr_head else
              f'commit <code>{esc(pr["headRefOid"])}</code>, tree {state("unavailable", "dim")} not in this repository'
              if pr else state("no PR yet", "dim"))
    # CI, verify and the stamps are the summary's Gates row: the strip holds only what the row doesn't
    strip = [("PR", f'#{pr["number"]}' if pr else ("unknown" if pr_error else "no PR yet"), "ok" if pr else "need" if pr_error else "dim")]
    todo = f'{len(decisions)} decision{"s" * (len(decisions) != 1)} · {len(blockers)} blocker{"s" * (len(blockers) != 1)}'
    decide_link = f'<a class="todo {"need" if blockers else "ok"}" href="#decisions">{todo}</a>'
    opened = {number for _, _, number in blockers if number}
    metas = {1: s1_meta, 2: s2_meta, 3: s3_meta, 4: s4_meta, 5: f"{len(ANNEXES)} reports and the changed files"}
    sections = {1: s1, 2: s2, 3: s3, 4: s4, 5: s5}
    body_html = "".join(
        f'<details class="sec"{" open" if n in opened else ""} id="s0{n}"><summary><h2 id="h0{n}"><span class="num">0{n}</span> '
        f'{SECTIONS[n]}</h2><span class="meta">{esc(metas[n])}</span></summary><div class="sec-body">{sections[n]}</div></details>'
        for n in sorted(sections))
    phases = f'{state("unavailable", "need")} {esc(phases_error)}' if phases_error else esc(phase_switches.describe(off))
    footer = ('<footer id="footer"><dl class="ids">'
              f'<dt>PR</dt><dd>{pr_text}</dd>'
              f'<dt>Commit and tree</dt><dd>{covers}</dd>'
              f'<dt>CI</dt><dd>{state(ci_word, ci_tone)} {esc(ci_detail)}</dd>'
              f'<dt>Verify</dt><dd>{verify_html} {esc(verify_line or "")}</dd>'
              f'<dt>Phases off</dt><dd>{phases}</dd>'
              f'<dt>HEAD read</dt><dd>commit <code>{esc(head)}</code>, working tree <code>{esc(tree)}</code>, branch '
              f'<code>{esc(branch)}</code></dd>'
              f'<dt>Generated</dt><dd>{esc(now)}</dd>'
              f'<dt>Page</dt><dd>local file, not published · <code>{esc(page_path)}</code></dd></dl></footer>')
    return (f'<!doctype html><html lang="en"><head><meta charset="utf-8">'
            f'<meta http-equiv="Content-Security-Policy" content="{esc(CSP)}">'
            f'<meta name="viewport" content="width=device-width, initial-scale=1"><meta name="referrer" content="no-referrer">'
            f"<title>{esc(title)}</title><style>{STYLE}</style></head><body>"
            f'<a class="skip" href="#main">Skip to the summary</a>'
            f'<header class="top"><h1>{esc(title)}</h1>'
            f'<p class="purpose">Decision page for <code>{esc(branch)}</code>, from its spec, reports and evidence</p>'
            f'<p class="strip">' + " ".join(f'<span class="gate">{name} {state(word, tone)}</span>' for name, word, tone in strip)
            + f" {decide_link}</p></header>"
            f'<main id="main">{summary}{body_html}</main>{footer}</body></html>\n')


