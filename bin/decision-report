def write_atomically(path, text):
    fd, temporary = tempfile.mkstemp(dir=os.path.dirname(path), prefix=".decision-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
        os.replace(temporary, path)
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.remove(temporary)


def main():
    if len(sys.argv) != 3:
        sys.exit("usage: decision-report <page> <evidence dir>")
    page, evidence = sys.argv[1:]
    try:
        with contextlib.suppress(FileNotFoundError):
            os.remove(page)  # even a kill mid-build leaves no older page
        os.chdir(review_stamp.git("rev-parse", "--show-toplevel"))
        write_atomically(page, build(page, evidence))
    except BaseException as error:  # no page beats an older one taken for the current one
        with contextlib.suppress(FileNotFoundError):
            os.remove(page)
        if not isinstance(error, Exception):
            raise
        sys.exit(f"decision-report: no page written, {page} removed: {type(error).__name__}: {error}")
    print(page)


if __name__ == "__main__":
    main()
