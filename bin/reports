#!/bin/bash
# Review and testing reports for the current repo and branch, stored next to the spec (outside the tree). A branch
# with only a guide saved under its older name, staging-guide, reads it as its checks-guide.
#   reports path <verify|review|validation|checks-guide|follow-pr>   where the stop hook or a skill saves that report
#   reports path pr-body                             where kit-ship and kit-follow-pr save the PR description; left out of the listings
#   reports path decision-notes                      where kit-ship saves its decision notes for the decision page; left out of the listings
#   reports path evidence                            the directory (created) for validation evidence: outputs, screenshots; needs a branch, as pr-body does
#   reports html                                     writes the branch's decision page (bin/decision-report) next to its reports and prints its path
#   reports                                          every report that exists, with its path, the evidence, the phases off
#   reports brief                                    the phase and one line per report, to pick a branch up in a new session
#   reports --branch <name> …                        the same for another branch of this repo, without phase and switches
set -euo pipefail
if [ "${1:-}" = "--branch" ]; then
  [ -n "${2:-}" ] || { echo "usage: reports --branch <name> [path <kind> | brief]" >&2; exit 2; }
  # Only reads: path.sh would move the current branch's reports, never another's.
  dir="$(git rev-parse --path-format=absolute --git-common-dir)/agents"
  tilde='~'  # review_stamp.branch_key: / becomes ~
  suffix="$("$HOME/.agents/bin/repo-name")-${2//\//$tilde}"
  other_branch=1 branch_arg=" --branch $(printf %q "$2")"  # a branch name may hold quotes or $
  shift 2
else
  spec="$("$HOME/.agents/skills/kit-spec/path.sh")"
  dir="$(dirname "$spec")"
  suffix="$(basename "$spec" .md)"; suffix="${suffix#spec-}"
  other_branch=0
fi

report_file() {
  # Guides written before checks-guide were named staging-guide: a branch with only that one keeps reading it.
  if [ "$1" = checks-guide ] && [ ! -f "$dir/checks-guide-$suffix.md" ] && [ -f "$dir/staging-guide-$suffix.md" ]; then
    echo "$dir/staging-guide-$suffix.md"
  else
    echo "$dir/$1-$suffix.md"
  fi
}

if [ "${1:-}" = "path" ]; then
  case "${2:-}" in
    verify|review|validation|checks-guide|follow-pr) report_file "$2" ;;
    pr-body|decision-notes)
      # Every detached checkout would share one file, and a PR edit could send another PR's description.
      [ $other_branch = 1 ] || [ -n "$(git branch --show-current)" ] \
        || { echo "reports path $2 needs a branch: run it from the PR branch's checkout, or pass --branch <name>" >&2; exit 2; }
      echo "$dir/$2-$suffix.md" ;;
    evidence)
      # Every detached checkout would share one directory, and a validation could cite another's outputs.
      [ $other_branch = 1 ] || [ -n "$(git branch --show-current)" ] \
        || { echo "reports path evidence needs a branch: run it from the branch's checkout, or pass --branch <name>" >&2; exit 2; }
      mkdir -p "$dir/evidence-$suffix"; echo "$dir/evidence-$suffix" ;;
    *) echo "usage: reports path <verify|review|validation|checks-guide|follow-pr|pr-body|decision-notes|evidence>" >&2; exit 2 ;;
  esac
  exit 0
fi

if [ "${1:-}" = "html" ]; then
  # The page reads this checkout's stamps, diff and HEAD, which another branch's name doesn't reach.
  [ $other_branch = 0 ] || { echo "reports html works on the checked-out branch: run it from that branch's checkout" >&2; exit 2; }
  [ -n "$(git branch --show-current)" ] \
    || { echo "reports html needs a branch: run it from the branch's checkout" >&2; exit 2; }
  exec python3 "$(dirname "$0")/decision-report" "$dir/decision-$suffix.html" "$dir/evidence-$suffix"
fi

if [ "${1:-}" = "brief" ]; then
  if [ $other_branch = 0 ]; then
    phase="$("$HOME/.agents/bin/phase" --refresh 2>&1)" || phase="unknown (bin/phase failed: ${phase##*$'\n'})"
    echo "phase: $phase"
    switches="$("$HOME/.agents/bin/phase" switches 2>&1)" || switches="unknown (bin/phase switches failed: $switches)"
    [ -z "$switches" ] || echo "off: $(sed 's/: off (/ (/' <<<"$switches" | paste -sd, - | sed 's/,/, /g')"
  fi
  for kind in spec verify review validation checks-guide follow-pr; do
    f="$(report_file "$kind")"
    [ -f "$f" ] || continue
    case $kind in
      spec) line="$(head -1 "$f" | sed 's/^# //')" ;;
      review) line="$(head -1 "$f")$(grep -m1 -E '^(Open:|## Open)' "$f" | sed 's/^/ · /' || true)" ;;
      validation) line="$(python3 - "$f" <<'PY'
import collections, os, sys
sys.path.insert(0, os.path.expanduser("~/.agents/hooks"))
import review_stamp
counts = collections.Counter(row[1] for row in review_stamp.result_rows(open(sys.argv[1]).read().splitlines(), None))
print(", ".join(f"{counts[r]} {r}" for r in ("PASS", "FAIL", "NOT RUN")))
PY
)" ;;
      checks-guide) line="$(grep -q '^## Results' "$f" && echo 'results recorded' || echo 'no results yet')" ;;
      follow-pr) line="$(grep '^Status:' "$f" | tail -1 || true)"; line="${line:-no Status line yet}" ;;
      *) line="$(head -1 "$f")" ;;
    esac
    printf '%-14s %s\n               %s\n' "$kind" "$line" "$f"
  done
  echo "Read one in full with cat <path>, or all of them with: ~/.agents/bin/reports${branch_arg:-}"
  exit 0
fi

found=0
for kind in spec verify review validation checks-guide follow-pr; do
  f="$(report_file "$kind")"
  [ -f "$f" ] || continue
  found=1
  printf '\n===== %s — %s =====\n\n' "$kind" "$f"
  cat "$f"
done
evidence="$dir/evidence-$suffix"
if [ -d "$evidence" ] && [ -n "$(ls -A "$evidence")" ]; then
  found=1
  printf '\n===== evidence — %s =====\n\n' "$evidence"
  ls -lA "$evidence" | awk 'NR > 1 { size = $5; $1 = $2 = $3 = $4 = $5 = $6 = $7 = $8 = ""; sub(/^ +/, ""); print $0 " (" size " bytes)" }'
fi
if [ $other_branch = 0 ]; then
  switches="$("$HOME/.agents/bin/phase" switches 2>&1)" || switches="unknown (bin/phase switches failed: $switches)"
  [ -z "$switches" ] || { found=1; printf '\n===== phases the user switched off =====\n\n%s\n' "$switches"; }
fi
[ $found = 1 ] || echo "No spec or reports yet for this branch (looked in $dir)."
