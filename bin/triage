#!/usr/bin/env python3
"""Deterministic triage of the current change: risk tier, review lenses and test types, with reasons.

  triage                  change vs the merge-base with the default branch (committed + uncommitted + untracked)
  triage --range A..B     a commit range instead (for calibration on past changes)
  triage --json           machine-readable output
  triage --lens-briefs    every review lens as JSON [{key, title, brief}], from skills/self-review/lenses.md

The self-review and validate skills run the lenses and tests this selects. Every rule is a regex
over changed paths or added lines, so a selection can always be traced back to its signal.
"""
import ast
import json
import os
import re
import subprocess
import sys

TEST_OR_DOC = re.compile(r"(^|/)(tests?|__tests__|spec|docs?)/|[._-](test|spec)\.[a-z]+$|Test\.php$|\.(md|txt|rst)$"
                         r"|(^|/)(CHANGELOG|README|LICENSE)", re.I)
STYLE_FILE = re.compile(r"\.(css|scss|sass|less)$", re.I)
UI_FILE = re.compile(r"\.(jsx?|tsx?|vue|svelte|astro|css|scss|sass|less|html|twig|mustache)$|(^|/)(templates?|views?|blocks?|components?)/", re.I)

# (name, regex over added lines) — each hit is recorded as a reason.
LENS_SIGNALS = {
    "security": r"\$_(GET|POST|REQUEST|COOKIE|FILES|SERVER)\b|get_param\(|get_json_params|register_rest_route|wp_ajax_"
                r"|current_user_can|nonce|\$wpdb->|unserialize\(|file_put_contents|unlink\(|move_uploaded_file"
                r"|wp_remote_|curl_|\bexec\(|shell_exec|proc_open|eval\(|innerHTML|dangerouslySetInnerHTML|redirect",
    "performance": r"\$wpdb->|new WP_Query|get_posts\(|wc_get_(orders|products)\(|get_post_meta\(|wp_remote_"
                   r"|add_action\(\s*['\"](init|wp|wp_loaded|template_redirect|admin_init|plugins_loaded)['\"]"
                   r"|set_transient|wp_cache_|autoload|as_schedule|wp_schedule_event|posts_per_page|LIMIT",
    "compatibility": r"apply_filters\(|do_action\(|register_rest_route|WP_CLI::add_command|->add_argument\("
                     r"|add_option\(|update_option\(|register_setting|CREATE TABLE|ALTER TABLE|dbDelta|add_filter\(|add_action\(",
    "operability": r"as_schedule|as_enqueue|wp_schedule_event|register_rest_route|WP_CLI::add_command|wp_remote_"
                   r"|curl_|error_log|->log\(",
    "data-privacy": r"CREATE TABLE|ALTER TABLE|DROP |dbDelta|DELETE FROM|->delete\(|wp_delete_|TRUNCATE|user_email"
                    r"|billing_|shipping_|\bemail\b|ip_address|personal|gdpr|tracks?_event|analytics|error_log",
}
# The lenses.md heading of each lens key triage selects. The Claude Code mod names its reviewer agents by these keys.
LENS_TITLES = {"correctness": "Correctness", "tests": "Tests", "maintainability": "Maintainability", "security": "Security",
               "performance": "Performance and scale", "compatibility": "Compatibility and rollout",
               "operability": "Operability", "data-privacy": "Data and privacy", "ux-a11y-i18n": "UX, accessibility and i18n",
               "design": "Design"}
HIGH_RISK = {
    "auth or permissions": r"current_user_can|permission_callback|wp_verify_nonce|check_ajax_referer|login|capabilit",
    "payments or orders": r"stripe|payment|checkout|refund|subscription|invoice|wc_get_order|->get_total\(",
    "schema or data migration": r"CREATE TABLE|ALTER TABLE|dbDelta|migration|DROP TABLE",
    "public API or hooks": r"register_rest_route|apply_filters\(|do_action\(|WP_CLI::add_command",
    "caching": r"set_transient|wp_cache_set|wp_cache_add|cache_key",
    "scheduled jobs": r"as_schedule|as_enqueue|wp_schedule_event|cron",
}
# A git checkout, not a shop's: lines with version-control words don't count as a payments signal.
GIT_CHECKOUT = re.compile(r"\bgit(\b|_)|actions/checkout|worktree|\bbranch|\b(pr|primary|known|remember)_checkouts?\b|\bpr_checkout_"
                          r"|\b(main|this|a|the|every|another|each)\s+checkouts?\b(?![\s-]+(page|form|block|field|flow|process|button|url|step))"
                          # The kit's own calls on a directory; case-sensitive, so a shop's renderCheckout(root) still counts.
                          r"|(?-i:(?<![\w$>])(in_|check_)?checkout\(\s*(\$,\s*)?(os\.getcwd\(\)|cwd|root)\s*[,)])",
                          re.I)
PROPERTY_FN = re.compile(r"function\s+\w*(parse|format|calculate|compute|compare|convert|normali[sz]e|version|date|week"
                         r"|price|round|slug|sanitize|validate)\w*\s*\(", re.I)
# Where a line's regex text sits: string literals on a line that calls a regex API or holds a raw string, and
# /.../ literals where an expression starts (not a division). Each piece reads a character one way, and a try at a
# literal stops at the next /, so the scan stays linear. An unescaped / inside [...] ends the literal early: a miss.
REGEX_API = re.compile(r"""\br["']|\bre\.\w+\(|preg_\w+\(|RegExp\(|=~""")
STRING_LITERAL = re.compile(r""""((?:[^"\\\n]|\\.)*)"|'((?:[^'\\\n]|\\.)*)'""")
SLASH_LITERAL = re.compile(r"(?:^|[=(,:!&|?{;]|\breturn)\s*/((?:[^/\\\n\[]|\\.|\[(?:[^\]\\\n/]|\\.)*\])+)/[a-z]*")
BOUNDED_REPEAT = re.compile(r"\{\d+,")
FIXED_REPEAT = re.compile(r"\{\d+")
REGEX_LINE_MAX = 2000  # longer added lines are data, not patterns


def regex_texts(line):
    texts = [m.group(1) for m in SLASH_LITERAL.finditer(line)]
    if REGEX_API.search(line):
        texts += [m.group(1) if m.group(1) is not None else m.group(2) for m in STRING_LITERAL.finditer(line)]
    return texts


def nested_quantifier(line):
    """Whether a regex group that repeats holds a repeat itself, like (a+)+, (?:a?b?)+ or (a+){20}: on a long input
    that almost matches it can backtrack exponentially. One pass with a stack of open groups, so the scan itself
    stays linear; a heuristic that points the Performance lens and the timing test at the pattern."""
    def inner_repeat_at(k):  # ? right after ( or after another quantifier is syntax, not a repeat
        return k < len(line) and (line[k] in "*+" or bool(BOUNDED_REPEAT.match(line, k))
                                  or (line[k] == "?" and k > 0 and line[k - 1] not in "(*+?}"))

    def repeat_at(k):
        return k < len(line) and (line[k] in "*+" or bool(FIXED_REPEAT.match(line, k)))

    open_groups, i = [], 0  # each: whether a repeat was seen inside
    while i < len(line):
        c = line[i]
        if c == "\\":
            i += 2
            continue
        if c == "[":  # a character class: its * and + are characters
            i += 2 if line[i + 1:i + 2] == "]" or line[i + 1:i + 3] == "^]" else 1
            while i < len(line) and line[i] != "]":
                i += 2 if line[i] == "\\" else 1
        elif c == "(":
            open_groups.append(False)
        elif c == ")" and open_groups:
            had_repeat = open_groups.pop()
            if had_repeat and repeat_at(i + 1):
                return True
            if open_groups and (had_repeat or repeat_at(i + 1)):
                open_groups[-1] = True
        elif inner_repeat_at(i) and open_groups:
            open_groups[-1] = True
        i += 1
    return False


BUDGET = {"low": "< 5 min", "standard": "<= 20 min", "high": "<= 45 min"}


def git(*args, cwd=None):
    return subprocess.run(["git", *args], capture_output=True, text=True, errors="replace", cwd=cwd).stdout


def base_ref():
    remote_head = git("symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD").strip()
    for ref in ([remote_head] if remote_head else []) + ["origin/trunk", "origin/main", "origin/master",
                                                         "origin/develop", "trunk", "main", "master", "develop"]:
        if git("rev-parse", "--verify", "--quiet", ref).strip():
            return ref
    return "HEAD"


def diff_path(field):
    """A path as git prints it in a diff: C-quoted when it holds a quote, a backslash or a control character, and
    followed by a tab in ---/+++ lines when it holds a space."""
    field = field.rstrip("\t")
    return ast.literal_eval(field) if field.startswith('"') else field


def collect(rng):
    if rng:
        diff = git("-c", "core.quotePath=false", "diff", "--unified=0", "--no-color", rng)
        untracked = []
    else:
        merge_base = git("merge-base", "HEAD", base_ref()).strip() or "HEAD"
        diff = git("-c", "core.quotePath=false", "diff", "--unified=0", "--no-color", merge_base)
        untracked = [p for p in git("ls-files", "-z", "--others", "--exclude-standard").split("\0") if p]
    files, added, removed, renamed_from = {}, [], 0, {}
    path, header, source = None, False, None
    for line in diff.split("\n"):  # not splitlines(): an unquoted path may hold U+2028
        if line.startswith("diff --git "):
            path, header = None, True
        elif line.startswith("@@"):
            header = False
        elif header and line.startswith("rename from "):  # a pure rename has no ---/+++ lines at all
            source = diff_path(line[len("rename from "):])
            files.setdefault(source, 0)
        elif header and line.startswith("rename to "):
            target = diff_path(line[len("rename to "):])
            renamed_from[target] = source
            files.setdefault(target, 0)
        elif header and line.startswith("+++ "):
            new = diff_path(line[4:])
            path = new[2:] if new.startswith("b/") else None
            if path:
                files.setdefault(path, 0)
        elif header and line.startswith("--- "):
            old = diff_path(line[4:])
            if old.startswith("a/"):
                files.setdefault(old[2:], 0)
        elif header:
            continue
        elif path and line.startswith("+"):
            files[path] += 1
            added.append((path, line[1:]))
        elif line.startswith("-"):
            removed += 1
    for p in untracked:
        try:
            lines = open(p, errors="ignore").read().splitlines()
        except OSError:
            continue
        files[p] = len(lines)
        added += [(p, l) for l in lines]
    return files, added, removed, renamed_from


# Files that declare dependencies, by name. deps.txt is the kit's own list of programs.
MANIFEST = re.compile(r"(^|/)(package\.json|composer\.json|[\w.-]*requirements[\w.-]*\.txt|requirements/[\w.-]+\.txt|go\.mod"
                      r"|Cargo\.toml|deps\.txt)$")
# Composer's platform packages: the PHP runtime and its extensions, not packages anyone installs.
COMPOSER_PLATFORM = re.compile(r"^(php(-[\w-]+)?|ext-.+|lib-.+|composer(-[\w-]+)?)$")


def dependency_names(path, text):
    """The dependencies a manifest declares; ValueError when it can't be read."""
    name = os.path.basename(path)
    if name in ("package.json", "composer.json"):
        data = json.loads(text)
        if not isinstance(data, dict):
            raise ValueError(f"{path} is not a JSON object")
        sections = (("dependencies", "devDependencies", "peerDependencies", "optionalDependencies") if name == "package.json"
                    else ("require", "require-dev"))
        if any(not isinstance(data.get(s) or {}, dict) for s in sections):
            raise ValueError(f"{path} has a dependency section that is not an object")
        return {dep for s in sections for dep in (data.get(s) or {}) if not (name == "composer.json" and COMPOSER_PLATFORM.match(dep))}
    lines = [line.split("#")[0].strip() for line in text.splitlines()]
    if name == "deps.txt":
        return {line.split()[1].split(">=")[0] for line in lines if len(line.split()) > 1}
    if name.endswith(".txt"):  # requirements: options, includes and local paths name no package; a URL names its #egg=
        raw = [line.split("#")[0].strip() if "#egg=" not in line else line.strip() for line in text.splitlines()]
        packages = [re.search(r"#egg=([\w.-]+)", line) or (None if re.match(r"-|\.|/|\w+\+|\w+://", line)
                                                            else re.match(r"[A-Za-z0-9][\w.-]*", line)) for line in raw]
        return {re.sub(r"[-_.]+", "-", m.group(m.lastindex or 0)).lower() for m in packages if m}  # pip: foo_bar is Foo-Bar
    names, block = set(), False
    if name == "go.mod":
        for line in (l.split("//")[0].strip() for l in text.splitlines()):
            one_line = re.fullmatch(r"require \((\S+) \S+\)", line)
            if one_line:
                names.add(one_line.group(1))
            elif line == "require (":
                block = True
            elif block and line == ")":
                block = False
            elif block and line:
                names.add(line.split()[0])
            elif re.match(r"require\s", line) and len(line.split()) >= 3:
                names.add(line.split()[1])
        return names
    for line in lines:  # Cargo.toml
        header = re.fullmatch(r"\[(.+)\]", line)
        if header:
            table = header.group(1)
            block = bool(re.search(r"(^|\.)(dev-|build-)?dependencies$", table))
            nested = re.search(r"(^|\.)(dev-|build-)?dependencies\.([\w-]+)$", table)
            if nested:
                names.add(nested.group(3))
        elif block and re.match(r"\"?[\w-]+\"?\s*[.=]", line):
            names.add(re.match(r"\"?([\w-]+)", line).group(1))
    return names


def new_dependencies(files, renamed_from, rng):
    """'new dependency: <name> (<manifest>)' for each name a changed manifest gains, and a line for each it can't read."""
    # The same ends git diff compares: A...B from their merge-base, A..B, and a lone ref against the working tree.
    if rng and "..." in rng:
        a, b = rng.split("...", 1)
        before_ref, after_ref = git("merge-base", a or "HEAD", b or "HEAD").strip(), b or "HEAD"
    elif rng and ".." in rng:
        a, b = rng.split("..", 1)
        before_ref, after_ref = a or "HEAD", b or "HEAD"
    else:
        before_ref, after_ref = rng or git("merge-base", "HEAD", base_ref()).strip() or "HEAD", None
    root = git("rev-parse", "--show-toplevel").strip()
    found = []
    for path in (p for p in files if MANIFEST.search(p)):
        before = subprocess.run(["git", "show", f"{before_ref}:{renamed_from.get(path, path)}"], capture_output=True,
                                text=True, errors="replace")
        if after_ref:
            after = subprocess.run(["git", "show", f"{after_ref}:{path}"], capture_output=True, text=True, errors="replace")
            after_text = after.stdout if after.returncode == 0 else None
        else:
            full = os.path.join(root, path)
            after_text = open(full, errors="ignore").read() if os.path.isfile(full) else None
        if after_text is None:
            continue
        try:
            source = renamed_from.get(path, path)
            declared = dependency_names(source, before.stdout) if before.returncode == 0 and MANIFEST.search(source) else set()
            added = dependency_names(path, after_text) - declared
        except ValueError:
            found.append(f"{path} can't be read at one end of the change: check its dependencies by hand")
            continue
        found += [f"new dependency: {name} ({path})" for name in sorted(added)]
    return found


def php_min():
    for candidate in ("composer.json", "src/composer.json"):
        try:
            data = json.load(open(candidate))
        except (OSError, ValueError):
            continue
        platform = (data.get("config") or {}).get("platform", {}).get("php")
        req = (data.get("require") or {}).get("php", "")
        m = re.search(r"(\d+\.\d+)", platform or req)
        if m:
            return m.group(1)
    return None


def triage(rng=None):
    files, added, removed, renamed_from = collect(rng)
    changed_lines = sum(files.values()) + removed
    behavior = [p for p in files if not TEST_OR_DOC.search(p)]
    style_only = bool(behavior) and all(STYLE_FILE.search(p) for p in behavior)
    code_added = [(p, l) for p, l in added if not TEST_OR_DOC.search(p)]
    reasons, lenses, tests = [], {"correctness": ["always"]}, {"unit (verify)": ["always"]}

    def hits(pattern, lines=code_added, limit=3):
        rx = re.compile(pattern, re.I)
        found = []
        for p, l in lines:
            m = next((m for m in rx.finditer(l) if not (m.group(0).lower() == "checkout" and GIT_CHECKOUT.search(l))), None)
            if m and len(found) < limit:
                found.append(f"{p}: `{m.group(0)}`")
        return found

    high = []
    for label, rx in HIGH_RISK.items():
        h = hits(rx, limit=1)
        if h:
            high.append(f"{label} ({h[0]})")
    if changed_lines > 400:
        high.append(f"{changed_lines} changed lines")

    if (not behavior or style_only) and changed_lines < 50 and not high:
        tier = "low"
    elif high:
        tier = "high"
        reasons += high
    else:
        tier = "standard"

    ui = [p for p in behavior if UI_FILE.search(p)]
    if ui:  # at every tier: a one-line style change can still be a design regression
        lenses["design"] = ui  # every file: the lens passes them all to the detector
        tests["design (impeccable detect)"] = ui
    if style_only:
        lenses["ux-a11y-i18n"] = behavior[:3]
    if tier != "low":
        lenses["maintainability"] = ["behavior change"]
        if any(TEST_OR_DOC.search(p) and "test" in p.lower() for p in files) or (behavior and not style_only):
            lenses["tests"] = ["behavior change" if behavior else "tests changed"]
        for lens, rx in LENS_SIGNALS.items():
            h = hits(rx)
            if h:
                lenses[lens] = h
        if ui:
            lenses["ux-a11y-i18n"] = ui[:3]
    dependencies = new_dependencies(files, renamed_from, rng)
    if dependencies:
        lenses.setdefault("maintainability", []).extend(dependencies)

    if behavior and not style_only:
        tests["e2e positive/negative (validate)"] = ["behavior change"]
    elif style_only:
        tests["visual check of affected pages (validate)"] = ["style-only change"]
    if any(re.search(r"\$wpdb->|WP_Query|get_posts\(|wc_get_(orders|products)\(", l) for _, l in code_added):
        tests["query budget"] = lenses["performance"][:2]
    if "ux-a11y-i18n" in lenses:
        tests["accessibility (axe)"] = lenses["ux-a11y-i18n"]
    minimum = php_min()
    if minimum and float(minimum) < 8.0 and any(p.endswith(".php") for p in files):
        tests[f"php {minimum} syntax (verify)"] = [f"composer requires php {minimum}"]
    if re.search(r"CREATE TABLE|ALTER TABLE|dbDelta|migration", "\n".join(l for _, l in code_added), re.I):
        tests["migration round-trip"] = hits(r"CREATE TABLE|ALTER TABLE|dbDelta|migration", limit=2)
    nested = [f"{p}: `{l.strip()}`" for p, l in code_added
              if len(l) <= REGEX_LINE_MAX and any(nested_quantifier(t) for t in regex_texts(l))]
    if nested:
        lenses.setdefault("performance", []).extend(f"nested quantifier in {n[:200]}" for n in nested[:3])
        tests["regex worst-case timing"] = nested  # every one: each needs its own timing
    prop = [f"{p}: {m.group(0)}" for p, l in code_added for m in [PROPERTY_FN.search(l)] if m][:3]
    if prop:
        tests["property-based"] = prop
    if tier == "high" and any(TEST_OR_DOC.search(p) and "test" in p.lower() for p in files) and code_added:
        tests["mutation (changed lines)"] = ["high risk with tests in the diff"]

    return {"tier": tier, "budget": BUDGET[tier], "changed_lines": changed_lines, "files": len(files),
            "reasons": reasons, "lenses": lenses, "tests": tests,
            "cross_model": cross_model(tier)}


def cross_model(tier):
    # Here, not at the top: the mod registers its lens agents from --lens-briefs, which must not need the hooks.
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks"))
    import phase_switches
    from hooklog import session_harness
    off, unreadable = phase_switches.phases_off_or_error(os.getcwd())
    reviewer = {"codex": "claude-review", "claude-code": "codex-review"}.get(session_harness())
    reviewers_off = [phase for phase in ("claude-review", "codex-review") if phase in off]
    if "second-model" in off:
        return "none (second-model switched off)"
    if len(reviewers_off) == 2:
        return f"none ({', '.join(reviewers_off)} switched off)"
    if reviewer in off:
        return f"none ({reviewer} switched off)"
    wanted = "per lens" if tier == "high" else ("correctness" if tier == "standard" else "none")
    if unreadable:
        return f"{wanted} ({' '.join(unreadable.split())})"  # git's stderr may hold newlines
    if not reviewer and reviewers_off and wanted != "none":
        return f"{wanted} (unless the reviewer is off: {', '.join(reviewers_off)})"
    return wanted


def lens_briefs():
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "skills", "self-review", "lenses.md")
    sections = re.split(r"^## (.+)$", open(path).read(), flags=re.M)[1:]
    titles = sections[::2]
    key_of = {title: key for key, title in LENS_TITLES.items()}
    problems = [f"no key in LENS_TITLES for {t}" for t in titles if t not in key_of]
    problems += [f"no lens headed {t}" for t in LENS_TITLES.values() if t not in titles]
    problems += [f"{t} twice" for t in sorted({t for t in titles if titles.count(t) > 1})]
    if problems:
        sys.exit(f"triage: lenses.md doesn't match LENS_TITLES: {'; '.join(problems)}")
    return [{"key": key_of[title], "title": title, "brief": body.strip()} for title, body in zip(sections[::2], sections[1::2])]


def main():
    args = sys.argv[1:]
    if "--lens-briefs" in args:
        print(json.dumps(lens_briefs()))
        return 0
    rng = args[args.index("--range") + 1] if "--range" in args else None
    result = triage(rng)
    if "--json" in args:
        print(json.dumps(result, indent=1))
        return 0
    print(f"Risk: {result['tier']} ({result['changed_lines']} changed lines in {result['files']} files; "
          f"budget {result['budget']}; cross-model: {result['cross_model']})")
    for r in result["reasons"]:
        print(f"  high-risk signal: {r}")
    print("Review lenses:")
    for k, v in result["lenses"].items():
        print(f"  - {k}: {'; '.join(v)}")
    print("Tests:")
    for k, v in result["tests"].items():
        print(f"  - {k}: {'; '.join(v)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
