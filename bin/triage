#!/usr/bin/env python3
"""Deterministic triage of the current change: risk tier, review lenses and test types, with reasons.

  triage                  change vs the merge-base with the branch's base (committed + uncommitted + untracked, but not untracked logs)
  triage --range A..B     a commit range instead (for calibration on past changes)
  triage --json           machine-readable output
  triage --lens-briefs    every review lens as JSON [{key, title, brief}], from skills/kit-review/lenses.md

The kit-review and kit-validate skills run the lenses and tests this selects. Every rule is a regex
over changed paths or added code lines (a whole-line comment isn't one; the high-risk labels read removed ones too), so a selection can always be traced back to its signal. Without --range, the
branch's spec, by its Risk line, can raise the diff's tier, never lower it: the tier is the higher of the two.

A framework's own names are signals only in its repos: packs/<name>.json adds them, in a repo whose top level, at
either end of the change, shows the framework (WordPress: wp-config.php, wp-content/, .wp-env.json, a root PHP file's
Plugin Name header, style.css's Theme Name header, or a composer.json typed as a WordPress package or requiring WordPress
itself), or where ~/.agents/repos/<repo>/packs turns the pack on. Detection that can't conclude stops triage, naming why.
"""
import ast
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys

TEST_OR_DOC = re.compile(r"(^|/)(tests?|__tests__|spec|docs?)/|[._-](test|spec)\.[a-z]+$|Test\.php$|\.(md|txt|rst)$"
                         r"|(^|/)(CHANGELOG|README|LICENSE)", re.I)
STYLE_FILE = re.compile(r"\.(css|scss|sass|less)$", re.I)
PROSE_FILE = re.compile(r"\.(md|txt|rst)$|(^|/)(CHANGELOG|README|LICENSE)", re.I)
# A log or a session's output left in the tree is no part of the change, though the review stamp still covers it.
DATA_FILE = re.compile(r"\.(jsonl|ndjson|log|out|err)$", re.I)
UI_FILE = re.compile(r"\.(jsx?|tsx?|vue|svelte|astro|css|scss|sass|less|html|twig|mustache)$|(^|/)(templates?|views?|blocks?|components?)/", re.I)

# A whole-line comment, told by the file's language. Each language lists only its own prefixes, since another's is
# code there: C's #define and --n, PHP's #[Attribute], a shebang, Ruby's #{} in a string.
SLASH_COMMENT = r"//|/\*|\*(?=\s|/|$)"
COMMENT_BY_EXT = {ext: re.compile(rf"\s*(?:{prefixes})") for exts, prefixes in [
    ("c h cc cpp hpp cs java kt swift go rs js jsx mjs cjs ts tsx mts cts css scss less dart scala", SLASH_COMMENT),
    ("php", rf"{SLASH_COMMENT}|#(?![!\[])|<!--"),
    ("sh bash zsh py rb pl yml yaml toml r ps1 conf", "#(?![!{])"), ("", "#(?![!{])"),  # "": Makefile, Dockerfile
    ("sql lua hs", "--"),
    ("html htm xml svg twig mustache hbs erb", "<!--"), ("vue svelte astro", f"{SLASH_COMMENT}|<!--"),
] for ext in (exts.split() or [""])}
# A comment line that holds code all the same: code after a block comment's closer; in an HTML comment, also a
# template tag (a pack adds its own markup). Other comment forms run to the end of the line.
BLOCK_COMMENT_HOLDS_CODE = re.compile(r"\*/\s*(?!//|/\*)\S")
HTML_COMMENT_HOLDS_CODE = re.compile(r"-->\s*(?!<!--)\S|<\?|\{\{|\{%|<%")
# A spaced `*` opens a docblock line, unless the line ends like a statement: C's `* p = f(x);`, a generator method.
STATEMENT_END = re.compile(r"[;{}]\s*$")


def is_comment(path, line, html_holds_code=HTML_COMMENT_HOLDS_CODE):
    rx = COMMENT_BY_EXT.get(os.path.splitext(os.path.basename(path))[1][1:].lower())
    prefix = rx and rx.match(line)
    if not prefix:
        return False
    form = prefix.group(0).strip()
    if form in ("/*", "*") and BLOCK_COMMENT_HOLDS_CODE.search(line) or form == "<!--" and html_holds_code.search(line):
        return False
    return not (form == "*" and STATEMENT_END.search(line))


def code_word(stem):
    """`stem` as an identifier: part of a longer name (wp_login, user_has_capability, paymentIntent, PaymentIntent), a
    call, after a sigil or member access ($capability, ->login), a receiver (payment.status), an assignment target, a
    PHP array key or a declared type. Not a word of prose, a word before a parenthesis or a JS/JSON key: "schema or
    migration", "the migration (if any)", "capabilities": [. Every branch starts at a word boundary or a literal, so a
    long line that almost matches is scanned once."""
    cap = stem[0].upper() + stem[1:]
    return (rf"\b\w+_{stem}\w*|\b{stem}\w*_\w+|\b{stem}\w*\((?!s\))|(?:[$\\*&.]|->|::){stem}\w*"
            rf"|\b{stem}\w*(?:\.|->|::)\w|\b{stem}\w*\s*(?:[-+*/|&]?=(?![=>])|:=)|['\"]{stem}\w*['\"]\s*=>"
            rf"|(?-i:(?<=[a-z0-9]){cap}\w*|\b{stem}[a-z]*[A-Z]\w*|\b{cap}[a-z]*[A-Z]\w*"
            rf"|(?:\b(?:class|extends|implements|interface|struct|enum|trait|import)\s+|</?){cap}\w*)")


MIGRATION = rf"CREATE TABLE|ALTER TABLE|{code_word('migration')}"
# (name, regex over added code lines) — each hit is recorded as a reason. A pack adds its framework's names to these.
LENS_SIGNALS = {
    "security": r"\$_(GET|POST|REQUEST|COOKIE|FILES|SERVER)\b|nonce|unserialize\(|file_put_contents|unlink\(|move_uploaded_file"
                r"|curl_|\bexec\(|shell_exec|proc_open|eval\(|innerHTML|dangerouslySetInnerHTML|redirect",
    "performance": r"autoload|LIMIT",
    "compatibility": r"->add_argument\(|CREATE TABLE|ALTER TABLE",
    "operability": r"curl_|error_log|->log\(",
    "data-privacy": r"CREATE TABLE|ALTER TABLE|DROP |DELETE FROM|->delete\(|TRUNCATE|user_email"
                    r"|billing_|shipping_|\bemail\b|ip_address|personal|gdpr|tracks?_event|analytics|error_log",
}
# The lenses.md heading of each lens key triage selects. The Claude Code mod names its reviewer agents by these keys.
LENS_TITLES = {"correctness": "Correctness", "tests": "Tests", "maintainability": "Maintainability", "security": "Security",
               "performance": "Performance and scale", "compatibility": "Compatibility and rollout",
               "operability": "Operability", "data-privacy": "Data and privacy", "ux-a11y-i18n": "UX, accessibility and i18n",
               "design": "Design"}
HIGH_RISK = {
    "auth or permissions": rf"{code_word('login')}|{code_word('capabilit')}",
    "payments or orders": rf"stripe|{code_word('payment')}|checkout|refund|subscription|invoice",
    "schema or data migration": rf"{MIGRATION}|DROP TABLE",
    "public API or hooks": r"\b(?:app|router)\.(?:route|get|post|put|patch|delete)\(\s*(?:['\"`]/|/|\[)",
    "caching": r"cache_key",
    "scheduled jobs": rf"{code_word('cron')}|\bcrontab\b"
                      r"|\bcron\w*['\"]?\s*[:=]\s*['\"](?:@\w+|[\d*/,-]+(?: [\d*/,?-]+){4,5})['\"]",
}
# A git checkout, not a shop's: lines with version-control words don't count as a payments signal.
GIT_CHECKOUT = re.compile(r"\bgit(\b|_)|actions/checkout|worktree|\bbranch|\b(pr|primary|known|remember)_checkouts?\b|\bpr_checkout_"
                          r"|\b(main|this|a|the|every|another|each)\s+checkouts?\b(?![\s-]+(page|form|block|field|flow|process|button|url|step))"
                          # The kit's own calls on a directory; case-sensitive, so a shop's renderCheckout(root) still counts.
                          r"|(?-i:(?<![\w$>.:])((in_|check_)checkout\(\s*(root|cwd)|checkout\(\s*(\$,\s*)?cwd)\s*[,)]|\bphase_switches\.checkout\()",
                          re.I)
PROPERTY_FN = re.compile(r"function\s+\w*(parse|format|calculate|compute|compare|convert|normali[sz]e|version|date|week"
                         r"|price|round|slug|sanitize|validate)\w*\s*\(", re.I)
# Where a line's regex text sits: string literals on a line that calls a regex API or holds a raw string, and
# /.../ literals where an expression starts (not a division). Each piece reads a character one way, and a try at a
# literal stops at the next /, so the scan stays linear. An unescaped / inside [...] ends the literal early: a miss.
REGEX_API = re.compile(r"""\br["']|\bre\.\w+\(|preg_\w+\(|RegExp\(|=~""")
STRING_LITERAL = re.compile(r""""((?:[^"\\\n]|\\.)*)"|'((?:[^'\\\n]|\\.)*)'""")
SLASH_LITERAL = re.compile(r"(?:^|[=(,:!&|?{;]|\breturn)\s*/((?:[^/\\\n\[]|\\.|\[(?:[^\]\\\n/]|\\.)*\])+)/[a-z]*")
BOUNDED_REPEAT = re.compile(r"\{\d+,")
FIXED_REPEAT = re.compile(r"\{\d+")
REGEX_LINE_MAX = 2000  # longer added lines are data, not patterns


def regex_texts(line):
    texts = [m.group(1) for m in SLASH_LITERAL.finditer(line)]
    if REGEX_API.search(line):
        texts += [m.group(1) if m.group(1) is not None else m.group(2) for m in STRING_LITERAL.finditer(line)]
    return texts


def nested_quantifier(line):
    """Whether a regex group that repeats holds a repeat itself, like (a+)+, (?:a?b?)+ or (a+){20}: on a long input
    that almost matches it can backtrack exponentially. One pass with a stack of open groups, so the scan itself
    stays linear; a heuristic that points the Performance lens and the timing test at the pattern."""
    def inner_repeat_at(k):  # ? right after ( or after another quantifier is syntax, not a repeat
        return k < len(line) and (line[k] in "*+" or bool(BOUNDED_REPEAT.match(line, k))
                                  or (line[k] == "?" and k > 0 and line[k - 1] not in "(*+?}"))

    def repeat_at(k):
        return k < len(line) and (line[k] in "*+" or bool(FIXED_REPEAT.match(line, k)))

    open_groups, i = [], 0  # each: whether a repeat was seen inside
    while i < len(line):
        c = line[i]
        if c == "\\":
            i += 2
            continue
        if c == "[":  # a character class: its * and + are characters
            i += 2 if line[i + 1:i + 2] == "]" or line[i + 1:i + 3] == "^]" else 1
            while i < len(line) and line[i] != "]":
                i += 2 if line[i] == "\\" else 1
        elif c == "(":
            open_groups.append(False)
        elif c == ")" and open_groups:
            had_repeat = open_groups.pop()
            if had_repeat and repeat_at(i + 1):
                return True
            if open_groups and (had_repeat or repeat_at(i + 1)):
                open_groups[-1] = True
        elif inner_repeat_at(i) and open_groups:
            open_groups[-1] = True
        i += 1
    return False


BUDGET = {"low": "< 5 min", "standard": "<= 20 min", "high": "<= 45 min"}
TIERS = ("low", "standard", "high")
SPEC_LOOKUP_SECS = 10
SKIPPED_SAMPLE = 5


def git(*args, cwd=None):
    return subprocess.run(["git", *args], capture_output=True, text=True, errors="replace", cwd=cwd).stdout


def diff_path(field):
    """A path as git prints it in a diff: C-quoted when it holds a quote, a backslash or a control character, and
    followed by a tab in ---/+++ lines when it holds a space."""
    field = field.rstrip("\t")
    return ast.literal_eval(field) if field.startswith('"') else field


# The parser reads paths after a/ and b/, which diff.noprefix or diff.mnemonicPrefix in the user's config would change.
DIFF_PREFIXES = ("--src-prefix=a/", "--dst-prefix=b/")


def collect(rng, merge_base):
    if rng:
        diff = git("-c", "core.quotePath=false", "diff", *DIFF_PREFIXES, "--unified=0", "--no-color", rng)
        untracked = []
    else:
        diff = git("-c", "core.quotePath=false", "diff", *DIFF_PREFIXES, "--unified=0", "--no-color", merge_base)
        untracked = [p for p in git("ls-files", "-z", "--others", "--exclude-standard").split("\0") if p]
    data_files = [p for p in untracked if DATA_FILE.search(p)]
    files, added, removed, renamed_from = {}, [], [], {}
    path, old_path, header, source = None, None, False, None
    for line in diff.split("\n"):  # not splitlines(): an unquoted path may hold U+2028
        if line.startswith("diff --git "):
            path, old_path, header = None, None, True
        elif line.startswith("@@"):
            header = False
        elif header and line.startswith("rename from "):  # a pure rename has no ---/+++ lines at all
            source = diff_path(line[len("rename from "):])
            files.setdefault(source, 0)
        elif header and line.startswith("rename to "):
            target = diff_path(line[len("rename to "):])
            renamed_from[target] = source
            files.setdefault(target, 0)
        elif header and line.startswith("+++ "):
            new = diff_path(line[4:])
            path = new[2:] if new.startswith("b/") else None
            if path:
                files.setdefault(path, 0)
        elif header and line.startswith("--- "):
            old = diff_path(line[4:])
            old_path = old[2:] if old.startswith("a/") else None
            if old_path:
                files.setdefault(old_path, 0)
        elif header:
            continue
        elif path and line.startswith("+"):
            files[path] += 1
            added.append((path, line[1:]))
        elif line.startswith("-"):
            removed.append((old_path, line[1:]))
    for p in (p for p in untracked if not DATA_FILE.search(p)):
        try:
            lines = open(p, errors="ignore").read().splitlines()
        except OSError:
            continue
        files[p] = len(lines)
        added += [(p, l) for l in lines]
    return files, added, removed, renamed_from, data_files


# Files that declare dependencies, by name. deps.txt is the kit's own list of programs.
MANIFEST = re.compile(r"(^|/)(package\.json|composer\.json|[\w.-]*requirements[\w.-]*\.txt|requirements/[\w.-]+\.txt|go\.mod"
                      r"|Cargo\.toml|deps\.txt)$")
# Composer's platform packages: the PHP runtime and its extensions, not packages anyone installs.
COMPOSER_PLATFORM = re.compile(r"^(php(-[\w-]+)?|ext-.+|lib-.+|composer(-[\w-]+)?)$")


def dependency_names(path, text):
    """The dependencies a manifest declares; ValueError when it can't be read."""
    name = os.path.basename(path)
    if name in ("package.json", "composer.json"):
        data = json.loads(text)
        if not isinstance(data, dict):
            raise ValueError(f"{path} is not a JSON object")
        sections = (("dependencies", "devDependencies", "peerDependencies", "optionalDependencies") if name == "package.json"
                    else ("require", "require-dev"))
        if any(not isinstance(data.get(s) or {}, dict) for s in sections):
            raise ValueError(f"{path} has a dependency section that is not an object")
        return {dep for s in sections for dep in (data.get(s) or {}) if not (name == "composer.json" and COMPOSER_PLATFORM.match(dep))}
    lines = [line.split("#")[0].strip() for line in text.splitlines()]
    if name == "deps.txt":
        return {line.split()[1].split(">=")[0] for line in lines if len(line.split()) > 1}
    if name.endswith(".txt"):  # requirements: options, includes and local paths name no package; a URL names its #egg=
        raw = [line.split("#")[0].strip() if "#egg=" not in line else line.strip() for line in text.splitlines()]
        packages = [re.search(r"#egg=([\w.-]+)", line) or (None if re.match(r"-|\.|/|\w+\+|\w+://", line)
                                                            else re.match(r"[A-Za-z0-9][\w.-]*", line)) for line in raw]
        return {re.sub(r"[-_.]+", "-", m.group(m.lastindex or 0)).lower() for m in packages if m}  # pip: foo_bar is Foo-Bar
    names, block = set(), False
    if name == "go.mod":
        for line in (l.split("//")[0].strip() for l in text.splitlines()):
            one_line = re.fullmatch(r"require \((\S+) \S+\)", line)
            if one_line:
                names.add(one_line.group(1))
            elif line == "require (":
                block = True
            elif block and line == ")":
                block = False
            elif block and line:
                names.add(line.split()[0])
            elif re.match(r"require\s", line) and len(line.split()) >= 3:
                names.add(line.split()[1])
        return names
    for line in lines:  # Cargo.toml
        header = re.fullmatch(r"\[(.+)\]", line)
        if header:
            table = header.group(1)
            block = bool(re.search(r"(^|\.)(dev-|build-)?dependencies$", table))
            nested = re.search(r"(^|\.)(dev-|build-)?dependencies\.([\w-]+)$", table)
            if nested:
                names.add(nested.group(3))
        elif block and re.match(r"\"?[\w-]+\"?\s*[.=]", line):
            names.add(re.match(r"\"?([\w-]+)", line).group(1))
    return names


def range_ends(rng, merge_base):
    """(before, after) refs: the same ends git diff compares, A...B from their merge-base, A..B, and a lone ref against
    the working tree (after is None)."""
    if rng and "..." in rng:
        a, b = rng.split("...", 1)
        return git("merge-base", a or "HEAD", b or "HEAD").strip(), b or "HEAD"
    if rng and ".." in rng:
        a, b = rng.split("..", 1)
        return a or "HEAD", b or "HEAD"
    return rng or merge_base, None


def new_dependencies(files, renamed_from, rng, merge_base):
    """'new dependency: <name> (<manifest>)' for each name a changed manifest gains, and a line for each it can't read."""
    before_ref, after_ref = range_ends(rng, merge_base)
    root = git("rev-parse", "--show-toplevel").strip()
    found = []
    for path in (p for p in files if MANIFEST.search(p)):
        before = subprocess.run(["git", "show", f"{before_ref}:{renamed_from.get(path, path)}"], capture_output=True,
                                text=True, errors="replace")
        if after_ref:
            after = subprocess.run(["git", "show", f"{after_ref}:{path}"], capture_output=True, text=True, errors="replace")
            after_text = after.stdout if after.returncode == 0 else None
        else:
            full = os.path.join(root, path)
            after_text = open(full, errors="ignore").read() if os.path.isfile(full) else None
        if after_text is None:
            continue
        try:
            source = renamed_from.get(path, path)
            declared = dependency_names(source, before.stdout) if before.returncode == 0 and MANIFEST.search(source) else set()
            added = dependency_names(path, after_text) - declared
        except ValueError:
            found.append(f"{path} can't be read at one end of the change: check its dependencies by hand")
            continue
        found += [f"new dependency: {name} ({path})" for name in sorted(added)]
    return found


class Inconclusive(Exception):
    """Pack detection couldn't decide: triage stops rather than size the change without the pack it may need."""


PACKS = ("wordpress",)
PLUGIN_HEADERS_READ = 200  # root PHP files, in name order
HEADER_BYTES = 8192  # as much of a file as WordPress reads for its header
COMPOSER_BYTES = 1_000_000  # composer.json is parsed whole, so a bigger one is refused rather than read
PLUGIN_HEADER = re.compile(rb"^(?:[ \t]*<\?php)?[ \t/*#@]*Plugin Name:", re.M | re.I)
THEME_HEADER = re.compile(rb"^[ \t/*#@]*Theme Name:", re.M | re.I)
WORDPRESS_COMPOSER_TYPES = ("wordpress-plugin", "wordpress-theme", "wordpress-muplugin")
WORDPRESS_CORE_PACKAGE = re.compile(r"^(johnpbloch/wordpress|roots/wordpress|wpackagist-.+)$")


def run_git(*args, stdin=None):
    """git's stdout as bytes; Inconclusive, with git's own words, when it fails."""
    done = subprocess.run(["git", *args], input=stdin, capture_output=True)
    if done.returncode:
        error = done.stderr.decode(errors="replace").strip().splitlines() or [f"exit {done.returncode}"]
        raise Inconclusive(f"git {args[0]} failed: {error[-1]}")
    return done.stdout


class Tree:
    """A tree's top level, read for pack markers: a commit's, or the working tree's (ignored and untracked files
    included) when ref is None. `names` holds every entry, symlinks and submodules included; `files` the ones whose
    content can be read."""

    def __init__(self, root, ref):
        self.root, self.ref = root, ref
        if ref is None:
            try:
                self.names = set(os.listdir(root))
            except OSError as error:
                raise Inconclusive(f"can't list {root}: {error.strerror}") from None
            self.files = sorted(n for n in self.names if os.path.isfile(os.path.join(root, n)))
        else:
            # --full-tree: without it ls-tree lists the directory triage runs in.
            listing = run_git("ls-tree", "--full-tree", "-z", ref).decode(errors="replace").split("\0")
            entries = [(meta.split(), name) for meta, name in (e.split("\t", 1) for e in listing if e)]
            self.names = {name for _, name in entries}
            self.oids = {name: oid for (mode, kind, oid), name in entries if kind == "blob" and mode != "120000"}
            self.files = sorted(self.oids)

    def heads(self, names, limit=HEADER_BYTES):
        """The first `limit` bytes of each file; for a commit, one git process, asked by object id one file at a time so
        only `limit` bytes of each are kept."""
        heads = []
        if self.ref is None:
            for name in names:
                try:
                    with open(os.path.join(self.root, name), "rb") as f:
                        heads.append(f.read(limit))
                except OSError as error:
                    raise Inconclusive(f"can't read {name}: {error.strerror}") from None
            return heads
        git_ = subprocess.Popen(["git", "cat-file", "--batch"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE)
        try:
            for name in names:
                git_.stdin.write(f"{self.oids[name]}\n".encode())
                git_.stdin.flush()
                header = git_.stdout.readline().split()
                if len(header) != 3:
                    raise Inconclusive(f"git cat-file can't read {self.ref}:{name}: {b' '.join(header).decode() or 'no output'}")
                size = int(header[2])
                heads.append(git_.stdout.read(min(size, limit)))
                left = size - len(heads[-1]) + 1  # the rest of the blob, then git's newline
                while left:
                    chunk = git_.stdout.read(min(left, 1 << 16))
                    if not chunk:
                        raise Inconclusive(f"git cat-file stopped in the middle of {self.ref}:{name}")
                    left -= len(chunk)
        finally:
            git_.stdin.close()
            git_.stdout.close()
            error = git_.stderr.read().decode(errors="replace").strip()
            git_.stderr.close()
            git_.wait()
        if git_.returncode:
            raise Inconclusive(f"git cat-file failed: {error.splitlines()[-1] if error else f'exit {git_.returncode}'}")
        return heads


def wordpress_marker(tree):
    """(why, root PHP files left unread) for the first WordPress marker at a tree's top level, why None without one."""
    for marker in ("wp-config.php", ".wp-env.json"):
        if marker in tree.names:
            return marker, 0
    if "wp-content" in tree.names:
        return "wp-content/", 0
    if "composer.json" in tree.files:
        text = tree.heads(["composer.json"], limit=COMPOSER_BYTES + 1)[0]
        if len(text) > COMPOSER_BYTES:
            raise Inconclusive("composer.json is over 1 MB, too big to read for WordPress")
        try:
            text = text.decode()
            data = json.loads(text)
            requires = dependency_names("composer.json", text)
        except ValueError as error:
            raise Inconclusive(f"composer.json can't be read: {error}") from None
        if data.get("type") in WORDPRESS_COMPOSER_TYPES:
            return f"composer.json type {data['type']}", 0
        core = sorted(n for n in requires if WORDPRESS_CORE_PACKAGE.match(n))
        if core:
            return f"composer.json requires {core[0]}", 0
    # WordPress reads headers with any line end, a lone \r included.
    if "style.css" in tree.files and THEME_HEADER.search(tree.heads(["style.css"])[0].replace(b"\r", b"\n")):
        return "style.css has a Theme Name header", 0
    php = [n for n in tree.files if n.endswith(".php")]
    for name, head in zip(php, tree.heads(php[:PLUGIN_HEADERS_READ])):
        if PLUGIN_HEADER.search(head.replace(b"\r", b"\n")):
            return f"{name} has a Plugin Name header", 0
    return None, max(0, len(php) - PLUGIN_HEADERS_READ)


def overlay_packs(repo):
    """{pack: (on, why)} from the repo's packs file in the user's overlay: a pack's name turns it on, -name off."""
    short = f"repos/{repo}/packs"
    path, shown = os.path.join(os.path.expanduser("~/.agents"), short), f"~/.agents/{short}"
    try:
        lines = open(path, encoding="utf-8").read().splitlines()
    except FileNotFoundError:
        return {}
    except (OSError, ValueError) as error:
        raise Inconclusive(f"can't read {shown}: {getattr(error, 'strerror', None) or error}") from None
    named = {}
    for number, line in enumerate(lines, 1):
        word = line.strip()
        if not word or word.startswith("#"):
            continue
        name = word[1:] if word.startswith("-") else word
        if name not in PACKS:
            raise Inconclusive(f"{shown}:{number}: unknown pack {word!r} (known: {', '.join(PACKS)})")
        if name in named and named[name][0] != (word == name):
            raise Inconclusive(f"{shown}:{named[name][1]}: {name} is turned on and off (again at :{number})")
        named.setdefault(name, (word == name, number))
    return {name: (on, short) for name, (on, _) in named.items()}


def applied_packs(rng, merge_base):
    """([{name, why}] of the packs this change is sized with, [{name, why}] of those the overlay turned off, root PHP
    files whose headers went unread). The overlay wins over detection; detection reads both ends of the change."""
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks"))  # as in cross_model
    import review_stamp
    root = run_git("rev-parse", "--show-toplevel").decode().strip()
    repo = review_stamp.repo_name_of(run_git("rev-parse", "--path-format=absolute", "--git-common-dir").decode().strip())
    if not repo:
        raise Inconclusive("git names no repository directory")
    before, after = range_ends(rng, merge_base)
    if not before:
        raise Inconclusive(f"{rng} has no merge-base")
    unborn = not rng and subprocess.run(["git", "rev-parse", "--verify", "--quiet", "HEAD"], capture_output=True).returncode
    ends = [("end", after)] + ([] if unborn else [("start", before)])  # with no commit yet, the working tree is the change
    for end, ref in ends:
        if ref is not None:
            try:
                run_git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}")
            except Inconclusive:
                raise Inconclusive(f"the change's {end} {ref!r} isn't a commit") from None
    chosen = overlay_packs(repo)
    if "wordpress" in chosen:
        on, why = chosen["wordpress"]
        return ([{"name": "wordpress", "why": why}], [], 0) if on else ([], [{"name": "wordpress", "why": why}], 0)
    unread = 0
    for end, ref in ends:
        try:
            why, left = wordpress_marker(Tree(root, ref))
        except Inconclusive as error:
            where = "the working tree" if ref is None else f"the change's {end} {ref}"
            raise Inconclusive(f"{error} (in {where}; to skip detection, put wordpress or -wordpress in "
                               f"~/.agents/repos/{repo}/packs)") from None
        if why:
            return [{"name": "wordpress", "why": why + (", before the change" if end == "start" else "")}], [], 0
        unread = max(unread, left)
    return [], [], unread


PACK_PATTERNS = ("migration", "query_budget", "html_comment_holds_code")


def load_pack(name):
    """The pack's patterns, each adding to a core label or lens it names; Inconclusive when the file can't be used."""
    shown = f"packs/{name}.json"
    path = os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", shown))
    try:
        pack = json.load(open(path, encoding="utf-8"))
        if not isinstance(pack, dict) or set(pack) != {"high_risk", "lens_signals", *PACK_PATTERNS}:
            raise ValueError(f"its keys must be high_risk, lens_signals, {', '.join(PACK_PATTERNS)}")
        unknown = [k for k in pack["high_risk"] if k not in HIGH_RISK] + [k for k in pack["lens_signals"] if k not in LENS_SIGNALS]
        if unknown:
            raise ValueError(f"no core label or lens named {', '.join(map(repr, unknown))}")
        for rx in [*pack["high_risk"].values(), *pack["lens_signals"].values(), *(pack[k] for k in PACK_PATTERNS)]:
            re.compile(rx)
    except (OSError, ValueError, AttributeError, TypeError, re.error) as error:
        raise Inconclusive(f"can't use the {name} pack {shown}: {getattr(error, 'strerror', None) or error}") from None
    return pack


def php_min():
    for candidate in ("composer.json", "src/composer.json"):
        try:
            data = json.load(open(candidate))
        except (OSError, ValueError):
            continue
        platform = (data.get("config") or {}).get("platform", {}).get("php")
        req = (data.get("require") or {}).get("php", "")
        m = re.search(r"(\d+\.\d+)", platform or req)
        if m:
            return m.group(1)
    return None


def triage(rng=None):
    base, base_why = (None, "") if rng else branch_base()
    merge_base = None if rng else git("merge-base", "HEAD", base).strip() or "HEAD"
    packs, packs_off, headers_unread = applied_packs(rng, merge_base)
    high_risk, lens_signals = dict(HIGH_RISK), dict(LENS_SIGNALS)
    migration_rx, query_budget_rx, html_holds_code = MIGRATION, None, HTML_COMMENT_HOLDS_CODE
    for pack in (load_pack(p["name"]) for p in packs):
        high_risk.update({k: f"{high_risk[k]}|{rx}" for k, rx in pack["high_risk"].items()})
        lens_signals.update({k: f"{lens_signals[k]}|{rx}" for k, rx in pack["lens_signals"].items()})
        migration_rx = f"{migration_rx}|{pack['migration']}"
        query_budget_rx = "|".join(filter(None, (query_budget_rx, pack["query_budget"])))
        html_holds_code = re.compile(f"{html_holds_code.pattern}|{pack['html_comment_holds_code']}")
    files, added, removed, renamed_from, data_files = collect(rng, merge_base)
    changed_lines = sum(files.values()) + len(removed)
    behavior = [p for p in files if not TEST_OR_DOC.search(p)]
    style_only = bool(behavior) and all(STYLE_FILE.search(p) for p in behavior)
    behavior_added = [(p, l) for p, l in added if not TEST_OR_DOC.search(p)]
    code_added = [(p, l) for p, l in behavior_added if not is_comment(p, l, html_holds_code)]
    # Deleting or commenting out a risk check is as risky as adding one; only the high-risk labels read these.
    behavior_removed = [(p, l) for p, l in removed if p and not TEST_OR_DOC.search(p)]
    code_removed = [(p, l) for p, l in behavior_removed if not is_comment(p, l, html_holds_code)]
    skipped = {"comment_lines": len(behavior_added) - len(code_added) + len(behavior_removed) - len(code_removed),
               "untracked_data_files": len(data_files), "untracked_data_sample": data_files[:SKIPPED_SAMPLE]}
    if headers_unread:
        skipped["php_headers_unread"] = headers_unread
    reasons, lenses, tests = [], {"correctness": ["always"]}, {"unit (verify)": ["always"]}

    def hits(pattern, lines=code_added, limit=3, where=""):
        rx = re.compile(pattern, re.I)
        found = []
        for p, l in lines:
            m = next((m for m in rx.finditer(l) if not (m.group(0).lower() == "checkout" and GIT_CHECKOUT.search(l))), None)
            if m:
                found.append(f"{p}{where}: `{m.group(0)}`")
                if len(found) == limit:
                    break
        return found

    high = []
    for label, rx in high_risk.items():
        h = hits(rx, limit=1) or hits(rx, code_removed, limit=1, where=", removed")
        if h:
            high.append(f"{label} ({h[0]})")
    if changed_lines > 400:
        high.append(f"{changed_lines} changed lines")

    if (not behavior or style_only) and changed_lines < 50 and not high:
        diff_tier = "low"
    elif high:
        diff_tier = "high"
        reasons += high
    else:
        diff_tier = "standard"
    spec_tier, spec_reason, spec_note = (None, None, None) if rng else spec_risk()
    tier = max(diff_tier, spec_tier or "low", key=TIERS.index)

    ui = [p for p in behavior if UI_FILE.search(p)]
    if ui:  # at every tier: a one-line style change can still be a design regression
        lenses["design"] = ui  # every file: the lens passes them all to the detector
        tests["design (impeccable detect)"] = ui
    if style_only:
        lenses["ux-a11y-i18n"] = behavior[:3]
    if tier != "low":
        lenses["maintainability"] = ["behavior change" if diff_tier != "low" else f"the spec's {tier} tier"]
        if any(TEST_OR_DOC.search(p) and "test" in p.lower() for p in files) or (behavior and not style_only):
            lenses["tests"] = ["behavior change" if behavior else "tests changed"]
        for lens, rx in lens_signals.items():
            h = hits(rx)
            if h:
                lenses[lens] = h
        if ui:
            lenses["ux-a11y-i18n"] = ui[:3]
    dependencies = new_dependencies(files, renamed_from, rng, merge_base)
    if dependencies:
        lenses.setdefault("maintainability", []).extend(dependencies)

    if behavior and not style_only:
        tests["e2e positive/negative (validate)"] = ["behavior change"]
    elif style_only:
        tests["visual check of affected pages (validate)"] = ["style-only change"]
    budget = query_budget_rx and hits(query_budget_rx, limit=2)
    if budget:
        tests["query budget"] = lenses.get("performance", [])[:2] or budget
    if "ux-a11y-i18n" in lenses:
        tests["accessibility (axe)"] = lenses["ux-a11y-i18n"]
    minimum = php_min()
    if minimum and float(minimum) < 8.0 and any(p.endswith(".php") for p in files):
        tests[f"php {minimum} syntax (verify)"] = [f"composer requires php {minimum}"]
    migration = hits(migration_rx, limit=2)
    if migration:
        tests["migration round-trip"] = migration
    nested = [f"{p}: `{l.strip()}`" for p, l in code_added
              if len(l) <= REGEX_LINE_MAX and any(nested_quantifier(t) for t in regex_texts(l))]
    if nested:
        lenses.setdefault("performance", []).extend(f"nested quantifier in {n[:200]}" for n in nested[:3])
        tests["regex worst-case timing"] = nested  # every one: each needs its own timing
    prop = [f"{p}: {m.group(0)}" for p, l in code_added for m in [PROPERTY_FN.search(l)] if m][:3]
    if prop:
        tests["property-based"] = prop
    # Prose left out: a changelog entry named after a branch, like changelog.d/fix~test-runner.md, is no test.
    tests_changed = any(TEST_OR_DOC.search(p) and "test" in p.lower() and not PROSE_FILE.search(p) for p in files)
    if code_added and not style_only and tests_changed:
        if tier == "high":
            tests["mutation (changed lines)"] = ["high risk with tests in the diff"]
        elif tier == "standard":
            tests["mutation, light (changed lines)"] = ["standard risk with tests in the diff: at most 5 mutants, at most 5 minutes"]

    return {"tier": tier, "spec_tier": spec_tier, "diff_tier": diff_tier, "spec_reason": spec_reason, "spec_note": spec_note,
            "budget": BUDGET[tier], "changed_lines": changed_lines, "files": len(files),
            "reasons": reasons, "lenses": lenses, "tests": tests, "skipped": skipped,
            "cross_model": cross_model(tier), "base": base, "base_why": base_why, "packs": packs, "packs_off": packs_off}


def spec_risk():
    """(tier, reason, None) from the branch's spec, or (None, None, why it gives no prediction); all None without a spec."""
    kit_spec = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "skills", "kit-spec")
    try:
        found = subprocess.run([os.path.join(kit_spec, "path.sh")], capture_output=True, text=True, timeout=SPEC_LOOKUP_SECS)
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:  # ValueError: output that isn't UTF-8
        return None, None, f"the spec lookup failed: {error}"
    if found.returncode:
        return None, None, f"the spec lookup failed: {(found.stderr.strip().splitlines() or ['exit ' + str(found.returncode)])[-1]}"
    path = found.stdout.strip()
    try:
        text = open(path, encoding="utf-8").read()
    except (FileNotFoundError, IsADirectoryError):
        return None, None, None
    except OSError as error:
        return None, None, f"can't read the spec: {error.strerror}"
    except ValueError as error:
        return None, None, f"can't read the spec: not UTF-8 ({error.reason} at byte {error.start})"
    sys.dont_write_bytecode = True  # as in quality-log: no __pycache__ left in the skill
    loader = importlib.machinery.SourceFileLoader("spec_lint", os.path.join(kit_spec, "lint.py"))
    lint = importlib.util.module_from_spec(importlib.util.spec_from_loader("spec_lint", loader))
    loader.exec_module(lint)
    tier, reason, problem = lint.risk(text)
    if lint.DECISIONS.search(text) and tier != "high":
        written = f"; its Risk line says {tier}: {reason}" if tier else ""
        return "high", f"a '## Decisions' section{written}", None
    return (None, None, problem) if problem else (tier, reason, None)


def branch_base():
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks"))  # as in cross_model
    import review_stamp
    return review_stamp.branch_base()


def cross_model(tier):
    # Here, not at the top: the mod registers its lens agents from --lens-briefs, which must not need the hooks.
    sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "hooks"))
    import phase_switches
    from hooklog import session_harness
    off, unreadable = phase_switches.phases_off_or_error(os.getcwd())
    reviewer = {"codex": "claude-review", "claude-code": "codex-review"}.get(session_harness())
    reviewers_off = [phase for phase in ("claude-review", "codex-review") if phase in off]
    if "second-model" in off:
        return "none (second-model switched off)"
    if len(reviewers_off) == 2:
        return f"none ({', '.join(reviewers_off)} switched off)"
    if reviewer in off:
        return f"none ({reviewer} switched off)"
    wanted = "per lens" if tier == "high" else ("correctness" if tier == "standard" else "none")
    if unreadable:
        return f"{wanted} ({' '.join(unreadable.split())})"  # git's stderr may hold newlines
    if not reviewer and reviewers_off and wanted != "none":
        return f"{wanted} (unless the reviewer is off: {', '.join(reviewers_off)})"
    return wanted


def lens_briefs():
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "skills", "kit-review", "lenses.md")
    sections = re.split(r"^## (.+)$", open(path).read(), flags=re.M)[1:]
    titles = sections[::2]
    key_of = {title: key for key, title in LENS_TITLES.items()}
    problems = [f"no key in LENS_TITLES for {t}" for t in titles if t not in key_of]
    problems += [f"no lens headed {t}" for t in LENS_TITLES.values() if t not in titles]
    problems += [f"{t} twice" for t in sorted({t for t in titles if titles.count(t) > 1})]
    if problems:
        sys.exit(f"triage: lenses.md doesn't match LENS_TITLES: {'; '.join(problems)}")
    return [{"key": key_of[title], "title": title, "brief": body.strip()} for title, body in zip(sections[::2], sections[1::2])]


def printable(path):
    """A path on one line of text output: a control character, legal in a file name, is shown escaped."""
    return re.sub(r"[\x00-\x1f\x7f]", lambda m: repr(m.group(0))[1:-1], path)


def main():
    args = sys.argv[1:]
    if "--lens-briefs" in args:
        print(json.dumps(lens_briefs()))
        return 0
    rng = args[args.index("--range") + 1] if "--range" in args else None
    try:
        result = triage(rng)
    except Inconclusive as error:
        sys.exit(f"triage: can't tell which packs apply: {error}")
    if "--json" in args:
        print(json.dumps(result, indent=1))
        return 0
    print(f"Risk: {result['tier']} ({result['changed_lines']} changed lines in {result['files']} files; "
          f"budget {result['budget']}; cross-model: {result['cross_model']})")
    if result["spec_note"]:
        print(f"Spec: no prediction ({result['spec_note']}); the diff decides")
    elif result["spec_tier"]:
        spec, diff = TIERS.index(result["spec_tier"]), TIERS.index(result["diff_tier"])
        decided = "decided by the spec" if spec > diff else "decided by the diff" if diff > spec else "they agree"
        print(f"Spec: {result['spec_tier']}, diff: {result['diff_tier']}; {decided}. "
              f"Spec's reason: {result['spec_reason']}")
    if result["base_why"]:
        print(f"Base: {result['base']} ({result['base_why']})")
    if result["packs"]:
        print("Packs: " + ", ".join(f"{p['name']} ({p['why']})" for p in result["packs"]))
    elif result["packs_off"]:
        print("Packs: none (" + ", ".join(f"{p['name']} turned off by {p['why']}" for p in result["packs_off"]) + ")")
    skipped = result["skipped"]
    comments, data = skipped["comment_lines"], skipped["untracked_data_files"]
    parts = [f"{comments} comment line{'s' * (comments != 1)}"] if comments else []
    if data:
        more = f" and {data - SKIPPED_SAMPLE} more" if data > SKIPPED_SAMPLE else ""
        parts.append(f"{data} untracked data file{'s' * (data != 1)} ({', '.join(map(printable, skipped['untracked_data_sample']))}{more})")
    if skipped.get("php_headers_unread"):
        parts.append(f"{skipped['php_headers_unread']} root PHP files past the first {PLUGIN_HEADERS_READ} "
                     "(not read for a WordPress plugin header)")
    if parts:
        print(f"Skipped: {'; '.join(parts)}")
    for r in result["reasons"]:
        print(f"  high-risk signal: {r}")
    print("Review lenses:")
    for k, v in result["lenses"].items():
        print(f"  - {k}: {'; '.join(v)}")
    print("Tests:")
    for k, v in result["tests"].items():
        print(f"  - {k}: {'; '.join(v)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
