#!/usr/bin/env python3
"""A/B harness for browser tooling in the validate skill: Playwright CLI vs agent-browser.

  browse assign                         pick the tool for this validation run (balanced alternation)
  browse <tool args...>                 run the assigned tool with these args, logging the call
  browse finish --checks N --passed P [--tool-issues K] [--notes "..."]
                                        record the run's outcome

Every event goes to ~/.agents/logs/browser-ab.jsonl. Output bytes are logged because they are
what lands in the model's context, the main cost difference between the two tools.
"""
import json
import os
import subprocess
import sys
import time

TOOLS = ["playwright-cli", "agent-browser"]
LOG = os.path.expanduser("~/.agents/logs/browser-ab.jsonl")
SPEC_PATH = os.path.expanduser("~/.agents/skills/spec/path.sh")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True).stdout.strip()


def run_key():
    return f"{os.path.basename(git('rev-parse', '--show-toplevel') or os.getcwd())}@{git('branch', '--show-current') or 'detached'}"


def state_file():
    try:
        spec = subprocess.run([SPEC_PATH], capture_output=True, text=True, check=True).stdout.strip()
        return os.path.join(os.path.dirname(spec), "browser-ab-" + os.path.basename(spec).replace(".md", ".json"))
    except (OSError, subprocess.CalledProcessError):
        return os.path.join(os.environ.get("TMPDIR", "/tmp"), "browser-ab-" + run_key().replace("/", "-") + ".json")


def log(event, **fields):
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a") as fh:
        fh.write(json.dumps({"ts": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "event": event, "run": run_key(),
                             "harness": os.environ.get("AGENTS_HARNESS", "unknown"), **fields}) + "\n")


def assigned():
    try:
        return json.load(open(state_file()))
    except (OSError, ValueError):
        return None


def assign():
    current = assigned()
    if current:
        print(current["tool"])
        return 0
    counts = {t: 0 for t in TOOLS}
    try:
        for line in open(LOG):
            e = json.loads(line)
            if e.get("event") == "assign" and e.get("tool") in counts:
                counts[e["tool"]] += 1
    except (OSError, ValueError):
        pass
    tool = min(TOOLS, key=lambda t: (counts[t], TOOLS.index(t)))
    run_id = f"{run_key()}#{int(time.time())}"
    with open(state_file(), "w") as fh:
        json.dump({"tool": tool, "run_id": run_id}, fh)
    log("assign", tool=tool, run_id=run_id)
    print(tool)
    print(f"Use `browse <{tool} command>`; syntax: `{tool} --help`.", file=sys.stderr)
    return 0


def finish(argv):
    current = assigned()
    if not current:
        print("browse: no assignment for this run", file=sys.stderr)
        return 1
    opts = {"checks": 0, "passed": 0, "tool-issues": 0, "notes": ""}
    i = 0
    while i < len(argv):
        key = argv[i].lstrip("-")
        if key in opts and i + 1 < len(argv):
            opts[key] = argv[i + 1] if key == "notes" else int(argv[i + 1])
            i += 2
        else:
            i += 1
    log("finish", tool=current["tool"], run_id=current["run_id"], checks=opts["checks"], passed=opts["passed"],
        tool_issues=opts["tool-issues"], notes=opts["notes"][:500])
    os.remove(state_file())
    return 0


def run(argv):
    current = assigned()
    if not current:
        assign()
        current = assigned()
    start = time.time()
    proc = subprocess.run([current["tool"], *argv], capture_output=True, text=True)
    sys.stdout.write(proc.stdout)
    sys.stderr.write(proc.stderr)
    log("call", tool=current["tool"], run_id=current["run_id"], command=argv[0] if argv else "",
        exit=proc.returncode, secs=round(time.time() - start, 2),
        out_bytes=len(proc.stdout.encode()), err_bytes=len(proc.stderr.encode()))
    return proc.returncode


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__)
        return 0
    if argv[0] == "assign":
        return assign()
    if argv[0] == "finish":
        return finish(argv[1:])
    return run(argv)


if __name__ == "__main__":
    sys.exit(main())
