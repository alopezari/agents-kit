#!/bin/bash
# Regenerate the framework reference so every commit carries docs that match the code, then keep
# profiles' private terms out.
# It is built from the working tree, so commit the files it describes together with it.
set -euo pipefail
root=$(git rev-parse --show-toplevel)
"$root/bin/docs" >/dev/null
git add "$root/docs/framework.md"
# The kit is public: no profile's private terms in what this commit adds, the regenerated docs included.
python3 "$(dirname "$0")/../hooks/private_terms.py" staged
